{
    "openapi": "3.0.0",
    "info": {
        "title": "DiFlowApi",
        "version": "v1.3"
    },
    "paths": {
        "/api/contractor/relation/{contractorId}/{actionName}": {
            "post": {
                "tags": [
                    "contractor"
                ],
                "summary": "Изменение статуса контрагентских взаимоотношений",
                "operationId": "App\\Application\\Multi\\Api\\Versions\\BaseVersion\\Controller\\Contractor\\ChangeStatusController::changeAction",
                "parameters": [
                    {
                        "name": "Api-Version",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/Version"
                        }
                    },
                    {
                        "name": "contractorId",
                        "in": "path",
                        "description": "id контрагента",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "actionName",
                        "in": "path",
                        "description": "Наименование действия",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/EnumContractorActionName"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Признак успешного выполнения",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SuccessJsonResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "api_key": []
                    }
                ]
            }
        },
        "/api/contractor/relation/create/{contractorId}": {
            "post": {
                "tags": [
                    "contractor"
                ],
                "summary": "Создание контрагентских взаимоотношений",
                "operationId": "App\\Application\\Multi\\Api\\Versions\\BaseVersion\\Controller\\Contractor\\CreateController::createAction",
                "parameters": [
                    {
                        "name": "Api-Version",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/Version"
                        }
                    },
                    {
                        "name": "contractorId",
                        "in": "path",
                        "description": "id контрагента",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Признак успешного выполнения",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SuccessJsonResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "api_key": []
                    }
                ]
            }
        },
        "/api/contractor": {
            "get": {
                "tags": [
                    "contractor"
                ],
                "summary": "Получить список контрагентов компании авторизованного пользователя",
                "operationId": "App\\Application\\Multi\\Api\\Versions\\BaseVersion\\Controller\\Contractor\\IndexController::indexAction",
                "parameters": [
                    {
                        "name": "Api-Version",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/Version"
                        }
                    },
                    {
                        "name": "statusSystemName",
                        "in": "query",
                        "description": "Статус взаимоотношений",
                        "required": false,
                        "style": "deepObject",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/components/schemas/EnumContractorRelationStatusSystemName"
                            }
                        }
                    },
                    {
                        "name": "externalType",
                        "in": "query",
                        "description": "Внешний тип контрагента",
                        "required": false,
                        "style": "deepObject",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/components/schemas/EnumExternalCompanyType"
                            }
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Ограничение выборки",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "description": "Пропустить записей",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список контрагентов",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ContractorPaginator"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "api_key": []
                    }
                ]
            }
        },
        "/api/contractor/division/{id}": {
            "get": {
                "tags": [
