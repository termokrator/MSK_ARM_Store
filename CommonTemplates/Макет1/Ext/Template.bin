        "/api/events": {
            "get": {
                "tags": [
                    "event"
                ],
                "summary": "Получить список событий на обработку",
                "operationId": "DiFlow\\CoreBundle\\Application\\Api\\Versions\\BaseVersion\\Controller\\ExternalEvent\\IndexController::indexAction",
                "parameters": [
                    {
                        "name": "Api-Version",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/Version"
                        }
                    },
                    {
                        "name": "lastEventId",
                        "in": "query",
                        "description": "Идентификатор последнего обработанного события",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
