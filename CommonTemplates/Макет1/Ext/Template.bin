                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "bik": {
                                                "description": "БИК",
                                                "type": "string",
                                                "nullable": false
                                            },
                                            "correspondentAccount": {
                                                "description": "Корр счет банка",
                                                "type": "string",
                                                "nullable": false
                                            },
                                            "fullTitle": {
                                                "description": "Полное наименование",
                                                "type": "string",
                                                "nullable": true
                                            },
                                            "shortTitle": {
                                                "description": "Краткое наименование",
                                                "type": "string",
                                                "nullable": true
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "api_key": []
                    }
                ]
            }
        },
