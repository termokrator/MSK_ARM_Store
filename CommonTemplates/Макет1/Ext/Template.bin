        "/api/service/receipt/create/{id}/{documentAlias}": {
            "post": {
                "tags": [
                    "service"
                ],
                "summary": "Метод генерирует XML квитанции по DTO",
                "operationId": "DiFlow\\CoreBundle\\Application\\Api\\Versions\\BaseVersion\\Controller\\Service\\ReceiptController::createAction",
                "parameters": [
                    {
                        "name": "Api-Version",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/Version"
                        }
                    },
                    {
                        "name": "id",
                        "in": "path",
                        "description": "uid или id(deprecated) документа на который создается квитанция",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "documentAlias",
                        "in": "path",
                        "description": "наименования квитанции",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "accept",
                                "accept820",
                                "uvutoch",
                                "dp_prannul"
                            ]
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "$ref": "#/components/schemas/Waybill551BuyerTitle"
                                    },
                                    {
