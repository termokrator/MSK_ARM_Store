        "/api/flow/bulk/send": {
            "post": {
                "tags": [
                    "flow"
                ],
                "summary": "Отправка набора документов",
                "operationId": "DiFlow\\CoreBundle\\Application\\Api\\Versions\\BaseVersion\\Controller\\BulkOperation\\BulkSendController::sendAction",
