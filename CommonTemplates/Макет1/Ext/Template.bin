            }
        },
        "/api/info": {
            "get": {
                "tags": [
                    "common"
                ],
                "summary": "Информация по api",
                "operationId": "DiFlow\\CoreBundle\\Application\\Api\\Versions\\BaseVersion\\Info\\ApiInfoController::indexAction",
                "responses": {
                    "200": {
                        "description": "Сведения об API",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "current_version": {
                                            "description": "Версия версия API",
                                            "type": "string",
                                            "nullable": false
                                        },
                                        "diflow_version": {
                                            "description": "Версия DiFlow",
                                            "type": "string",
                                            "nullable": false
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/security/token": {
            "post": {
                "tags": [
                    "security"
                ],
                "summary": "Получение токена для авторизации",
                "parameters": [
                    {
                        "name": "Api-Version",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/Version"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "description": "Получение токена по сертификату",
                                        "properties": {
                                            "thumbprint": {
                                                "description": "Отпечаток сертификата",
                                                "type": "string",
                                                "nullable": false
                                            },
                                            "serialNumber": {
                                                "description": "Серийный номер сертификата (HEX)",
                                                "type": "string",
                                                "nullable": false
                                            }
                                        },
                                        "type": "object"
                                    },
                                    {
                                        "description": "Получение токена по логину и паролю",
                                        "properties": {
                                            "email": {
                                                "description": "Логин",
                                                "type": "string",
                                                "nullable": false
                                            },
                                            "password": {
                                                "description": "Пароль",
                                                "type": "string",
                                                "nullable": false
                                            }
                                        },
                                        "type": "object"
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Сведения об API",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "description": "Успешное выполнение",
                                            "type": "boolean",
                                            "nullable": false
                                        },
                                        "token": {
                                            "description": "Сведения о токене",
                                            "properties": {
                                                "value": {
                                                    "description": "значение токена",
                                                    "type": "string",
                                                    "nullable": false
                                                },
                                                "expireAt": {
                                                    "description": "Время жизни токена",
                                                    "type": "string",
                                                    "nullable": false
                                                }
                                            },
                                            "type": "object",
                                            "nullable": false
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
