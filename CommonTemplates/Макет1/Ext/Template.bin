                        "in": "header",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/Version"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BulkSendRequest"
                            }
                        }
                    }
                },
                "responses": {
