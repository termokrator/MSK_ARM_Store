        "/api/dictionary/bank": {
            "get": {
                "tags": [
                    "dictionary"
                ],
                "summary": "Получить список банков.",
                "operationId": "DiFlow\\CoreBundle\\Application\\Api\\Versions\\BaseVersion\\Controller\\Dictionary\\BankController::indexAction",
