                        "description": "id отправленного документа",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BulkSendSuccessResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "api_key": []
                    }
                ]
            }
        },
        "/api/flow/bulk/signing": {
            "post": {
                "tags": [
                    "flow"
                ],
                "summary": "Подписание надора документов",
                "operationId": "DiFlow\\CoreBundle\\Application\\Api\\Versions\\BaseVersion\\Controller\\BulkOperation\\BulkSigningController::signingAction",
                "parameters": [
                    {
                        "name": "Api-Version",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/Version"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BulkSigningRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "id отправленного документа",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BulkSendSuccessResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "api_key": []
                    }
                ]
            }
        },
        "/api/container/{uid}/content": {
            "get": {
                "tags": [
                    "container"
                ],
                "summary": "Получить содержимое контейнера",
                "operationId": "DiFlow\\CoreBundle\\Application\\Api\\Versions\\BaseVersion\\Controller\\Container\\ContentController::contentAction",
                "parameters": [
                    {
                        "name": "Api-Version",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/Version"
                        }
                    },
                    {
                        "name": "id",
                        "in": "path",
                        "description": "uid контейнера",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Содержимое контейнера",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ContainerContent"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "api_key": []
                    }
                ]
            }
        },
        "/api/flow/container/send": {
            "post": {
                "tags": [
                    "container"
                ],
                "summary": "Отправка контейнера",
                "operationId": "DiFlow\\CoreBundle\\Application\\Api\\Versions\\BaseVersion\\Controller\\Container\\FlowController::sendAction",
                "parameters": [
                    {
                        "name": "Api-Version",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/Version"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SendContainerRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "uid отправленного контейнера",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "uid": {
                                            "description": "идентификатор контейнера",
                                            "type": "string",
                                            "nullable": false
                                        },
                                        "documents": {
                                            "description": "документы",
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "uid": {
                                                        "description": "идентификатор",
                                                        "type": "string",
                                                        "nullable": false
                                                    },
                                                    "flowSystemName": {
                                                        "description": "тип документооборота",
                                                        "type": "string",
                                                        "nullable": false
                                                    },
                                                    "typeSystemName": {
                                                        "description": "тип документа",
                                                        "type": "string",
                                                        "nullable": false
                                                    }
                                                },
                                                "type": "object"
                                            },
                                            "nullable": false
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "api_key": []
                    }
                ]
            }
        },
