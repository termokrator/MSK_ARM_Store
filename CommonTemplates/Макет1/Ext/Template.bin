            "Ucd736Agreement": {
                "description": "<СвСоглас>\n\nСведения о согласовании изменения стоимости отгруженных товаров (выполненных работ, оказанных услуг),\nпереданных имущественных прав (о согласии на изменение стоимости).",
                "properties": {
                    "operationInformation": {
                        "description": "Содержание операции. Содержание действий. Указывается «С изменением стоимости согласен» или\n«Уведомление об изменении стоимости принято к учету», или другое.\n\n#СодОпер",
                        "type": "string",
                        "nullable": true
                    },
                    "date": {
                        "description": "Дата согласования (согласия). Обязателен, если дата согласования не совпадает со значением ДатаНапр, указанным\nв файле обмена корректировочного счета-фактуры (информация продавца) или файла обмена информации продавца.\n\n#ДатаСоглас",
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Ucd736FactActivity4": {
                "description": "<СодФХЖ4>",
                "properties": {
                    "agreement": {
                        "description": "Сведения о согласовании изменения стоимости отгруженных товаров (выполненных работ, оказанных услуг),\nпереданных имущественных прав (о согласии на изменение стоимости).",
                        "nullable": true,
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/Ucd736Agreement"
                            }
                        ]
                    },
                    "infoField": {
                        "description": "Информационное поле факта хозяйственной жизни\n\n<ИнфПолФХЖ4>",
                        "nullable": true,
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/InfoField"
                            }
                        ]
                    }
                },
                "type": "object"
            },
            "Ucd736Correction": {
                "description": "Исправление корректировочного счета-фактуры\n\n<ИспрКСчФ>\n\nИсправление корректировочного счета-фактуры (строка 1а корректировочного счета-фактуры), корректировочного\nсчета-фактуры и документа о согласии покупателя на изменение стоимости отгрузки, документа о согласии покупателя на\nизменение стоимости отгрузки.",
                "properties": {
                    "number": {
                        "description": "Номер\n\n#НомИспрКСчФ",
                        "type": "string",
                        "nullable": true
                    },
                    "date": {
                        "description": "Дата\n\n#ДатаИспрКСчФ",
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Ucd736FactActivity1": {
                "description": "Сведения о корректировочном счете-фактуре с дополнительной информацией\n\n<СвКСчФ>\n\nСведения о корректировочном счете-фактуре с дополнительной информацией (содержание события (факта хозяйственной\nжизни) 1 - сведения об участниках, основаниях и обстоятельствах согласия (факта уведомления) покупателя на изменение\nстоимости отгруженных товаров (выполненных работ, оказанных услуг), переданных имущественных прав).",
                "properties": {
                    "number": {
                        "description": "Порядковый номер корректировочного счета-фактуры (строка 1 корректировочного счета-фактуры) и (или) документа о\nсогласии покупателя на изменение стоимости отгрузки.",
                        "type": "string",
                        "nullable": true
                    },
                    "date": {
                        "description": "Дата составления (выписки) корректировочного счета-фактуры (строка 1 корректировочного счета-фактуры) и (или)\nдокумента о согласии покупателя на изменение стоимости отгрузки.",
                        "type": "string",
                        "nullable": true
                    },
                    "currencyCode": {
                        "description": "Валюта: Код (строка 4 корректировочного счета-фактуры) .\n\n#КодОКВ",
                        "type": "string",
                        "nullable": true
                    },
                    "invoices": {
                        "description": "Счет-фактура",
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Ucd736Invoice"
                        }
                    },
                    "correction": {
                        "description": "Исправление корректировочного счета-фактуры",
                        "nullable": true,
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/Ucd736Correction"
                            }
                        ]
