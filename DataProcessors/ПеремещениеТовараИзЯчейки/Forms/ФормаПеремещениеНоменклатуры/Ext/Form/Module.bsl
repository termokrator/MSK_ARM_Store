&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначения.УстановитьРежимВвыбораДляПеремещенияТовара("ПоискЯчейкиОткуда");
	ОбщегоНазначения.УстановитьРежимВводаНаСервере(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискОткуда(Команда) 
	
	Если Не ЗначениеЗаполнено(Объект.ЯчейкаОткуда) Тогда
		ПоказатьПредупреждение(, "Ячейка ""Откуда"" должна быть заполнена", 4);	
	КонецЕсли; 
	
	Объект.ЯчейкаОткуда = ВРег(Объект.ЯчейкаОткуда);
	ЗапроситьЯчейкуСсервера(Объект.ЯчейкаОткуда, "ЯчейкаОткуда");
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискКуда(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ЯчейкаКуда) Тогда
		ПоказатьПредупреждение(, "Ячейка ""Куда"" должна быть заполнена", 4);	
	КонецЕсли; 
	
	Объект.ЯчейкаКуда = ВРег(Объект.ЯчейкаКуда);
	ЗапроситьЯчейкуСсервера(Объект.ЯчейкаКуда, "ЯчейкаКуда");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТЗРучнойНабор()
	
	РучнойВводКоличества.Очистить();
	СтрокаТЗ = РучнойВводКоличества.Добавить();
	СтрокаТЗ.Заголовок = "Кол.:";
	СтрокаТЗ.ЗнакБольше = ">";
	СтрокаТЗ.ЗнакМеньше = "<";
	СтрокаТЗ.ВведенноеКоличествоВРучную = 1;
	Элементы.РучнойВводКоличества.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПолученоОписаниеШапки = Ложь;
	СозданДокументПеремещения = Ложь;
	Компонента = ОбщегоНазначенияКлиент.ПодключитьКомпоненту();	
	
	Если Компонента <> Неопределено И Не Компонента.Подключить() Тогда		
		ТекстОшибки = "";
		КодОшибки = Компонента.ПолучитьОшибку(ТекстОшибки);                                                   
		ПоказатьПредупреждение(,"Ошибка: "+КодОшибки+", " + ТекстОшибки);
	КонецЕсли;	
	
	ПоказатьСтраницу_ГруппаСтраницыРаботаСТоваров();	
		
	ОбщегоНазначенияКлиент.ЗаполнитьТабЗначОК(ЭтаФорма);	
	ОбщегоНазначенияКлиент.ЗаполнитьТЧКнопокДляШКнеНайден(ЭтаФорма);
	ЗаполнитьТЗРучнойНабор();
	
	ПодключитьОбработчикОжидания("ПерейтиКСтатусуПоискаНоменклатуры", 2, Ложь);	
	
КонецПроцедуры

