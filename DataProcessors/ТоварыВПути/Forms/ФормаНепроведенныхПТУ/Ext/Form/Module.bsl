
&НаКлиенте
Процедура ПолучитьНепроведенныеДокументыПТУ(Команда)
	
	ЗагрузитьНепроведенныеДокументыПТУ();

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНепроведенныеДокументыПТУ()
	
	РезультатСтруктура = ОбщегоНазначения.ЗагрузитьСписокНепроведенныхДокументовПТУ();	
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 3);	
		Возврат;
	КонецЕсли; 
	
	Если РезультатСтруктура.Результат Тогда
		
		Оповестить("ОбновлениеДанных");
		
	КонецЕсли;     
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)             

	Элементы.Экспрессы.Пометка = Ложь;
	Элементы.Пополнения.Пометка = Ложь;
	Элементы.ПоступленияТОХ.Пометка = Ложь;
	УстановитьОтборВСписке();
	ЗагрузитьНепроведенныеДокументыПТУ();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник) 
	
	Если ИмяСобытия = "ОбновлениеДанных" Тогда 
		
		Элементы.СписокНепроведенныхПТУ.Обновить();  
		
	КонецЕсли;   
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)  
	
	Элементы.СписокНепроведенныхПТУ.Обновить();   
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)    
	
	ОбщегоНазначения.ОчиститьРегистрСведений("СписокНепроведенныхДокументовПТУ");
	
	//+UT10-5885
	ИспользоватьОтборПоСсылкам = Ложь;
	ОтборСсылокПТУ = "";
	
	Если Параметры.Свойство("ОтборСсылокПТУ") И ЗначениеЗаполнено(Параметры.ОтборСсылокПТУ) Тогда
		
		ИспользоватьОтборПоСсылкам = Истина;
		ОтборСсылокПТУ = Параметры.ОтборСсылокПТУ;
		Элементы.ГруппаКнопок.Видимость = Ложь;
		Заголовок = "Сопроводительные документы";
		
	КонецЕсли;
	
	УстановитьОтборПоСсылкамПТУ();
	//-UT10-5885

КонецПроцедуры

&НаКлиенте
Процедура КнЭкпрессыНажатие(Команда)  
	
	Элементы.Экспрессы.Пометка = НЕ Элементы.Экспрессы.Пометка;
	
	Элементы.Пополнения.Пометка = Ложь;	
	Элементы.Пополнения.ЦветРамки = Новый Цвет();
	Элементы.ПоступленияТОХ.Пометка = Ложь;
	Элементы.ПоступленияТОХ.ЦветРамки = Новый Цвет();
	
	Элементы.Экспрессы.ЦветРамки = ?(Элементы.Экспрессы.Пометка ,WebЦвета.Малиновый,Новый Цвет());
	Элементы.Экспрессы.КнопкаПоУмолчанию =  Элементы.Экспрессы.Пометка ; 
	
	УстановитьОтборВСписке();
	
	Элементы.СписокНепроведенныхПТУ.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура КнПополненияНажатие(Команда)
	
	Элементы.Пополнения.Пометка = НЕ Элементы.Пополнения.Пометка; 
	
	Элементы.Экспрессы.Пометка = Ложь;
	Элементы.Экспрессы.ЦветРамки = Новый Цвет(); 
	Элементы.ПоступленияТОХ.Пометка = Ложь;
	Элементы.ПоступленияТОХ.ЦветРамки = Новый Цвет();
	
	Элементы.Пополнения.ЦветРамки = ?(Элементы.Пополнения.Пометка ,WebЦвета.Малиновый,Новый Цвет());
	Элементы.Пополнения.КнопкаПоУмолчанию =  Элементы.Пополнения.Пометка ;
	
    УстановитьОтборВСписке(); 
	
	Элементы.СписокНепроведенныхПТУ.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура КнТОХНажатие(Команда)
	//+Кабанов А.В. 11.09.2023 # UT10-3812
	Элементы.ПоступленияТОХ.Пометка = НЕ Элементы.ПоступленияТОХ.Пометка;  
	
	Элементы.Экспрессы.Пометка = Ложь;
	Элементы.Экспрессы.ЦветРамки = Новый Цвет(); 
	Элементы.Пополнения.Пометка = Ложь;
	Элементы.Пополнения.ЦветРамки = Новый Цвет();
	
	Элементы.ПоступленияТОХ.ЦветРамки = ?(Элементы.ПоступленияТОХ.Пометка ,WebЦвета.Малиновый,Новый Цвет());
	Элементы.ПоступленияТОХ.КнопкаПоУмолчанию =  Элементы.ПоступленияТОХ.Пометка ;
	
    УстановитьОтборВСписке();   
	
	Элементы.СписокНепроведенныхПТУ.Обновить(); 
	//-Кабанов А.В. 11.09.2023 # UT10-3812
КонецПроцедуры

Процедура УстановитьОтборВСписке()
	//+Кабанов А.В. 11.09.2023 # UT10-3812
	СписокНепроведенныхПТУ.Параметры.УстановитьЗначениеПараметра("ОтбиратьТОХ", Элементы.ПоступленияТОХ.Пометка);
	//+UT10-5885
	УстановитьОтборПоСсылкамПТУ();
	//-UT10-5885
	
	Если Элементы.ПоступленияТОХ.Пометка Тогда
		
		СписокНепроведенныхПТУ.Параметры.УстановитьЗначениеПараметра("ОтбиратьДокументы", Ложь);   
		СписокНепроведенныхПТУ.Параметры.УстановитьЗначениеПараметра("ПоказыватьЭкспрессы", Ложь);
	
	Иначе  	
	//-Кабанов А.В. 11.09.2023 # UT10-3812	
		Если  Элементы.Экспрессы.Пометка =  Элементы.Пополнения.Пометка   Тогда        
			
			СписокНепроведенныхПТУ.Параметры.УстановитьЗначениеПараметра("ОтбиратьДокументы", Ложь);   
			СписокНепроведенныхПТУ.Параметры.УстановитьЗначениеПараметра("ПоказыватьЭкспрессы", Ложь);
			
		Иначе
			
			СписокНепроведенныхПТУ.Параметры.УстановитьЗначениеПараметра("ОтбиратьДокументы", Истина); 
			
			Если  Элементы.Экспрессы.Пометка Тогда  
				СписокНепроведенныхПТУ.Параметры.УстановитьЗначениеПараметра("ПоказыватьЭкспрессы", Истина);
			Иначе                                                                                       
				СписокНепроведенныхПТУ.Параметры.УстановитьЗначениеПараметра("ПоказыватьЭкспрессы", Ложь); 
			КонецЕсли;
			
		КонецЕсли;   
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПровестиДокументыПТУ(Результат, Параметры) Экспорт 
	
	 Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	ДокументГУИД   = Параметры.ДокументГУИД;
	ДатаПрихода    = Параметры.ДатаПрихода;
	КоличествоМест = Параметры.КоличествоМест;
	
	РезультатСтруктура = ОбщегоНазначения.ОбработатьПроведениеДокументаПТУ(ДокументГУИД,ДатаПрихода,КоличествоМест);	
	
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка)  Тогда
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 4);	
	КонецЕсли;   
	
	УстановитьОтборВСписке();
	ЗагрузитьНепроведенныеДокументыПТУ();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНепроведенныхПТУВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	//+UT10-5885
	Если ИспользоватьОтборПоСсылкам Тогда
		Возврат;
	КонецЕсли;
	//-UT10-5885
	
	ДокументГУИД		 = Элементы.СписокНепроведенныхПТУ.ДанныеСтроки(ВыбраннаяСтрока).СсылкаПТУ;
	НомерДокумента 		 = Элементы.СписокНепроведенныхПТУ.ДанныеСтроки(ВыбраннаяСтрока).НомерСкладскогоДокумента;
	КонтрагентаДокумента = Элементы.СписокНепроведенныхПТУ.ДанныеСтроки(ВыбраннаяСтрока).Контрагент;
	
	//+Сёмин Р.И. 08.06.2026 #UT10-5901
	СтатусЭДОПТУ = ОбщегоНазначения.ПолучитьСтатусЭДОПТУ(ДокументГУИД);
	
	Если СтатусЭДОПТУ.Данные = "Ожидает подтверждения" Тогда
		
		Сообщить("Ожидает сопоставления с ЭДО. При длительном ожидании обратитесь в поддержку");
		Возврат;
		
	КонецЕсли;
	//-Сёмин Р.И. 08.06.2026 #UT10-5901
	
	//+Сёмин Р.И. 24.06.2026 #UT10-5915
	Если ОбщегоНазначения.ПроверятьПриПриемкеНарушенияСроковГодностиКИЗ() Тогда
		
		ПТУСодержитКодыМаркировкиСНарушеннымСроком = ОбщегоНазначения.ПТУСодержитКодыМаркировкиСНарушеннымСроком(ДокументГУИД);
		
		Если ПТУСодержитКодыМаркировкиСНарушеннымСроком.Данные = Истина Тогда
			
			Сообщить("ПТУ содержит коды маркировки с нарушенными сроками годности. Приемка невозможна.");
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	//-Сёмин Р.И. 24.06.2026 #UT10-5915
	
	//+Кабанов А.В. 04.12.2024 #UT10-4950
	ПараметрыДокумента = Новый Структура;
	ПараметрыДокумента.Вставить("ДокументГУИД",ДокументГУИД);
	
	ДатаПрихода    = Дата('00010101');
	КоличествоМест = 0;
	ЭтоТранзит     = Элементы.СписокНепроведенныхПТУ.ДанныеСтроки(ВыбраннаяСтрока).Транзит;
	
	Если ЭтоТранзит Тогда
		
		мПараметры = ОткрытьФормуМодально("Обработка.ТоварыВПути.Форма.ФормаТранзитнойПоставки" , Новый Структура("ДатаПрихода","КоличествоМест" , ДатаПрихода ,КоличествоМест),ЭтаФорма);
		
		Если НЕ мПараметры =  Неопределено Тогда
			
			Если мПараметры.Свойство("ДатаПрихода") Тогда
				ДатаПрихода = мПараметры.ДатаПрихода;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ДатаПрихода) Тогда
				
				ПоказатьПредупреждение(,"Ошибка: не заполнена дата прихода для Транзитной поставки", 4);
				Возврат;
				
			КонецЕсли;
			
			Если мПараметры.Свойство("КоличествоМест") Тогда
				КоличествоМест = мПараметры.КоличествоМест;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(КоличествоМест) Тогда
				
				ПоказатьПредупреждение(,"Ошибка: не заполнено количество мест для Транзитной поставки", 4); 
				Возврат;
				
			КонецЕсли;
			
		Иначе
			
			ПоказатьПредупреждение(,"Ошибка: Для Транзитной поставки необходимо указать дату и количество мест !", 4); 
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	ПараметрыДокумента.Вставить("ДатаПрихода"    ,ДатаПрихода);
	ПараметрыДокумента.Вставить("КоличествоМест" ,КоличествоМест);
	//+Кабанов А.В. 04.12.2024 #UT10-4950

	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПровестиДокументыПТУ", ЭтотОбъект, ПараметрыДокумента);
	
	//+Сёмин Р. 26.12.2025 #UT10-5593
	//ТекстВопроса = "Провести документ № " + СокрЛП(НомерДокумента) + Символы.ПС;
	ТекстВопроса = "Подтвердить поступление на склад документа" + Символы.ПС + "ПТУ № " + СокрЛП(НомерДокумента) + Символы.ПС;
	//-Сёмин Р. 26.12.2025 #UT10-5593
	
	ТекстВопроса = ТекстВопроса + "по контрагенту " + СокрЛП(КонтрагентаДокумента) + "?";
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, Режим);

КонецПроцедуры

&НаКлиенте
Процедура КнТЕНажатие(Команда)
	
	//+Сёмин Р. 19.12.2025 #UT10-5593
	ФормаТранспортныеЕдиницы = ПолучитьФорму("Обработка.ТранспортныеЕдиницы.Форма.ФормаТранспортныхЕдиниц", , ЭтаФорма);
	ФормаТранспортныеЕдиницы.Открыть();
	//-Сёмин Р. 19.12.2025 #UT10-5593
	
КонецПроцедуры

//+UT10-5885
&НаСервере
Процедура УстановитьОтборПоСсылкамПТУ()
	
	МассивСсылок = Новый Массив;
	
	Если ИспользоватьОтборПоСсылкам Тогда
		
		Для Каждого ЧастьСсылки Из СтрРазделить(ОтборСсылокПТУ, ",", Ложь) Цикл
			
			СсылкаПТУ = СокрЛП(ЧастьСсылки);
			
			Если ЗначениеЗаполнено(СсылкаПТУ) Тогда
				МассивСсылок.Добавить(СсылкаПТУ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если МассивСсылок.Количество() = 0 Тогда
		МассивСсылок.Добавить("");
	КонецЕсли;
	
	СписокНепроведенныхПТУ.Параметры.УстановитьЗначениеПараметра("ИспользоватьОтборПоСсылкам", ИспользоватьОтборПоСсылкам);
	СписокНепроведенныхПТУ.Параметры.УстановитьЗначениеПараметра("МассивСсылок", МассивСсылок);
	
КонецПроцедуры
//-UT10-5885
