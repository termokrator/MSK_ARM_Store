			ДобСтрока.Ответ = "Это полный КМ";  
			
			Если ВыводитьВремя Тогда
				ЗамерыВремени.Свойство("ОкончаниеПроверкиВалидности", ДобСтрока.Время);
			КонецЕсли;
			
			
		Иначе           
			
			ДобСтрока = тзПроверка.Добавить();    
			ДобСтрока.Событие = "Проверка криптохвоста";
			ДобСтрока.Штрихкод = ПровКод;
			ДобСтрока.Ответ = "Длина криптохвоста не равна 44 или 88";    
			
			Если ВыводитьВремя Тогда
				ЗамерыВремени.Свойство("CRIPTO", ДобСтрока.Время);
			КонецЕсли;
			
		КонецЕсли;  
			
	Иначе
		
		ДобСтрока = тзПроверка.Добавить();    
		ДобСтрока.Событие = "Проверка криптохвоста";
		ДобСтрока.Штрихкод = ПровКод;
		ДобСтрока.Ответ = "Не найден CRIPTO";  
		
	КонецЕсли;   
	//-Шульман А. 17.11.2025 #UT10-5516
	
КонецПроцедуры // ()

Функция ПроверитьСостояниеКМ(КодМаркировки) Экспорт
	
	//+Шульман А. 13.11.2025 #UT10-5504  
	РезультатПроверкиКМ = Новый Структура("ТекстОшибки, Действие, СостояниеКМ", "", "", "");
	
	Метод = "/api/v1/km_info?orgId=" + Константы.КодМДМГоловнойОрганизации.Получить();
	АдресСервиса = Константы.АдресСервераЧестныйЗнак.Получить();     // "10.90.100.31:30209";    
	
	Если ПустаяСтрока(АдресСервиса) Тогда
		АдресСервиса = "10.90.100.31:30209";
	КонецЕсли;   
	
	Соединение = Новый HTTPСоединение(АдресСервиса,,,,,, ); //Новый ЗащищенноеСоединениеOpenSSL());
	
	ДобСтрока = тзПроверка.Добавить();    
	ДобСтрока.Событие = "HTTPСоединение с сервисом ЧЗ";  
	ДобСтрока.Штрихкод = АдресСервиса;
	ДобСтрока.Ответ = "Успешно";  
	
	
	МассивКодов = Новый Массив;  
	МассивКодов.Добавить(КодМаркировки);     
	
	ПараметрыЗапроса = Новый Структура();  
	ПараметрыЗапроса.Вставить("codes", МассивКодов);     
	Отказ = Ложь;
	
	Попытка

		СтрокаЗапроса = ОбщегоНазначения.ВернутьJSON(ПараметрыЗапроса);
		
		Заголовки = Новый Соответствие;  
		Заголовки.Вставить("Content-type", "application/json");
		Заголовки.Вставить("Cache-Control", "no-cache");  
		
		HTTPЗапрос = Новый HTTPЗапрос();  
		HTTPЗапрос.АдресРесурса = Метод;
		HTTPЗапрос.Заголовки = Заголовки;     

    	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаЗапроса);   
		
		ТекСобытие = "HTTPЗапрос.УстановитьТелоИзСтроки ";
		ДобСтрока = тзПроверка.Добавить();    
		ДобСтрока.Событие = ТекСобытие;   
		ДобСтрока.Штрихкод = СтрокаЗапроса;
		ДобСтрока.Ответ = "Успешно";  
		
    	Результат  = Соединение.ОтправитьДляОбработки(HTTPЗапрос);     //Получить(HTTPЗапрос)
		
		ТекСобытие = "Соединение.Получить(HTTPЗапрос)";
		ДобСтрока = тзПроверка.Добавить();    
		ДобСтрока.Событие = ТекСобытие;      
		ДобСтрока.Штрихкод = Метод;

		ДобСтрока.Ответ = "Успешно";  
		
	Исключение
		
		РезультатПроверкиКМ.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());    
		РезультатПроверкиКМ.Действие = "Обработать ошибку сервиса";  
		
		ДобСтрока = тзПроверка.Добавить();    
		ДобСтрока.Событие = ТекСобытие;
		ДобСтрока.Ответ = "Ошибка: " + РезультатПроверкиКМ.ТекстОшибки;  
		
		Возврат РезультатПроверкиКМ;
		
	КонецПопытки;
	
	ДобСтрока = тзПроверка.Добавить();    
	ДобСтрока.Событие = "HTTPОтветВСтруктуру";
	Ответ = ОбщегоНазначения.HTTPОтветВСтруктуру(Результат);   
	ДобСтрока.Ответ = "Успешно";
	
	Если Не Ответ.КодСостояния = 200 Тогда   
		
		РезультатПроверкиКМ.ТекстОшибки = "Ошибка при чтении данных. Код состояния " + Ответ.КодСостояния; 
		ДобСтрока.Ответ = "Код состояния: " +  Ответ.КодСостояния;
		Отказ = Истина;
	
	ИначеЕсли Не Ответ.Свойство("Тело") Тогда   
		
		РезультатПроверкиКМ.ТекстОшибки = "Не возвращены данные по запросу";  
		ДобСтрока.Ответ = "Код состояния: " +  Ответ.КодСостояния;
		Отказ = Истина;
	
	ИначеЕсли ПустаяСтрока(Ответ.Тело) Тогда
		
		РезультатПроверкиКМ.ТекстОшибки = "Возвращено пустое тело по запросу";   
		ДобСтрока.Ответ = РезультатПроверкиКМ.ТекстОшибки;
		Отказ = Истина;     
		
	КонецЕсли;
	
	Если Отказ Тогда
	
		РезультатПроверкиКМ.Действие = "Обработать ошибку сервиса";  
		Возврат РезультатПроверкиКМ;
		
	КонецЕсли;
	
	ДобСтрока = тзПроверка.Добавить();    
	ДобСтрока.Событие = "ЧтениеJSON.УстановитьСтроку()";   
	ДобСтрока.Штрихкод = СтрЗаменить(Ответ.Тело, Символы.ПС, "");
	ДобСтрока.Штрихкод = СтрЗаменить(ДобСтрока.Штрихкод, " ", "");
	
	Попытка
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Ответ.Тело);    
		ДобСтрока.Ответ = "Успешно";
		
	Исключение
		
		РезультатПроверкиКМ.ТекстОшибки = "Ошибка при разборе JSON-данных";  
		ДобСтрока.Ответ = РезультатПроверкиКМ.ТекстОшибки;

		Возврат РезультатПроверкиКМ;
		
	КонецПопытки;
	
	ДобСтрока = тзПроверка.Добавить();    
	ДобСтрока.Событие = "ПрочитатьJSON";       

	СтруктураДанных = ПрочитатьJSON(ЧтениеJSON, Ложь);     
	ДобСтрока.Ответ = "Успешно";
	
	Если Не СтруктураДанных.Свойство("list") Тогда
		
		РезультатПроверкиКМ.ТекстОшибки = "Ошибка при разборе JSON-данных. Нет свойства list";    
		ДобСтрока.Ответ = РезультатПроверкиКМ.ТекстОшибки;
		РезультатПроверкиКМ.Действие = "Обработать ошибку сервиса";     
		
		Возврат РезультатПроверкиКМ;
		
	КонецЕсли;
	
	СоответствиеСтатусов = Новый Соответствие; 
	СоответствиеСтатусов.Вставить("EMITTED",     "Эмитирован");
	СоответствиеСтатусов.Вставить("APPLIED",     "Нанесён");
	СоответствиеСтатусов.Вставить("INTRODUCED",  "В обороте");
	СоответствиеСтатусов.Вставить("WRITTEN_OFF", "Списан");
	
	ДобСтрока = тзПроверка.Добавить();    
	ДобСтрока.Событие = "Разбор list";
	
	Для каждого ЭлементМассива Из СтруктураДанных.list Цикл
		
		Если КодМаркировки = ЭлементМассива.requestedCis Тогда
			
			ДобСтрока.Штрихкод = ЭлементМассива.status;
			мСостояниеКМ = СоответствиеСтатусов.Получить(ЭлементМассива.status);   
			РезультатПроверкиКМ.СостояниеКМ = ?(мСостояниеКМ = Неопределено, ЭлементМассива.status, мСостояниеКМ);
			
			Если ЭлементМассива.status = "INTRODUCED" Тогда
				РезультатПроверкиКМ.Действие = "Обработать код в обороте";
			Иначе
				РезультатПроверкиКМ.Действие = "Обработать код не в обороте";
			КонецЕсли;
			
			ДобСтрока.Ответ = РезультатПроверкиКМ.СостояниеКМ;

			Возврат РезультатПроверкиКМ;
			
		КонецЕсли;
		
	КонецЦикла;
	
	РезультатПроверкиКМ.ТекстОшибки = "Нет переданного кода маркировки в полученных данных";    
	ДобСтрока.Ответ = РезультатПроверкиКМ.ТекстОшибки;
	РезультатПроверкиКМ.Действие = "Обработать ошибку сервиса";   
	
	Возврат РезультатПроверкиКМ;
	//-Шульман А. 13.11.2025 #UT10-5504

КонецФункции // ()

Процедура ВывестиВремя(тзСтрока, ВыводитьВремя)
	
	Если ВыводитьВремя Тогда
		
		Индекс1 = тзПроверка.Индекс(тзСтрока);
		тзСтрокаПред = тзПроверка.Получить(Индекс1 - 1);
	
	КонецЕсли;
	

КонецПроцедуры



