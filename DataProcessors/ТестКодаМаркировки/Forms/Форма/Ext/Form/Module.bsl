&НаСервере
Функция ЭтоШтрихКодМаркировки_Удалить(ПромШтрихКод)  
	
	СтруктураШтрихКодаМаркировки = Новый Структура;
	СтруктураШтрихКодаМаркировки.Вставить("Результат" , Ложь);
	СтруктураШтрихКодаМаркировки.Вставить("ШтрихКод"  , ПромШтрихКод);
	
	Если (Лев(ПромШтрихКод , 2) = "01" И Сред(ПромШтрихКод,17,2) = "21") Или (Лев(ПромШтрихКод , 4) = "(01)" И Сред(ПромШтрихКод,19,4) = "(21)") Тогда
		
		СтруктураШтрихКодаМаркировки.Вставить("Результат"       , Истина); 
		
		ПростойВидШтрихКода = Лев(ПромШтрихКод , 2) = "01";                
		
		//Получаем оба вида штрих-кода
		Если ПростойВидШтрихКода Тогда
			
			СтруктураШтрихКодаМаркировки.Вставить("ШтрихКодКраткий" , Лев(ПромШтрихКод , 31));
			ПромШтрихКодПолный = "(01)" + Сред(ПромШтрихКод,3,14) + "(21)" + Сред(ПромШтрихКод , 19 , 13);
			СтруктураШтрихКодаМаркировки.Вставить("ШтрихКодПолный"  , ПромШтрихКодПолный);
			
		Иначе 

			СтруктураШтрихКодаМаркировки.Вставить("ШтрихКодПолный"  , Лев(ПромШтрихКод , 35));
			ПромШтрихКодКраткий =  "01" + Сред(ПромШтрихКод,5,14) + "21" + Сред(ПромШтрихКод , 23 , 13);
			СтруктураШтрихКодаМаркировки.Вставить("ШтрихКодКраткий" , ПромШтрихКодКраткий);
			
		КонецЕсли;

		// Выделяем GTIN
		СтруктураШтрихКодаМаркировки.Вставить("GTIN"                , Сред(СтруктураШтрихКодаМаркировки.ШтрихКодКраткий , 3 , 14));
		
		ДобСтрока = тзПроверка.Добавить();    
		ДобСтрока.Событие = "Анализ КМ старый";
		ДобСтрока.Штрихкод = СтруктураШтрихКодаМаркировки.ШтрихКодКраткий;
		ДобСтрока.Ответ = "Это КМ";
		
	Иначе
		
		ДобСтрока = тзПроверка.Добавить();    
		ДобСтрока.Событие = "Анализ КМ старый";
		ДобСтрока.Ответ = "Это не КМ";
		
		СтруктураШтрихКодаМаркировки.Вставить("Результат" , Ложь); 
		
	КонецЕсли;
		
	ДанныеШтрихкода = РазложитьКодМаркировки_Удалить(ПромШтрихКод);    
	
	Если ДанныеШтрихкода.ЭтоКодМаркировки Тогда       
		
		СтруктураШтрихКодаМаркировки.Вставить("Результат",       Истина); 
		СтруктураШтрихКодаМаркировки.Вставить("ШтрихКодКраткий", ДанныеШтрихкода.ШтрихКодКраткий);
		СтруктураШтрихКодаМаркировки.Вставить("ШтрихКодПолный",  ДанныеШтрихкода.ШтрихКодПолный); 
		СтруктураШтрихКодаМаркировки.Вставить("GTIN",            ДанныеШтрихкода.ЧастиКода.GTIN);  
		
		ДобСтрока = тзПроверка.Добавить();    
		ДобСтрока.Событие = "Анализ КМ новый";
		ДобСтрока.Штрихкод = СтруктураШтрихКодаМаркировки.ШтрихКодКраткий;
		ДобСтрока.Ответ = "Это КМ";
		
	Иначе
		
		ДобСтрока = тзПроверка.Добавить();    
		ДобСтрока.Событие = "Анализ КМ новый";
		ДобСтрока.Ответ = "Это не КМ";
		
		СтруктураШтрихКодаМаркировки.Вставить("Результат" , Ложь);   
		
	КонецЕсли;                     
		
	Возврат СтруктураШтрихКодаМаркировки;
	
КонецФункции

&НаСервере
Функция РазложитьКодМаркировки_Удалить(ПромШтрихКод) Экспорт
	
	//+Шульман А. 17.11.2025 #UT10-5516	                                  
	ЧастиКода = Новый Структура();
	ДанныеШтрихкода = Новый Структура("ЭтоКодМаркировки, ПройденаПроверкаКраткогоКода, ШтрихКодКраткий, ШтрихКодПолный, ЧастиКода", Ложь, Ложь, "", "", ЧастиКода); 
	ПровКод = ПромШтрихКод;
	
	//x01GTINGTINGTINGT21SERIALSERIALSx91KEYKx92CRIPTOCRIPT...
	ЧастиКода.Вставить("FNC1", 0);     // 1
	ЧастиКода.Вставить("S01", 0);       // 2
	ЧастиКода.Вставить("GTIN", "");    // 14
	ЧастиКода.Вставить("S21", 0);       // 2
	ЧастиКода.Вставить("SERIAL", "");  // 13
	ЧастиКода.Вставить("S91", 0);       // 2      
	ЧастиКода.Вставить("S93", 0);       // 2
	ЧастиКода.Вставить("KEY", "");     // 4
	ЧастиКода.Вставить("S92", 0);       // 2
	ЧастиКода.Вставить("CRIPTO", "");  // 44
	
	ДобСтрока = тзПроверка.Добавить();    
	ДобСтрока.Событие = "Проверка первого символа";
	ДобСтрока.Штрихкод = ПровКод;
	
	КодПервогоСимвола = КодСимвола(ПровКод, 1);
	
	Если КодПервогоСимвола < 32 И КодПервогоСимвола > 126 Тогда     
		
		// Это нечитаемый символ, его нужно пропустить
		ПровКод = Сред(ПровКод, 2);
		ДобСтрока.Ответ = "Первый символ нечитаемый, имеет код " + КодПервогоСимвола + ", отбрасывается";
		
	Иначе   
		ДобСтрока.Ответ = "Первый символ читаемый: " + Лев(ПровКод, 1);
	КонецЕсли;  
	
	
	//01GTINGTINGTINGT21SERIALSERIALSx91KEYKx92CRIPTOCRIPT...
	Если СтрДлина(ПровКод) < 31 Тогда   
		
		ДобСтрока = тзПроверка.Добавить();    
		ДобСтрока.Событие = "Проверка: Длина штрикхода меньше 31";
		ДобСтрока.Ответ = "Это не КМ, т.к. длина кода " + СтрДлина(ПровКод);  
		ДобСтрока.Штрихкод = ПровКод;
		Возврат ДанныеШтрихкода;
		
	КонецЕсли;   
	
	// Проверка 01   
	ДобСтрока = тзПроверка.Добавить();    
	ДобСтрока.Событие = "Проверка на 01 или (01)";
	ДобСтрока.Штрихкод = ПровКод;
	
	ЕстьСкобки = Ложь;
	
	Если Лев(ПровКод, 2) = "01" Тогда     
		
		ПровКод = Сред(ПровКод, 3);   
		ЧастиКода.Вставить("S01", "01");   
		
	ИначеЕсли Лев(ПровКод, 4) = "(01)" Тогда     
		
		ПровКод = Сред(ПровКод, 5);   
		ЧастиКода.Вставить("S01", 1);  
		ЕстьСкобки = Истина;
		
	Иначе           
		
		ДобСтрока.Ответ = "Не найден 01, (01)";  
		Возврат ДанныеШтрихкода;
		
	КонецЕсли;
	
	ДобСтрока.Ответ = "Успешно";  
	
	//GTINGTINGTINGT21SERIALSERIALSx91KEYKx92CRIPTOCRIPT...   
	
	ЧастиКода.Вставить("GTIN", Лев(ПровКод, 14));   
	ДобСтрока = тзПроверка.Добавить();    
	ДобСтрока.Событие = "Получен GTIN";
	ДобСтрока.Штрихкод = ПровКод;   
	ДобСтрока.Ответ = ЧастиКода.GTIN;
	
	ПровКод = Сред(ПровКод, 15);   
	
	//21SERIALSERIALSX91KEYKx92CRIPTOCRIPT...  
	ДобСтрока = тзПроверка.Добавить();   
	ДобСтрока.Событие = ?(ЕстьСкобки, "Проверка на (21)",  "Проверка на 21");
	ДобСтрока.Штрихкод = ПровКод;
	
	Если Лев(ПровКод, 2) = "21" И Не ЕстьСкобки Тогда     
		
		ЧастиКода.Вставить("S21", 1);
		ПровКод = Сред(ПровКод, 3);   
		
	ИначеЕсли Лев(ПровКод, 4) = "(21)" И ЕстьСкобки Тогда     
		
		ЧастиКода.Вставить("S21", 1);
		ПровКод = Сред(ПровКод, 5);   
		
	Иначе                         
		
		ДобСтрока.Ответ = ?(ЕстьСкобки, "Не найден (21)", "Не найден 21");  
		Возврат ДанныеШтрихкода; 
		
	КонецЕсли;    
	
	ДобСтрока.Ответ = "Успешно";  
	
	
	//SERIALSERIALSx91KEYKx92CRIPTOCRIPT... 
	ЧастиКода.Вставить("SERIAL", Лев(ПровКод, 13));  
	
	ДобСтрока = тзПроверка.Добавить();    
	ДобСтрока.Событие = "Получен SERIAL";
	ДобСтрока.Штрихкод = ПровКод;
	ДобСтрока.Ответ = ЧастиКода.SERIAL;
	
	ДанныеШтрихкода.ШтрихКодКраткий = "01" + ЧастиКода.GTIN + "21" + ЧастиКода.SERIAL;
	ДанныеШтрихкода.ШтрихКодПолный  = "(01)" + ЧастиКода.GTIN + "(21)" + ЧастиКода.SERIAL;
	
	ДобСтрока = тзПроверка.Добавить();    
	ДобСтрока.Событие = "Пройдена проверка краткого кода";
	ДобСтрока.Штрихкод = ДанныеШтрихкода.ШтрихКодКраткий; 
	ДобСтрока.Ответ = "Успешно";
	ДанныеШтрихкода.ПройденаПроверкаКраткогоКода = Истина;
	
	Если Не Константы.РасширеннаяПроверкаВалидностиКодовМаркировкиЧЗ.Получить() Тогда   
		
		// Если не стоит константа РасширеннаяПроверкаВалидностиКодовМаркировкиЧЗ, то проверку заканчиваем       
		ДобСтрока.Ответ = "Это краткий КМ";
		
		ДанныеШтрихкода.ЭтоКодМаркировки = Истина;     
