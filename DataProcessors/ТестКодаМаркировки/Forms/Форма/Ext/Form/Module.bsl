
&НаКлиенте
Перем Компонента;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Компонента = ОбщегоНазначенияКлиент.ПодключитьКомпоненту();	
	
	Если Компонента <> Неопределено И Не Компонента.Подключить() Тогда		
		ТекстОшибки = "";
		КодОшибки = Компонента.ПолучитьОшибку(ТекстОшибки);                                                   
		ПоказатьПредупреждение(,"Ошибка: "+КодОшибки+", " + ТекстОшибки);
	КонецЕсли;	
	
КонецПроцедуры


&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если Компонента <> Неопределено Тогда		
		Компонента.Отключить();	
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СканированиеШтрихкода" Тогда
		
		#Если МобильноеПриложениеКлиент Тогда
			Если ЗначениеЗаполнено(ЭтаФорма.ОписаниеОшибки) Тогда
				Компонента.Отключить();
			Иначе
				Компонента.Подключить();
			КонецЕсли; 
		#КонецЕсли 	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	// Пользователь может нажать несколько раз сканирование штрихкода, но форма уже закрыта.  
	//+Шульман А. 05.12.2025 #UT10-5576   
	Если Не Источник = "Вручную" Тогда
	//-Шульман А. 05.12.2025 #UT10-5576   
	
		Если Не ВводДоступен() Тогда   
			Возврат;
		КонецЕсли; 
		
	КонецЕсли;
	
	СимволРазделитель = "{GS}";
		
	Если Событие = "UniversalBroadcastEvent" Тогда
		
		Если Не Источник = "Вручную" Тогда
			
			Результат = ОбщегоНазначения.ПолучитьЗначениеШтрихкода(Данные, СимволРазделитель);
			
			Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
				
				ПоказатьПредупреждение(, "Ошибка сканирования штрихкода", 4);
				Возврат;
				
			КонецЕсли;
			
			ШтрихкодДляПроверки = Результат.Штрихкод; 
			
		Иначе
			ШтрихкодДляПроверки = СОКРЛП(Данные);	
		КонецЕсли;	
			
		Если ОбщегоНазначения.ПолучитьКонстанту("РасширеннаяПроверкаВалидностиКодовМаркировкиЧЗ") Тогда
			
			СтрокаGS = "";
			
			Попытка
				
				Если Не Источник = "Вручную" Тогда
					СтрокаGS = ОбщегоНазначенияКлиент.ПолучитьПозицииGS(ШтрихкодДляПроверки, СимволРазделитель);
				Иначе
					СтрокаGS = ОбщегоНазначенияКлиент.ПолучитьПозицииGS_Тест(ШтрихкодДляПроверки);
					
					//+Сёмин Р.И. 29.04.2026 #UT10-5814
					СимволРазделительРучной = "<GS>";
					
					Пока НЕ СтрНайти(ШтрихкодДляПроверки, СимволРазделительРучной) = 0 Цикл
						ШтрихкодДляПроверки = СтрЗаменить(ШтрихкодДляПроверки, СимволРазделительРучной, "");
					КонецЦикла;
					//-Сёмин Р.И. 29.04.2026 #UT10-5814
					
				КонецЕсли;
				
				Пока НЕ СтрНайти(ШтрихкодДляПроверки, СимволРазделитель) = 0 Цикл
					ШтрихкодДляПроверки = СтрЗаменить(ШтрихкодДляПроверки, СимволРазделитель, "");
				КонецЦикла;
				
		 	Исключение                                           
				
				ASK_ОбработкаОшибок.ЗаписатьИнформациюВЛогОшибок("Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), 
				"Проверка КМ. ВнешнееСобытие", "Поиск GS");   
				Возврат;
				
			КонецПопытки;     
		
		КонецЕсли;
		
		ПроверитьНаСервере(ШтрихкодДляПроверки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаСервере(Данные)
	
	тзПроверка.Очистить();
	
	ДобСтрока = тзПроверка.Добавить();      
	ДобСтрока.Событие = "=== Проверка валидности ===";  
	
	Если Константы.РасширеннаяПроверкаВалидностиКодовМаркировкиЧЗ.Получить() Тогда
		ДобСтрока.Событие = "=== Проверка валидности расширенная ===";  
	КонецЕсли;
	
	ДобСтрока.Время = 0;                
	ЧастиКода = ОбщегоНазначения.ПолучитьСтруктуруЧастиКода();   
	
	МассивGS = СтрРазделить(СтрокаGS, ";");
	
	Если ТипЗнч(МассивGS) = Тип("Массив") Тогда
		
		Если МассивGS.Количество() > 0 Тогда
			ЧастиКода.Вставить("GS1", МассивGS[0]);       // Позиция первого GS
		КонецЕсли;
		
		Если МассивGS.Количество() > 1 Тогда
			ЧастиКода.Вставить("GS2", МассивGS[1]);       // Позиция второго GS
		КонецЕсли;
		
		Если МассивGS.Количество() > 2 Тогда
			ЧастиКода.Вставить("GS3", МассивGS[2]);       // Позиция третьего GS
		КонецЕсли;  
			
	КонецЕсли;
		
	НачВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();   
	/////////////////////////////////////////////////////////////////////////
	РезультатПроверкиШтрихКодаМаркировки = ОбщегоНазначения.ЭтоШтрихКодМаркировки(Данные, ЧастиКода, Истина);    
	/////////////////////////////////////////////////////////////////////////
	
	ПоследнееТекВремя = 0;
	
	//+Сёмин Р.И. 30.04.2026 #UT10-5814
	//ПоказатьАнализКодаМаркировки(Данные);
	ПоказатьАнализКодаМаркировки(Данные, РезультатПроверкиШтрихКодаМаркировки.ТекстОшибки);
	//-Сёмин Р.И. 30.04.2026 #UT10-5814
		
	Если РезультатПроверкиШтрихКодаМаркировки.Результат Тогда
		
		КодМаркировки = РезультатПроверкиШтрихКодаМаркировки.ШтрихКодКраткий;
		
		ПоследняяСтрока = тзПроверка.Получить(тзПроверка.Количество() - 1);   
		ТекВремя = ПоследняяСтрока.Время;    
		
		ДобСтрока = тзПроверка.Добавить();      
		ДобСтрока.Событие = "=== Проверка состояния ===";
		
		РезультатПроверкиКМ = ПроверитьСостояниеКМ(КодМаркировки);    
		СостояниеКМ = РезультатПроверкиКМ.СостояниеКМ;   
		
		ПоследняяСтрока = тзПроверка.Получить(тзПроверка.Количество() - 1);   
		
		ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
		ПоследняяСтрока.Время = ВремяСНачала - ТекВремя;
		
	Иначе
		
		ДобСтрока = тзПроверка.Добавить();    
		ДобСтрока.Штрихкод = РезультатПроверкиШтрихКодаМаркировки.ШтрихКодКраткий;
		ДобСтрока.Ответ = "Это не КМ";   
		
	КонецЕсли;

КонецПроцедуры

