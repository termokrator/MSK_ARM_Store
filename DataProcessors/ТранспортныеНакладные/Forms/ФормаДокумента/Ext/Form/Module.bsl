&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Идентификатор = Параметры.Идентификатор;
	РезультатСтруктура = ОбщегоНазначения.ПолучитьТранспортнуюНакладную(Идентификатор);
	
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		Сообщить("Ошибка: " + РезультатСтруктура.Ошибка);
		Возврат;
	КонецЕсли;
	
	Данные = РезультатСтруктура.Данные;
	КоличествоМест = Данные.КоличествоМест;
	
	КоличествоГруза = 0;
	
	Если ТипЗнч(Данные.Груз) = Тип("Массив") Тогда
		КоличествоГруза = Данные.Груз.Количество();
		ГрузJSON = ОбщегоНазначения.ЗначениеВJSON(Данные.Груз);
	КонецЕсли;
	
	Если ТипЗнч(Данные.СопоставленныеПТУ) = Тип("Массив") Тогда
		
		ДобавленныеСсылки = Новый Соответствие;
		
		Для Каждого СтрокаПТУ Из Данные.СопоставленныеПТУ Цикл
			
			СсылкаПТУ = СокрЛП(Строка(СтрокаПТУ.СсылкаПТУ));
			
			Если НЕ ЗначениеЗаполнено(СсылкаПТУ) ИЛИ ДобавленныеСсылки.Получить(СсылкаПТУ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавленныеСсылки.Вставить(СсылкаПТУ, Истина);
			НоваяСтрока = СопоставленныеПТУ.Добавить();
			НоваяСтрока.СсылкаПТУ = СсылкаПТУ;
			НоваяСтрока.НомерДокумента = Строка(СтрокаПТУ.НомерДокумента);
			НоваяСтрока.НомерСкладскогоДокумента = Строка(СтрокаПТУ.НомерСкладскогоДокумента);
			НоваяСтрока.Контрагент = Строка(СтрокаПТУ.Контрагент);
			НоваяСтрока.Транзит = СтрокаПТУ.Транзит = Истина;
			НоваяСтрока.ДатаДокумента = ОбщегоНазначения.ДатаИзСтрокиJSON(СтрокаПТУ.ДатаДокумента);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Элементы.ДекорацияГруз.Заголовок = "Груз (" + Формат(КоличествоГруза, "ЧГ=0") + ")";
	Элементы.ДекорацияСопроводительныеДокументы.Заголовок = "Сопроводительные документы (" + Формат(СопоставленныеПТУ.Количество(), "ЧГ=0") + ")";
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияГрузНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура("ГрузJSON", ГрузJSON);
	ФормаГруза = ПолучитьФорму("Обработка.ТранспортныеНакладные.Форма.ФормаГруза", ПараметрыФормы, ЭтаФорма);
	ФормаГруза.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияСопроводительныеДокументыНажатие(Элемент)
	
	Если СопоставленныеПТУ.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Сопоставленные документы не найдены", 3);
		Возврат;
	КонецЕсли;
	
	Ссылки = Новый Массив;
	
	Для Каждого СтрокаПТУ Из СопоставленныеПТУ Цикл
		Ссылки.Добавить(СтрокаПТУ.СсылкаПТУ);
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура("ОтборСсылокПТУ", СтрСоединить(Ссылки, ","));
	ФормаСписка = ПолучитьФорму("Обработка.ТоварыВПути.Форма.ФормаНепроведенныхПТУ", ПараметрыФормы, ЭтаФорма);
	ФормаСписка.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	Если НЕ ЗначениеЗаполнено(КоличествоМестФакт) Тогда
		ПоказатьПредупреждение(, "Укажите количество мест (факт.)", 3);
		Возврат;
	КонецЕсли;
	
	РезультатСтруктура = ОбщегоНазначения.СоздатьТитул3ТранспортнойНакладной(Идентификатор, КоличествоМестФакт);
	
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		ПоказатьПредупреждение(, "Ошибка: " + РезультатСтруктура.Ошибка, 4);
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(РезультатСтруктура.Данные) = Тип("Структура")
		И РезультатСтруктура.Данные.Свойство("Успех")
		И РезультатСтруктура.Данные.Успех <> Истина Тогда
		
		ПоказатьПредупреждение(, "Не удалось создать титул 3", 4);
		Возврат;
		
	КонецЕсли;
	
	Если СопоставленныеПТУ.Количество() = 0 Тогда
		
		Сообщить("Перейдите в Товары в пути и переведите соответствующий данной поставке документ ПТУ в состояние ""Поступил на склад""");
		
	Иначе
		ПеревестиСопоставленныеПТУ();
	КонецЕсли;
	
	Оповестить("ОбновлениеТранспортныхНакладных");
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиСопоставленныеПТУ()
	
	Для Каждого СтрокаПТУ Из СопоставленныеПТУ Цикл
		
		ДатаПрихода = Дата(1, 1, 1);
		КоличествоМестТранзит = 0;
		
		Если СтрокаПТУ.Транзит Тогда
			
			ПараметрыТранзита = ОткрытьФормуМодально("Обработка.ТоварыВПути.Форма.ФормаТранзитнойПоставки", Новый Структура("ДатаПрихода, КоличествоМест", ДатаПрихода, КоличествоМестТранзит), ЭтаФорма);
			
			Если ПараметрыТранзита = Неопределено
				ИЛИ НЕ ПараметрыТранзита.Свойство("ДатаПрихода")
				ИЛИ НЕ ЗначениеЗаполнено(ПараметрыТранзита.ДатаПрихода)
				ИЛИ НЕ ПараметрыТранзита.Свойство("КоличествоМест")
				ИЛИ НЕ ЗначениеЗаполнено(ПараметрыТранзита.КоличествоМест) Тогда
				
				Сообщить(ТекстСообщенияПТУ(СтрокаПТУ) + " не переведен в состояние ""Поступил на склад"": не указаны данные транзитной поставки");
				Продолжить;
				
			КонецЕсли;
			
			ДатаПрихода = ПараметрыТранзита.ДатаПрихода;
			КоличествоМестТранзит = ПараметрыТранзита.КоличествоМест;
			
		КонецЕсли;
		
		РезультатПроведения = ОбщегоНазначения.ОбработатьПроведениеДокументаПТУ(СтрокаПТУ.СсылкаПТУ, ДатаПрихода, КоличествоМестТранзит);
		
		Если ЗначениеЗаполнено(РезультатПроведения.Ошибка) Тогда
			Сообщить("Ошибка: " + РезультатПроведения.Ошибка);
		Иначе
			Сообщить(ТекстСообщенияПТУ(СтрокаПТУ) + " переведен в состояние ""Поступил на склад""");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ТекстСообщенияПТУ(СтрокаПТУ)
	
	НомерДокумента = СокрЛП(СтрокаПТУ.НомерСкладскогоДокумента);
	
	Если НЕ ЗначениеЗаполнено(НомерДокумента) Тогда
		НомерДокумента = СокрЛП(СтрокаПТУ.НомерДокумента);
	КонецЕсли;
	
	Возврат "Документ ПТУ № " + НомерДокумента + " от " + Формат(СтрокаПТУ.ДатаДокумента, "ДФ=dd.MM.yyyy");
	
КонецФункции
