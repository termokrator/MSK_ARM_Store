КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если Компонента <> Неопределено Тогда		
		Компонента.Отключить();	
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияПередЗакрытием(Отказ)
	
	//+Шульман А. 28.11.2025 #UT10-5548
	ЗаписатьВБуферНеотсканированныеМарки();  
	
	Если РезультатПередЗакрытием.Свойство("Отказ") Тогда
		Отказ = Истина;
		
	ИначеЕсли РезультатПередЗакрытием.Свойство("ПроверитьЛичныйШК") Тогда   
		
		//+Шульман А. 05.12.2025 #UT10-5576
		ИгнорироватьВнешнееСобытие = Истина;
		
		Если Компонента <> Неопределено Тогда		
			Компонента.Отключить();	
		КонецЕсли;  
		//-Шульман А. 05.12.2025 #UT10-5576
		
		Отказ = Истина;     
		
		ДополнительныеПараметры  = Новый Структура("Возвращать, Результат", РезультатПередЗакрытием.Возвращать, РезультатПередЗакрытием);    
		
		Оповещение = Новый ОписаниеОповещения("ЗаписатьВБуферНеотсканированныеМаркиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗаголовокПоляВвода", "Подтвердите размещение остатка для " + ?(РезультатПередЗакрытием.Возвращать, "возврата", "маркировки"));	
		
		ОткрытьФорму("Обработка.ОбщиеФормы.Форма.ФормаАвторизация", ПараметрыФормы, ЭтаФорма, ,, , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
		
	КонецЕсли;
	//-Шульман А. 28.11.2025 #UT10-5548

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВБуферНеотсканированныеМарки()
	
	ЕстьНеОтсканированнаяМаркировка = ПолучитьНеотсканированныеМаркировки(); 
	
	РезультатПередЗакрытием = Новый Структура();
	
	Если Не ЕстьНеОтсканированнаяМаркировка Тогда    
		
		//+Шульман А. 28.11.2025 #UT10-5548 К05122025
		//РезультатПередЗакрытием.Вставить("ЗаписатьМаркировкиВПТУ");   
		ПерейтиВСписокДокументов = Истина;
		ЗаписатьМаркировкиВПТУ();
		//-Шульман А. 28.11.2025 #UT10-5548 К05122025
		Возврат;
		
	КонецЕсли;
	
	// Есть неотсканированные марки, нужна маркировка  
	СписокОтветов = Новый СписокЗначений;  
	
	СписокОтветов.Добавить(1, "Создать на оставшиеся позиции маркировку");   
	СписокОтветов.Добавить(2, "Разместить для возврата");         
	СписокОтветов.Добавить(3, "Не создавать");     
	
	ОтветНаВопрос = Вопрос("" , СписокОтветов , , 1 , "Отсканированы не все марки");  
	
	Если ОтветНаВопрос = 1 Тогда  
		
		РезультатПередЗакрытием.Вставить("ПроверитьЛичныйШК");    
		РезультатПередЗакрытием.Вставить("Возвращать", Ложь);  
		
	ИначеЕсли ОтветНаВопрос = 2 Тогда
		
		РезультатПередЗакрытием.Вставить("ПроверитьЛичныйШК");    
		РезультатПередЗакрытием.Вставить("Возвращать", Истина);   
		
	ИначеЕсли ОтветНаВопрос = 3 Тогда  
		
		// Кладовщик отказывается от маркировки, просто нужна запись отсканированных марок в ПТУ
		тзОстатокМаркировка.Очистить();                       
		//+Шульман А. 28.11.2025 #UT10-5548 К05122025
		//РезультатПередЗакрытием.Вставить("ЗаписатьМаркировкиВПТУ"); 
		ЗаписатьМаркировкиВПТУ();
        //-Шульман А. 28.11.2025 #UT10-5548 К05122025
		
	Иначе
		РезультатПередЗакрытием.Вставить("Отказ");
	КонецЕсли;   

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВБуферНеотсканированныеМаркиЗавершение(РезультатОтвет, ДопПараметры) Экспорт
	
	//+Шульман А. 28.11.2025 #UT10-5548 
	Если РезультатОтвет = "ОК" Тогда
		
		ЗаписатьВБуферНеотсканированныеМаркиФрагмент(ДопПараметры.Возвращать, ДопПараметры.Результат);   
		//+Шульман А. 28.11.2025 #UT10-5548 К05122025
		//Закрыть();
		//-Шульман А. 28.11.2025 #UT10-5548 К05122025
		
	Иначе         
		
		РезультатПередЗакрытием = Новый Структура;   
		тзОстатокМаркировка.Очистить();   
		
		//+Шульман А. 28.11.2025 #UT10-5548 К05122025  
		//РезультатПередЗакрытием.Вставить("ЗаписатьМаркировкиВПТУ");
		//Закрыть();       
		ПерейтиВСписокДокументов = Истина;
		ЗаписатьМаркировкиВПТУ();
		//-Шульман А. 28.11.2025 #UT10-5548 К05122025
		
	КонецЕсли;
	//-Шульман А. 28.11.2025 #UT10-5548

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВБуферНеотсканированныеМаркиФрагмент(Возвращать, Результат)
	
	//+Шульман А. 28.11.2025 #UT10-5548   
	РезультатПередЗакрытием = Новый Структура;
	
	ОбщаяЯчейкаДляМаркировки = ОбщегоНазначения.ПолучитьКонстанту("ЯчейкаДляМаркировки"); 
	ОбщаяЯчейкаДляПеремаркировки = ОбщегоНазначения.ПолучитьКонстанту("ЯчейкаДляПеремаркировки"); 
	ОбщаяЯчейкаДляВозврата = ОбщегоНазначения.ПолучитьКонстанту("ЯчейкаДляВозврата"); 
	
	Если Возвращать Тогда
		ЯчейкаДляМаркировки = ОбщаяЯчейкаДляВозврата;  
	КонецЕсли;
	
	ГУИДПользователя = ОбщегоНазначения.ПолучитьПользователяГУИД();  
	ТекДата = ТекущаяДата();  
	
	РежимВвода = ОбщегоНазначения.УстановленРежимВводаРучной();
	
	Для каждого тзСтрока Из тзОстатокМаркировка Цикл
		
		мТоварГУИД = тзСтрока.СсылкаТовара;      
		мКоличество = тзСтрока.Количество;   
		мШтрихкод = "";       
		
		Если Не Возвращать Тогда
		
			Если тзСтрока.ПревышенаДатаМаркировкиОстатков Тогда
				ЯчейкаДляМаркировки = ОбщаяЯчейкаДляПеремаркировки;
            Иначе
				ЯчейкаДляМаркировки = ОбщаяЯчейкаДляМаркировки;
			КонецЕсли;
			
		КонецЕсли;   
		
		РезультатСтруктура = ОбщегоНазначения.ДобавитьТоварВБуферАРМКладовщика(Объект.ДокументГУИД, мТоварГУИД, ГУИДПользователя, 
				ТекДата, мШтрихкод, мКоличество, ЯчейкаДляМаркировки, РежимВвода);			
		
		Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда  
					
			ПоказатьПредупреждение(, "Ошибка: " + РезультатСтруктура.Ошибка, 4);    
			
			РезультатПередЗакрытием.Вставить("Отказ");
			Возврат;
			
		ИначеЕсли РезультатСтруктура.Данные = Ложь Тогда 
			
			ПоказатьПредупреждение(, "Ошибка записи в буфер кладовщика для создания кода маркировки");
			РезультатПередЗакрытием.Вставить("Отказ");
			Возврат;
			
		КонецЕсли; 
		
	КонецЦикла;   
	
	//+Шульман А. 28.11.2025 #UT10-5548 К05122025
	//РезультатПередЗакрытием.Вставить("СоздатьРазмещениеДляМаркировки");
	//РезультатПередЗакрытием.Вставить("ЗаписатьМаркировкиВПТУ");  
	ПерейтиВСписокДокументов = Истина;
	СоздатьДокументРазмещения();          
	ЗаписатьМаркировкиВПТУ(", созданы размещения для маркировки");
	//-Шульман А. 28.11.2025 #UT10-5548 К05122025

	//-Шульман А. 28.11.2025 #UT10-5548

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументРазмещения() Экспорт
	
	//+Шульман А. 02.10.2025 #UT10-5438  
	РезультатСтруктура = ОбщегоНазначения.СоздатьДокуметРазмещенияПоЯчейкам(Объект.ДокументГУИД);
	
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		
		Если НЕ РезультатСтруктура.Ошибка = "Отсутствуют отсканированные строки документа" Тогда
			ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 4);	
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли; 
	
	//ТекстСообщения = "Создан документ размещения по ячейкам № %1 %2. Документ проведен";
	//
	//ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
	//		РезультатСтруктура.Данные.НомерДокумента,
	//		РезультатСтруктура.Данные.ДатаДокумента 
	//		);						
	//		
	//Оповестить("СообщениеСозданДокументРазмещенияПоЯчейкам", Новый Структура("ТекстСообщения", ТекстСообщения));	
	//-Шульман А. 02.10.2025 #UT10-5438
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьМаркировкиВПТУ(ДобТекст = "") Экспорт 
	
	РезультатСтруктура = ОбщегоНазначения.ЗаписатьМаркировкиВДокументПТУ(Объект.ДокументГУИД);
	
	
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		
		Если НЕ РезультатСтруктура.Ошибка = "Отсутствуют отсканированные маркировки" Тогда
			ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 4);	
		КонецЕсли;
		
		//+Шульман А. 28.11.2025 #UT10-5548 К05122025
		Если ПерейтиВСписокДокументов Тогда
			
			Закрыть();
			ОткрытьФорму("Обработка.ПриемкаКоллективная.Форма.ФормаСпискаПТУ");			
			Оповестить("МаркировкиЗаписаныВПТУ", Новый Структура("ТекстСообщения", 
			"Отсутствуют отсканированные маркировки" + ДобТекст));    
			
		КонецЕсли;
		//-Шульман А. 28.11.2025 #UT10-5548 К05122025

		Возврат;
		
	КонецЕсли; 
	
	ТекстСообщения = "Маркировки записаны в ПТУ № %1 %2 . Документ проведен";
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
			РезультатСтруктура.Данные.НомерДокумента,
			РезультатСтруктура.Данные.ДатаДокумента 
			);						
			
	Закрыть();
	ОткрытьФорму("Обработка.ПриемкаКоллективная.Форма.ФормаСпискаПТУ");			
	Оповестить("МаркировкиЗаписаныВПТУ", Новый Структура("ТекстСообщения", ТекстСообщения));
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = "ГруппаНеСохраненныхМаркировок" Тогда
		
		РезультатСтруктура = ОбщегоНазначения.ПолучитьСписокМаркировокПоПТУ(Объект.ДокументГУИД);
		
		Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
			ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 3);	
			Закрыть();	
			Возврат;
		КонецЕсли; 
		
		//+Шульман А. 02.10.2025 #UT10-5438
		РезультатСтруктура = ОбщегоНазначения.ПолучитьСписокТоваровИзБуфераРазмещения(Объект.ДокументГУИД);     
		
		Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
			ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 3);	
			Закрыть();	
			Возврат;
		КонецЕсли; 
		//-Шульман А. 02.10.2025 #UT10-5438
		
		Элементы.СписокМаркировокВБуфере.Обновить();
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНеотсканированныеМаркировки()
	
	//+Шульман А. 02.10.2025 #UT10-5438   
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокТоваровДокументаПТУ.СсылкаТовара КАК СсылкаТовара,
		|	СписокТоваровДокументаПТУ.КоличествоТоваровСМаркировкой - СписокТоваровДокументаПТУ.КоличествоВБуфереМаркировок - СписокТоваровДокументаПТУ.КоличествоОтсканированныхМаркировок КАК Количество,
		|	СписокТоваровДокументаПТУ.КоличествоРазместитьДляВозврата КАК КоличествоРазместитьДляВозврата,
		|	СписокТоваровДокументаПТУ.НаименованиеТовара КАК НаименованиеТовара,
		|	СписокТоваровДокументаПТУ.ПревышенаДатаМаркировкиОстатков КАК ПревышенаДатаМаркировкиОстатков,
		|	СписокТоваровДокументаПТУ.ТоварнаяГруппа КАК ТоварнаяГруппа
		|ИЗ
		|	РегистрСведений.СписокТоваровДокументаПТУ КАК СписокТоваровДокументаПТУ
		|ГДЕ
		|	СписокТоваровДокументаПТУ.СсылкаПТУ = &СсылкаПТУ
		|	И СписокТоваровДокументаПТУ.ТоварТребуетсяМаркировка
		|	И СписокТоваровДокументаПТУ.КоличествоТоваровСМаркировкой > СписокТоваровДокументаПТУ.КоличествоВБуфереМаркировок + СписокТоваровДокументаПТУ.КоличествоОтсканированныхМаркировок";
	
	Запрос.УстановитьПараметр("СсылкаПТУ", Объект.ДокументГУИД);
	
	РезультатЗапроса = Запрос.Выполнить();   
	тзОстатокМаркировка.Очистить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		ДобСтрока = тзОстатокМаркировка.Добавить();
		ЗаполнитьЗначенияСвойств(ДобСтрока, Выборка);
		
	КонецЦикла;     
	
	Возврат Истина;
	//-Шульман А. 02.10.2025 #UT10-5438 
	
КонецФункции // ()

&НаСервереБезКонтекста
