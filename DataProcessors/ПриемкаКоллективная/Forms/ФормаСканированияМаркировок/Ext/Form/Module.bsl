&НаКлиенте
Перем Компонента;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначения.УстановитьРежимВыбораДляДокументаРазмещения("ВыборНомеклатурыДляМаркировки");
	ОбщегоНазначения.УстановитьРежимВводаНаСервере(Истина);     
	
	//+Шульман А. 13.11.2025 #UT10-5504
	Объект.ПроверятьСостояниеКодаВЧЗ = Константы.ПроверятьСостояниеКодаВЧЗ.Получить();
	Объект.РазрешитьПриниматьКМБезПроверкиСостояния = Константы.РазрешитьПриниматьКМБезПроверкиСостояния.Получить();
	//-Шульман А. 13.11.2025 #UT10-5504
	
	//+Шульман А. 20.11.2025 #UT10-5518
	Объект.ПроверятьСоответствиеКодаТоваруПоGTIN = Константы.ПроверятьСоответствиеКодаТоваруПоGTIN.Получить();  
	Объект.РасширеннаяПроверкаВалидностиКодовМаркировкиЧЗ = Константы.РасширеннаяПроверкаВалидностиКодовМаркировкиЧЗ.Получить();
	//-Шульман А. 20.11.2025 #UT10-5518 
	
	//+Шульман А. 28.11.2025 #UT10-5550   
	Объект.СверятьКодыСОжидаемымиПриПриемке = Константы.СверятьКодыСОжидаемымиПриПриемке.Получить();   
	//-Шульман А. 28.11.2025 #UT10-5550     
	
	//+Шульман А. 05.12.2025 #UT10-5576
	ЗаписыватьРасширенныеЛоги = Константы.ЗаписыватьРасширенныеЛоги.Получить();
	//-Шульман А. 05.12.2025 #UT10-5576
	
КонецПроцедуры   


&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПараметрыРаботы = ОбщегоНазначения.ПолучитьПараметрыРаботыСДокументомПТУ();	
	ЗаполнитьЗначенияСвойств(Объект, ПараметрыРаботы);

	Компонента = ОбщегоНазначенияКлиент.ПодключитьКомпоненту();	
	
	Если Компонента <> Неопределено И Не Компонента.Подключить() Тогда		
		ТекстОшибки = "";
		КодОшибки = Компонента.ПолучитьОшибку(ТекстОшибки);                                                   
		ПоказатьПредупреждение(,"Ошибка: "+КодОшибки+", " + ТекстОшибки);
	КонецЕсли;	
	
	РезультатСтруктура = ОбщегоНазначения.ПолучитьОстатокПоВсемТоварамИзДокумента(Объект.ДокументГУИД);

	ПоказатьСтраницу_ГруппаСтраницыРаботаСТоваров();
	ОбщегоНазначения.ПолучитьСписокМаркировокПоПТУ(Объект.ДокументГУИД);  
	Элементы.СписокМаркировокВБуфере.Обновить();
	
	Оповестить("ОбновитьГруппуОсталостьИНабрано");

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьСканирование(Команда)
	
	ЭтаФорма.ОписаниеОшибки = "";
	ЭтаФорма.ОписаниеНайденногоТовара =  "";
	ЭтаФорма.Штрихкод = "";
	ЭтаФорма.ЗначениеДляПоиска = "";
	
	
	ОбщегоНазначенияКлиент.ОчиститьПоляНайденныйТовар(ЭтаФорма);	
	ОбщегоНазначения.УстановитьРежимВыбораДляДокументаРазмещения("ВыборНомеклатурыДляМаркировки");		
	ОбщегоНазначения.УстановитьРежимВводаНаСервере(Истина);
	
	ПоказатьСтраницу_ГруппаСтраницыРаботаСТоваров();		
	
	Оповестить("ГруппаПоискаТовара", Истина);
	Оповестить("СканированиеШтрихкода");	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСлуженоеСообщениеПодвал() Экспорт
	
	ЭтаФорма.Подвал.Очистить();	
	СтрокаТЗ = Подвал.Добавить();

	СтрокаТЗ.ФИОСотрудинка = ОбщегоНазначенияКлиент.ПолучитьОписаниеСотрудника();
	СтрокаТЗ.ОписаниеРежимаВводаКоличества = ОбщегоНазначенияКлиент.ПолучитьОтображениеОРежимеВводеКоличества();
	Элементы.Подвал.Обновить();
	
	ЭтаФорма.ПодвалСообщение.Очистить();	
	СтрокаТЗ = ПодвалСообщение.Добавить();	
	СтрокаТЗ.СообщениеДляПользователя = ОбщегоНазначения.ПолучитьИнструкциюДействийДляПользователя(ЭтаФорма.ОписаниеОшибки ,"Обработка.ПриемкаКоллективная.Форма.ФормаСканированияМаркировок");
	Элементы.ПодвалСообщение.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтраницу_ГруппаСтраницыРаботаСТоваров() Экспорт
	
	ОбновитьСлуженоеСообщениеПодвал();
	Элементы.Набрано.Обновить();
	
	Если ЗначениеЗаполнено(ЭтаФорма.ОписаниеОшибки) Тогда
		
		Элементы.ГруппаСтраницыРаботаСТоваров.ТекущаяСтраница = Элементы.ГруппаСтраница_ОшибкаСканирования;
		Элементы.ГруппаСтраница_ОтсутствиеШК_вПоставке.Видимость = Ложь;
		Элементы.ГруппаСтраница_АвтоматическийВвод.Видимость = Ложь;
		Элементы.ГруппаСтраница_ОшибкаСканирования.Видимость = Истина;
		
		Возврат;
		
	КонецЕсли; 
		
	РежимВводаАвтоматический = ОбщегоНазначения.УстановленРежимВводаАвтоматический();	
	
	Если РежимВводаАвтоматический И ОбщегоНазначения.ПолучитьСтатусРаботыСРазмещениемДокумента() <> "ШКнеНайденВПоставке" Тогда
		
		Элементы.ГруппаСтраницыРаботаСТоваров.ТекущаяСтраница = Элементы.ГруппаСтраница_АвтоматическийВвод;
		Элементы.ГруппаСтраница_АвтоматическийВвод.Видимость = Истина;
		Элементы.ГруппаСтраница_ОшибкаСканирования.Видимость = Ложь;
				
	ИначеЕсли ОбщегоНазначения.ПолучитьСтатусРаботыСРазмещениемДокумента() = "ШКнеНайденВПоставке" Тогда
		
		Элементы.ГруппаСтраницыРаботаСТоваров.ТекущаяСтраница = Элементы.ГруппаСтраница_ОтсутствиеШК_вПоставке;		
		Элементы.ГруппаСтраница_ОтсутствиеШК_вПоставке.Видимость = Истина;
		Элементы.ГруппаСтраница_АвтоматическийВвод.Видимость = Ложь;
		Элементы.ГруппаСтраница_ОшибкаСканирования.Видимость = Ложь;
		
	КонецЕсли; 
	
КонецПроцедуры                                                                   

&НаКлиенте
Процедура ВключитьПоискТовара(Команда)
		
	ЭтаФорма.ОписаниеОшибки = "";
	ЭтаФорма.ОписаниеНайденногоТовара =  "";
	ЭтаФорма.Штрихкод = "";
	ЭтаФорма.ЗначениеДляПоиска = "";
	
	ОбщегоНазначенияКлиент.ОчиститьПоляНайденныйТовар(ЭтаФорма);		
	ОбщегоНазначения.УстановитьРежимВыбораДляДокументаРазмещения("ВыборНомеклатурыДляМаркировки");		
	ПоказатьСтраницу_ГруппаСтраницыРаботаСТоваров();	
	Оповестить("ГруппаПоискаТовара", Истина);	
	Оповестить("СканированиеШтрихкода");		
			
КонецПроцедуры

&НаКлиенте
Процедура Поиск(Команда)
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ЗначениеДляПоиска) Тогда
		Сообщить("Введите код производителя или штрихкод.");
		Возврат;
	КонецЕсли; 
	
	ЭтаФорма.Штрихкод = ЭтаФорма.ЗначениеДляПоиска;
	ЭтаФорма.ТоварГУИД = "";
	СтрокаGS = "";
				
	ОбработкаОтсканированногоТовара();
	ЭтаФорма.ЗначениеДляПоиска = "";

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтсканированногоТовара() Экспорт

	Оповестить("ГруппаПоискаТовара", Ложь);	
	
	РежимВводаАвтоматический = ОбщегоНазначения.УстановленРежимВводаАвтоматический();	
	
	Если РежимВводаАвтоматический Тогда
		
		Результат = ОбработкаШтрихкодаАвтоматический.ОбработкаШтрихкодаВАвтоматическомРежиме(ЭтаФорма, "ПоступлениеТоваровУслуг");
		
		Если ЭтаФорма.ОтсканированТовар Тогда
			ОбщегоНазначения.УстановитьРежимВыбораДляДокументаРазмещения("ВыборМаркировки");
		Иначе
			ОбщегоНазначения.УстановитьРежимВыбораДляДокументаРазмещения("ВыборНомеклатурыДляМаркировки");
		КонецЕсли;
		
		ПоказатьСтраницу_ГруппаСтраницыРаботаСТоваров();
		Оповестить("ГруппаПоискаТовара", Ложь);
		
		//+Сёмин Р.И. 28.09.2026 #UT10-6057
		Оповестить("ОбновитьГруппуОсталостьИНабрано");
		//-Сёмин Р.И. 28.09.2026 #UT10-6057
		
	КонецЕсли;
	
	Если Результат = "НеизвестныйШтрихкод" Тогда
		
		Структура = Новый Структура;
		Структура.Вставить("Штрихкод", Штрихкод);                            
		Структура.Вставить("ЭтаФорма", ЭтаФорма);					
		
		
		ОбщегоНазначенияКлиент.ИнициализацияТЗ_Набрано(ЭтаФорма);
		ОбщегоНазначения.УстановитьРежимВыбораДляДокументаРазмещения("ШКнеНайденВПоставке");
		ПоказатьСтраницу_ГруппаСтраницыРаботаСТоваров();		
		
	КонецЕсли;

КонецПроцедуры   
                      
&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	// Пользователь может нажать несколько раз сканирование штрихкода, но форма уже закрыта.
	Если Не ВводДоступен() Тогда   
		Возврат;
	КонецЕсли; 
	
	//+Шульман А. 05.12.2025 #UT10-5576
	Если ИгнорироватьВнешнееСобытие Тогда  
		
		Если ЗаписыватьРасширенныеЛоги Тогда
			ASK_ОбработкаОшибок.ПолучитьСтекВызовов("Форма сканирования. ВнешнееСобытие.", "Возврат", Истина);
		КонецЕсли;       
		
		Возврат;
		
	КонецЕсли;  
	//-Шульман А. 05.12.2025 #UT10-5576
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаОсновная;
	СимволРазделитель = "{GS}";
	
	Если Событие = "UniversalBroadcastEvent" Тогда
		
		
	    //-Шульман А. 05.12.2025 #UT10-5576
		
		Результат = ОбщегоНазначения.ПолучитьЗначениеШтрихкода(Данные, СимволРазделитель);
		
		Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
			
			ПоказатьПредупреждение(, "Ошибка сканирования штрихкода", 4);
			Возврат;
			
		КонецЕсли; 
	
		ЭтаФорма.Штрихкод = Результат.Штрихкод;   
		
		//+Шульман А. 05.12.2025 #UT10-5576   
		СтрокаGS = "";
		
		Если ОбщегоНазначения.ПолучитьКонстанту("РасширеннаяПроверкаВалидностиКодовМаркировкиЧЗ") Тогда
		
			Попытка
				
				СтрокаGS = ОбщегоНазначенияКлиент.ПолучитьПозицииGS(ЭтаФорма.Штрихкод, СимволРазделитель);
				
				Пока НЕ СтрНайти(ЭтаФорма.Штрихкод, СимволРазделитель) = 0 Цикл
					ЭтаФорма.Штрихкод = СтрЗаменить(ЭтаФорма.Штрихкод, СимволРазделитель,"");
				КонецЦикла;
				
			Исключение                                           
				
				ASK_ОбработкаОшибок.ЗаписатьИнформациюВЛогОшибок("Ошибка", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), 
				"Форма сканирования. ВнешнееСобытие", "Поиск GS");   
				Возврат;
				
			КонецПопытки;     
		
		КонецЕсли;
		
		ЭтаФорма.ТоварГУИД = "";                
		
		ОбработкаОтсканированногоТовара();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СканированиеШтрихкода" Тогда
		
		#Если МобильноеПриложениеКлиент Тогда
			Если ЗначениеЗаполнено(ЭтаФорма.ОписаниеОшибки) Тогда
				Компонента.Отключить();
			Иначе
				Компонента.Подключить();
			КонецЕсли; 
		#КонецЕсли 	
		Возврат;		
	КонецЕсли; 
	
	Если ИмяСобытия = "ОбновитьГруппуОсталостьИНабрано" Тогда	
		
		РезультатСтруктура = ОбщегоНазначения.ЗагрузитьСписокДокументовПТУ(, Объект.ДокументГУИД);	
		Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
			ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 3);	
			Возврат;
		КонецЕсли; 
		
		Запись = РезультатСтруктура.Данные[0];
		ЭтаФорма.Шапка.Очистить();
		СтрокаТЗ = Шапка.Добавить();
		СтрокаТЗ.ЗаголовокСкладскогоДокумента = "В работе";
		СтрокаТЗ.НомерСкладскогоДокумента = Объект.НомерСкладскогоДокумента;
		
		//+Сёмин Р.И. 28.09.2026 #UT10-6057
		//ОсталосьМаркировок  = "осталось: " + Строка(Запись.КоличествоТоваровСМаркировкой - Запись.КоличествоОтсканированныхМаркировок);
		ОсталосьМаркировок  = "осталось: " + Строка(Запись.КоличествоТоваровСМаркировкой - (Запись.КоличествоОтсканированныхМаркировок + Запись.КоличествоСтрокВБуфереМаркировок));
		//-Сёмин Р.И. 28.09.2026 #UT10-6057
		
		ВсегоМаркировок     = "из " + Строка(Запись.КоличествоТоваровСМаркировкой)  + " маркировок";
		
		//+Сёмин Р.И. 28.09.2026 #UT10-6057
		//СтрокаТЗ.ОписаниеСтатусаМаркировки = ОсталосьМаркировок + "   " + ВсегоМаркировок;
		СтрокаТЗ.ОписаниеСтатусаМаркировки = ОсталосьМаркировок + " " + ВсегоМаркировок;
		//-Сёмин Р.И. 28.09.2026 #UT10-6057
		
		Возврат;
		
	КонецЕсли;
	
	Если ИмяСобытия = "ГруппаПоискаТовара" Тогда
		
		//Элементы.ГруппаПоискаТовара.Видимость = Параметр;    
		Если ОбщегоНазначения.ПолучитьСтатусРаботыСРазмещениемДокумента() = "ВыборНомеклатурыДляМаркировки" Тогда
			Элементы.ЗначениеДляПоиска.Заголовок = "Товар"; 
		Иначе
			Элементы.ЗначениеДляПоиска.Заголовок = "QR-код";  
		КонецЕсли;
		
		ЭтаФорма.ЗначениеДляПоиска = "";
		Возврат;
		
	КонецЕсли; 
	
КонецПроцедуры

