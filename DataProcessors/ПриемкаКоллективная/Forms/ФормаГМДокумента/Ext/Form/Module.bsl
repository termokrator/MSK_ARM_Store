&НаКлиенте                                                              
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	Если Событие = "UniversalBroadcastEvent" Тогда
		Результат = ОбщегоНазначения.ПолучитьЗначениеШтрихкода(Данные);
		Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
			ПоказатьПредупреждение(, "Ошибка сканирования штрихкода", 4);
		КонецЕсли; 
		Штрихкод = Результат.Штрихкод; 
		// Пользователь может нажать несколько раз сканирование штрихкода, но форма уже закрыта.
		Если ВводДоступен() Тогда
			ОбработкаОтсканированногоТовара();	
		КонецЕсли; 
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция НайтиТоварВДокументеПоКоду(мШтрихКод)
	ГУИДТовара = Неопределено;
	ЗапросТовараВДокументе = Новый Запрос; 
	ЗапросТовараВДокументе.УстановитьПараметр("КодПроизводителяТовара","%"+мШтрихКод+"%");
	ЗапросТовараВДокументе.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СписокТоваровДокументаПТУ.СсылкаТовара КАК СсылкаТовара
	|ИЗ
	|	РегистрСведений.СписокТоваровДокументаПТУ КАК СписокТоваровДокументаПТУ
	|ГДЕ
	|	СписокТоваровДокументаПТУ.КодПроизводителяТовара Подобно &КодПроизводителяТовара";
	РезультатЗапроса = ЗапросТовараВДокументе.Выполнить();
	Если НЕ РезультатЗапроса.Пустой()Тогда
		ГУИДТовара = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("СсылкаТовара");
		//ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		//ВыборкаЗапроса.Следующий();
		//ГУИДТовара = ВыборкаЗапроса.СсылкаТовара;
	КонецЕсли;	
	Возврат ГУИДТовара;	
КонецФункции

&НаКлиенте
Процедура ОбработкаОтсканированногоТовара(ВведеноЗначениеПоиска = Ложь,ТоварИзСпискаНайденных = "",Фильтровать = Истина)
	//// Найти товар по штрихкоду 
	Если ВведеноЗначениеПоиска Тогда
		ШтрихКод = ЭтаФорма.Поиск;
		ЭтаФорма.Поиск = "";
	КонецЕсли;	
	РезультатСтруктура = ОбщегоНазначения.НайтиТоварПоШтрихкодуСОстатками(ШтрихКод, ТоварИзСпискаНайденных);	
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();	
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 4);	
		Штрихкод = "";
		Возврат;
	КонецЕсли;
   	ПромТоварГУИД = Новый Массив;
	Если РезультатСтруктура.Данные.Количество() = 1 Тогда 
		ПромТоварГУИД.Добавить(РезультатСтруктура.Данные[0].Владелец);
		Если Фильтровать Тогда
			ТоварыДокумента.Параметры.УстановитьЗначениеПараметра("ФильтруемПоТовару", Истина);
			ТоварыДокумента.Параметры.УстановитьЗначениеПараметра("СсылкаНаТовар", ПромТоварГУИД); 
		КонецЕсли;
		СписокЯчеекВыбранногоТовара.Параметры.УстановитьЗначениеПараметра("Владелец", ПромТоварГУИД[0]);
	ИначеЕсли РезультатСтруктура.Данные.Количество() > 0 Тогда
		Если  ВведеноЗначениеПоиска Тогда
			ЕстьТовар =  НайтиТоварВДокументеПоКоду(ШтрихКод);
			Если НЕ ЕстьТовар = Неопределено Тогда
				Если Фильтровать Тогда 
					ТоварыДокумента.Параметры.УстановитьЗначениеПараметра("ФильтруемПоТовару", Истина);
					ТоварыДокумента.Параметры.УстановитьЗначениеПараметра("СсылкаНаТовар", ЕстьТовар); 
				КонецЕсли;
				СписокЯчеекВыбранногоТовара.Параметры.УстановитьЗначениеПараметра("Владелец", ЕстьТовар[0]);
			Иначе
				ПромТоварГУИД.Добавить(РезультатСтруктура.Данные[0].Владелец);
				Если Фильтровать Тогда
				ТоварыДокумента.Параметры.УстановитьЗначениеПараметра("ФильтруемПоТовару", Истина);
					ТоварыДокумента.Параметры.УстановитьЗначениеПараметра("СсылкаНаТовар", ПромТоварГУИД); 
				КонецЕсли;
				СписокЯчеекВыбранногоТовара.Параметры.УстановитьЗначениеПараметра("Владелец", ПромТоварГУИД[0]);
			КонецЕсли;
		Иначе
			ПромТоварГУИД.Добавить(РезультатСтруктура.Данные[0].Владелец);
			Если Фильтровать Тогда 
				ТоварыДокумента.Параметры.УстановитьЗначениеПараметра("ФильтруемПоТовару", Истина); 
				ТоварыДокумента.Параметры.УстановитьЗначениеПараметра("СсылкаНаТовар", ПромТоварГУИД); 
			КонецЕсли;
			СписокЯчеекВыбранногоТовара.Параметры.УстановитьЗначениеПараметра("Владелец", ПромТоварГУИД[0]);
		КонецЕсли;
	КонецЕсли; 
КонецПроцедуры

