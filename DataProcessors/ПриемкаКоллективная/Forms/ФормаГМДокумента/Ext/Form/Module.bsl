&НаКлиенте
Перем ШтрихКод; 

&НаКлиенте
Процедура ПоказатьРазмещенные(Команда)
	РазмещенныеТоварыПоказаны = Истина;
	ПоказатьПунктМенюРазмещенныеСтроки();
КонецПроцедуры

&НаКлиенте
Процедура СкрыватьРазмещенные(Команда)	
	РазмещенныеТоварыПоказаны = Ложь;
	ПоказатьПунктМенюРазмещенныеСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПунктМенюРазмещенныеСтроки()
	
	Если РазмещенныеТоварыПоказаны = Ложь Тогда
		Элементы.МенюПоказатьРазмещенные.Видимость  = Истина;
		Элементы.МенюСкрыватьРазмещенные.Видимость = Ложь;
		ТоварыДокумента.Параметры.УстановитьЗначениеПараметра("ПоказыватьРазмещенные", Ложь);
	Иначе
		Элементы.МенюПоказатьРазмещенные.Видимость  = Ложь;
		Элементы.МенюСкрыватьРазмещенные.Видимость = Истина;		
		ТоварыДокумента.Параметры.УстановитьЗначениеПараметра("ПоказыватьРазмещенные", Истина);
	КонецЕсли; 

	Элементы.ТоварыДокумента.Обновить();	
	
КонецПроцедуры
 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПараметрыРаботы = ОбщегоНазначения.ПолучитьПараметрыРаботыСДокументомПТУ();	
	ЗаполнитьЗначенияСвойств(Объект, ПараметрыРаботы);	
	
	РезультатСтруктура = ОбщегоНазначения.ЗагрузитьСписокДокументовПТУ(, Объект.ДокументГУИД);	
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 3);	
		Возврат;
	КонецЕсли; 
	
	Запись = РезультатСтруктура.Данные[0];
	ЭтаФорма.Шапка.Очистить();
	СтрокаТЗ = Шапка.Добавить();
	СтрокаТЗ.ЗаголовокСкладскогоДокумента = "В работе";
	СтрокаТЗ.НомерСкладскогоДокумента = Объект.НомерСкладскогоДокумента;
	
	ОсталосьЗначение = Строка(Запись.КоличествоТовараОсталостьРазместить);
	СтрокаТЗ.ОписаниеСтатусаДокумента = "не размещено: " + Строка(Запись.КоличествоОсталостьРазместитьСтрокГМ) + " грузомест";
	
	РазмещенныеТоварыПоказаны = Ложь;
	ПоказатьПунктМенюРазмещенныеСтроки();
	
	ТоварыДокумента.Параметры.УстановитьЗначениеПараметра("СсылкаПТУ", Параметры.ДокументГУИД);
	
	//Элементы.ТоварыДокумента.КонтекстноеМеню.ТоварыДокументаКонтекстноеМенюВыбратьДляРазмещения
	
	ОбщегоНазначенияКлиент.ЗаполнитьТабЗначОК(ЭтаФорма);		
	ОбновитьСлуженоеСообщениеПодвал();
	
	Если Параметры.СобытиеПрисвоитьШтрихкод = Истина Тогда
		
		Элементы.ТоварыДокумента.КонтекстноеМеню.ПодчиненныеЭлементы.ТоварыДокументаКонтекстноеМенюВыбратьДляПрисвоенияШК.Видимость = Истина;
		Элементы.ТоварыДокумента.КонтекстноеМеню.ПодчиненныеЭлементы.ТоварыДокументаКонтекстноеМенюВыбратьДляРазмещения.Видимость = Ложь;
		
	Иначе 
		
		Элементы.ТоварыДокумента.КонтекстноеМеню.ПодчиненныеЭлементы.ТоварыДокументаКонтекстноеМенюВыбратьДляПрисвоенияШК.Видимость = Ложь;
		Элементы.ТоварыДокумента.КонтекстноеМеню.ПодчиненныеЭлементы.ТоварыДокументаКонтекстноеМенюВыбратьДляРазмещения.Видимость = Истина;
		
	КонецЕсли;
	СписокЯчеекВыбранногоТовара.Параметры.УстановитьЗначениеПараметра("Владелец", "");	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСлуженоеСообщениеПодвал() Экспорт
	
	ЭтаФорма.Подвал.Очистить();	
	СтрокаТЗ = Подвал.Добавить();
	СтрокаТЗ.ФИОСотрудника = ОбщегоНазначенияКлиент.ПолучитьОписаниеСотрудника();
	Элементы.Подвал.Обновить();
	
	ЭтаФорма.ПодвалСообщение.Очистить();	
	СтрокаТЗ = ПодвалСообщение.Добавить();	
	СтрокаТЗ.СообщениеДляПользователя = ОбщегоНазначения.ПолучитьИнструкциюДействийДляПользователя("", ЭтаФорма.ИмяФормы);
	Элементы.ПодвалСообщение.Обновить();
	
КонецПроцедуры


&НаКлиенте
Процедура ВыбратьДляРазмещения(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ЯчейкаПриемкиГУИД) Тогда
		ПоказатьПредупреждение(,"Ошибка: сначала выберите ячейку приемки !!!" , 3);	
		Возврат
	КонецЕсли; 
	
	
	ТоварГУИД  = Элементы.ТоварыДокумента.ТекущиеДанные.СсылкаТовара;
	СписокПараметров = Новый Структура;
	СписокПараметров.Вставить("ТоварГУИД", ТоварГУИД);
	Закрыть( СписокПараметров );
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьДляПрисвоенияШК(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ЯчейкаПриемкиГУИД) Тогда
		ПоказатьПредупреждение(,"Ошибка: сначала выберите ячейку приемки !!!" , 3);	
		Возврат
	КонецЕсли; 
	
	
	ТоварГУИД  = Элементы.ТоварыДокумента.ТекущиеДанные.СсылкаТовара;
	СписокПараметров = Новый Структура;
	СписокПараметров.Вставить("ТоварГУИД", ТоварГУИД);
	СписокПараметров.Вставить("СобытиеПрисвоитьШтрихкод", Истина);
	Закрыть( СписокПараметров );

	
КонецПроцедуры

