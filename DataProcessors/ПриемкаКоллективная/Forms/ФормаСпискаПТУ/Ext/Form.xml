		<Attribute name="СписокПТУ" id="2">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Список ПТУ</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<UseAlways>
				<Field>~СписокПТУ.ДокументПТУ</Field>
				<Field>~СписокПТУ.КоличествоМаркировокТоваров</Field>
				<Field>~СписокПТУ.КоличествоОтсканированныхМаркировки</Field>
				<Field>~СписокПТУ.КоличествоСтрок</Field>
				<Field>~СписокПТУ.КоличествоСтрокКодовМаркировки</Field>
				<Field>~СписокПТУ.КоличествоСтрокОтсканированноКодовМаркировки</Field>
				<Field>СписокПТУ.DefaultPicture</Field>
				<Field>СписокПТУ.ДатаДокумента</Field>
				<Field>СписокПТУ.ДокументТребуетсяМаркировка</Field>
				<Field>СписокПТУ.ЕстьСтрокиВБуфереКладовщика</Field>
				<Field>СписокПТУ.ЕстьСтрокиВБуфереМаркировок</Field>
				<Field>СписокПТУ.Количество</Field>
				<Field>СписокПТУ.КоличествоОжидаемыхМаркировок</Field>
				<Field>СписокПТУ.КоличествоОтсканированныхМаркировок</Field>
				<Field>СписокПТУ.КоличествоТоваровСМаркировкой</Field>
				<Field>СписокПТУ.КомментарийКСтатусу</Field>
				<Field>СписокПТУ.НомерДокумента</Field>
				<Field>СписокПТУ.НомерДокументаОформление</Field>
				<Field>СписокПТУ.НомерСкладскогоДокумента</Field>
				<Field>СписокПТУ.ПараметрСортировки</Field>
				<Field>СписокПТУ.Ссылка</Field>
				<Field>СписокПТУ.Статус</Field>
				<Field>СписокПТУ.СтатусОформление</Field>
				<Field>СписокПТУ.СтатусЧЗ</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ВЫБОР
		КОГДА СписокДокументовПТУ.КоличествоСтрокВБуфереСотрудника &gt; 0
			ТОГДА СписокДокументовПТУ.ПараметрСортировкиБуфер
		КОГДА СписокДокументовПТУ.КоличествоСтрокВБуфереСотрудника = 0
				И СписокДокументовПТУ.КоличествоСтрокВБуфереВсего &gt; 0
			ТОГДА СписокДокументовПТУ.ПараметрСортировкиРазмещения
		ИНАЧЕ СписокДокументовПТУ.ПараметрСортировкиДокумент
	КОНЕЦ КАК ПараметрСортировки,
	ВЫБОР
		КОГДА СписокДокументовПТУ.КоличествоСтрокВБуфереСотрудника &gt; 0
			ТОГДА СписокДокументовПТУ.СтрокНеРазмещеноСТР
		КОГДА СписокДокументовПТУ.КоличествоСтрокВБуфереСотрудника = 0
				И СписокДокументовПТУ.КоличествоСтрокВБуфереВсего &gt; 0
			ТОГДА СписокДокументовПТУ.ОсталосьРазместитьСТР
		ИНАЧЕ СписокДокументовПТУ.ВсегоСтрокСТР
	КОНЕЦ КАК Количество,
	СписокДокументовПТУ.НомерДокумента КАК НомерДокумента,
	НАЧАЛОПЕРИОДА(СписокДокументовПТУ.ДатаДокумента, ДЕНЬ) КАК ДатаДокумента,
	СписокДокументовПТУ.НомерСкладскогоДокумента КАК НомерСкладскогоДокумента,
	ВЫБОР
		КОГДА СписокДокументовПТУ.КоличествоСтрокВБуфереСотрудника &gt; 0
			ТОГДА "Размещение не завершено"
		КОГДА СписокДокументовПТУ.КоличествоСтрокВБуфереСотрудника = 0
				И СписокДокументовПТУ.КоличествоСтрокВБуфереВсего &gt; 0
			ТОГДА "В работе"
