&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПТУПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Ключи = Строки.ПолучитьКлючи();
	Для Индекс = 0  По Ключи.Количество()-1 Цикл

		СтрокаСписка = Строки[Ключи[Индекс]];
	
		//СтрокаСписка.Данные["НомерДокументаОформление"] = СтрокаСписка.Данные["НомерДокумента"] + " от " 
		//	+ СТРОКА(Формат(СтрокаСписка.Данные["ДатаДокумента"], "ДФ=dd.MM.yyyy")) + "г.";
			
		Если СтрокаСписка.Данные["Статус"] = "Не начат" Тогда	
			
			СтрокаСписка.Оформление["Статус"].УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.ТемноЗеленый);
			
		ИначеЕсли СтрокаСписка.Данные["Статус"] = "В работе" Тогда						
			
			СтрокаСписка.Оформление["Статус"].УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.ТемноОранжевый);				
			
		ИначеЕсли СтрокаСписка.Данные["Статус"] = "Размещение не завершено" Тогда									
			
			СтрокаСписка.Оформление["Статус"].УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);							
			
		КонецЕсли; 
			
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗначениеДляПоискаПриИзмененииНаСервере(ЗначениеДляПоиска)

	СписокПТУ.Параметры.УстановитьЗначениеПараметра("НомерДокумента", "%"+ЗначениеДляПоиска+"%");
	СписокПТУ.Параметры.УстановитьЗначениеПараметра("ИспользоватьПоиск", Истина);

КонецПроцедуры

&НаКлиенте
Процедура Поиск(Команда)
	
	ЗначениеДляПоискаПриИзмененииНаСервере(ЭтаФорма.ЗначениеДляПоиска);
	Оповестить("ОбновлениеДанных");	                                   

КонецПроцедуры

&НаКлиенте
Процедура КнТЕНажатие(Команда)
	
	//+Сёмин Р. 24.12.2025 #UT10-5593
	ФормаТранспортныеЕдиницы = ПолучитьФорму("Обработка.ТранспортныеЕдиницы.Форма.ФормаТранспортныхЕдиниц", Новый Структура("ИсключаемыеСтатусы", "В пути"), ЭтаФорма);
	ФормаТранспортныеЕдиницы.Открыть();
	//-Сёмин Р. 24.12.2025 #UT10-5593
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПТУНаПроверкеВЧЗ(Команда)
	
	Элементы.ПроверкаВЧЗ.Пометка = НЕ Элементы.ПроверкаВЧЗ.Пометка;
	
	УстановитьОформлениеКнопок();

	Если Элементы.ПроверкаВЧЗ.Пометка Тогда
		
		РезультатСтруктура = ОбщегоНазначения.ЗагрузитьСписокДокументовПТУ_ЧЗ();	
		
		Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
			
			ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 3);	
			Возврат;
			
		КонецЕсли; 
		
		Если РезультатСтруктура.Результат Тогда
			
			СписокПТУ.Параметры.УстановитьЗначениеПараметра("ИспользоватьПоиск", Ложь);
			СписокПТУ.Параметры.УстановитьЗначениеПараметра("НомерДокумента", "");
			
			Оповестить("ОбновлениеДанных");
			
		КонецЕсли;         
		
	Иначе 
		
		ПолучитьДокументыПТУ(Неопределено);
		
	КонецЕсли;
		
КонецПроцедуры 

