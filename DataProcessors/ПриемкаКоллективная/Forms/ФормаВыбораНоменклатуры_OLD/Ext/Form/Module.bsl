
&НаКлиенте
Перем Компонента;
&НаКлиенте
Перем РежимВводаАвтоматический;
&НаКлиенте
Перем Ошибка;


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

КонецПроцедуры


&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Если ЗначениеЗаполнено(ЭтаФорма.ОписаниеОшибки) Тогда
		Элементы.ГруппаПоиска.Видимость = Ложь;
		Элементы.ГруппаОписаниеОшибки.Видимость = Истина;
	Иначе 
		Элементы.ГруппаОписаниеОшибки.Видимость = Ложь;
		Элементы.ГруппаПоиска.Видимость = Истина;
	КонецЕсли; 

КонецПроцедуры
 
 
&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	ПараметрыРаботы = ОбщегоНазначения.ПолучитьПараметрыРаботыСДокументомПТУ();	
	ЗаполнитьЗначенияСвойств(Объект, ПараметрыРаботы);
		
	Компонента = ОбщегоНазначенияКлиент.ПодключитьКомпоненту();	
	
	Если Компонента <> Неопределено И Не Компонента.Подключить() Тогда		
		ТекстОшибки = "";
		КодОшибки = Компонента.ПолучитьОшибку(ТекстОшибки);                                                   
		ПоказатьПредупреждение(,"Ошибка: "+КодОшибки+", " + ТекстОшибки);
	КонецЕсли;

	РежимВводаАвтоматический = ОбщегоНазначения.УстановленРежимВводаАвтоматический();
	Оповестить("ОбновитьОписаниеПодвала");
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если Не ВводДоступен() Тогда
		Возврат;
	КонецЕсли; 
	
	Если Событие = "UniversalBroadcastEvent" Тогда
		
		Результат = ОбщегоНазначения.ПолучитьЗначениеШтрихкода(Данные);
		Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
			ПоказатьПредупреждение(, "Ошибка сканирования штрихкода", 4);
			Возврат;
		КонецЕсли; 
		
		ЭтаФорма.Штрихкод = Результат.Штрихкод;		
		Проверка = ОбщегоНазначенияКлиент.СканированныйШтрихкодЯвляетсяЯчейкой(ЭтаФорма.Штрихкод, Объект.ЯчейкаПриемки);
		Если Проверка Тогда
			
			ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлЯчейки();
			Закрыть();
			
			ПараметрыРаботы	= ОбщегоНазначенияКлиент.СформироватьПараметрыДляФормы("ПриемкаКоллективная", Объект);
			ПараметрыРаботы.Вставить("ЯчейкаПриемки", "");
			ПараметрыРаботы.Вставить("ЯчейкаПриемкиГУИД", "");		
			ОбщегоНазначения.ЗаписатьПараметрыРаботы( "ПараметрыРаботыСДокументомПТУ", ПараметрыРаботы );			
				
			ОткрытьФорму("Обработка.ПриемкаКоллективная.Форма.ФормаВыбораЯчейки_OLD");
			Возврат;
			
		КонецЕсли; 
		
		ОчиститьЭлементыФормы();		
		УстановитьВидимостьЭлементов();
		ОбработкаОтсканированногоТовара();
		                                                              
	ИначеЕсли Событие = "ClipboardEvent" Тогда
		ЭтаФорма.Штрихкод = Данные;
		УстановитьВидимостьЭлементов();
		ОчиститьЭлементыФормы();				
		ОбработкаОтсканированногоТовара();
	КонецЕсли;
		                                                       
КонецПроцедуры

 

&НаКлиенте
Процедура ОбработкаОтсканированногоТовара()
		
	Если РежимВводаАвтоматический Тогда
		Результат = ОбработкаШтрихкодаАвтоматический.ОбработкаШтрихкодаВАвтоматическомРежиме(ЭтаФорма, "ПоступлениеТоваровУслуг");
	Иначе 
		Результат = ОбработкаШтрихкодаРучной.ОбработкаШтрихкодаВРучномРежиме(ЭтаФорма, "ПоступлениеТоваровУслуг");
	КонецЕсли; 	
	
	Если Результат = "КоличествоТовараБольшеОдного" Тогда
		
		ИнформацияОТоваре = ОбщегоНазначенияКлиент.ПолучитьОписаниеТовара(ЭтаФорма.НайденныйТовар);
		Ошибка = "Количество найденных записей по данному штрихкоду " + Штрихкод +  " больше одной !!!";	
		ОбщегоНазначенияКлиент.ОтобразитьИнформациюОТоваре( ИнформацияОТоваре, Ошибка, ЭтаФорма);                                         
		
	ИначеЕсли Результат = "НеизвестныйШтрихкод" Тогда
		
		Структура = Новый Структура;
		Структура.Вставить("Штрихкод", Штрихкод);                            
		Структура.Вставить("ЭтаФорма", ЭтаФорма);					
		// В методе ДиалогНеизвестныйШтрихкод используются "Показать предупреждения"
		ПрисвоитьШтрихкод.ДиалогНеизвестныйШтрихкод(Структура);				
	КонецЕсли; 
	
КонецПроцедуры
 

&НаКлиенте                                                                           
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если Компонента <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(ЭтаФорма.ОписаниеОшибки) Тогда
			Компонента.Отключить();
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура УстановитьРежимВвода(Команда)
	
	ОбщегоНазначения.УстановитьРежимВводаНаСервере();
	РежимВводаАвтоматический = ОбщегоНазначения.УстановленРежимВводаАвтоматический();
			
	Оповестить("ОбновитьОписаниеПодвала");
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////		
	Если ИмяСобытия = "СканированиеШтрихкода" Тогда
		
		#Если МобильноеПриложениеКлиент Тогда
		Если ЗначениеЗаполнено(ЭтаФорма.ОписаниеОшибки) Тогда
			Компонента.Отключить();
		Иначе
			Компонента.Подключить();
		КонецЕсли; 
		#КонецЕсли 	
		
		УстановитьВидимостьЭлементов();		
		
	КонецЕсли; 
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////	
	Если ИмяСобытия = "ОбновитьОписаниеПодвала" Тогда
		ЭтаФорма.ОписаниеРежимВводаКоличества = ОбщегоНазначенияКлиент.ПолучитьОтображениеОРежимеВводеКоличества();
		ЭтаФорма.ОписаниеСотрудника = ОбщегоНазначенияКлиент.ПолучитьОписаниеСотрудника();
	КонецЕсли; 
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////		
	Если ИмяСобытия = "ОбработатьДобавленныйШтрихкод" Тогда	
		
		Если РежимВводаАвтоматический Тогда
			Результат = ОбработкаШтрихкодаАвтоматический.ОбработкаШтрихкодаВАвтоматическомРежиме(ЭтаФорма, "ПоступлениеТоваровУслуг");
		Иначе 
			Результат = ОбработкаШтрихкодаРучной.ОбработкаШтрихкодаВРучномРежиме(ЭтаФорма, "ПоступлениеТоваровУслуг");
		КонецЕсли; 	
		
	КонецЕсли; 
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////	

КонецПроцедуры

&НаКлиенте
Процедура Ок(Команда)
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Поиск) Тогда
		Сообщить("Введите код или штрихкод.");
		Возврат;
	КонецЕсли; 
		
	ЭтаФорма.Штрихкод = ЭтаФорма.Поиск;
	
	Проверка = ОбщегоНазначенияКлиент.СканированныйШтрихкодЯвляетсяЯчейкой(ЭтаФорма.Штрихкод, Объект.ЯчейкаПриемки);
	Если Проверка Тогда
		
		// Используеся при завершении работы, т.к кнопка завершить находится в форме выборка ячейки
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлЯчейки();         
		Закрыть();
		
		ПараметрыРаботы	= ОбщегоНазначенияКлиент.СформироватьПараметрыДляФормы("ПриемкаКоллективная", Объект);
		ПараметрыРаботы.Вставить("ЯчейкаПриемки", "");
		ПараметрыРаботы.Вставить("ЯчейкаПриемкиГУИД", "");		
		ОбщегоНазначения.ЗаписатьПараметрыРаботы( "ПараметрыРаботыСДокументомПТУ", ПараметрыРаботы );			
		
		ОткрытьФорму("Обработка.ПриемкаКоллективная.Форма.ФормаВыбораЯчейки_OLD");
		
	Иначе
		
		ОчиститьЭлементыФормы();
		ОбработкаОтсканированногоТовара();			
				
	КонецЕсли; 
		
КонецПроцедуры


&НаКлиенте
Процедура ПродолжитьСканирование(Команда)
	
	ЭтаФорма.ОписаниеОшибки = "";
	ЭтаФорма.ОписаниеНайденногоТовара =  "";
	ЭтаФорма.Штрихкод = "";
	ЭтаФорма.Поиск = "";
	
	Оповестить("СканированиеШтрихкода");	
	
КонецПроцедуры

// Вызов формы товары документа
&НаКлиенте                                        
Процедура ТоварыДокумента(Команда)
		
	ЭтаФорма.Поиск = "";
	ЭтаФорма.Штрихкод = "";
	ЭтаФорма.ОписаниеНайденногоТовара =  "";	
	ЭтаФорма.ОписаниеОшибки = "";
		
	Оповестить("СканированиеШтрихкода");	
	
	РезультатСтруктура = ОбщегоНазначения.ПолучитьОстатокПоВсемТоварамИзДокумента(Объект.ДокументГУИД);
	
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 3);	
		Возврат;
	КонецЕсли; 
			
	Оповещение = Новый ОписаниеОповещения("ПолучениеДанныхПриЗакрытииФормыТоварыДокумента", ЭтаФорма);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДокументГУИД", Объект.ДокументГУИД);
	ИмяФормыВычисл = ПолучитьПолноеИмяФормы("ФормаТоварыДокумента");
	ОткрытьФорму(ИмяФормыВычисл, ПараметрыФормы, ЭтаФорма,,, , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры


&НаКлиенте
Процедура ПолучениеДанныхПриЗакрытииФормыТоварыДокумента(Результат, ДополнительныеПараметры) Экспорт
		
	Если Результат <> Неопределено Тогда
		
		ЭтаФорма.ТоварГУИД = Результат.ТоварГУИД;
		ОбработкаОтсканированногоТовара();	
		
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Функция ОчиститьЭлементыФормы()
	
	ЭтаФорма.ТоварГУИД = "";
	ЭтаФорма.ОписаниеНайденногоТовара = "";
	ЭтаФорма.Поиск = "";
	ЭтаФорма.ОписаниеОшибки = "";	
	
КонецФункции
 
Функция ПолучитьПолноеИмяФормы(ИмяФормы) 

Возврат Лев(ЭтаФорма.ИмяФормы, Найти(ЭтаФорма.ИмяФормы,".Форма.")+6) + ИмяФормы; 

КонецФункции

&НаКлиенте
Процедура Внести(Команда)
	
	ОбработкаШтрихкодаРучной.ОбработатьВведеноеКоличествоТовара(ЭтаФорма, "ПоступлениеТоваровУслуг");
	
КонецПроцедуры


&НаКлиенте
Процедура Завершить(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("СоздатьДокументРазмещения", ЭтотОбъект, Параметры);
	ТекстВопроса = "Создать документ размещения " + Символы.ПС;
	ТекстВопроса = ТекстВопроса + " товаров по местам хранения ?";
	ПоказатьВопрос(Оповещение, ТекстВопроса, Режим); 
		
КонецПроцедуры


&НаКлиенте
Процедура СоздатьДокументРазмещения(Результат, Параметры) Экспорт
		
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;	
	
	РезультатСтруктура = ОбщегоНазначения.СоздатьДокуметРазмещенияПоЯчейкам(Объект.ДокументГУИД);
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 4);	
		Возврат;
	КонецЕсли; 
	
	ТекстСообщения = "Создан документ размещения по ячейкам № %1 %2. Документ проведен";
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
			РезультатСтруктура.Данные.НомерДокумента,
			РезультатСтруктура.Данные.ДатаДокумента 
			);						
			
	Оповещение = Новый ОписаниеОповещения("ЗакрытьФормуПослеСообщения", ЭтотОбъект, Параметры);
	ПоказатьПредупреждение(Оповещение, ТекстСообщения, 4);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуПослеСообщения(Результат) Экспорт 
	Закрыть();
КонецПроцедуры


&НаКлиенте
Процедура ПланФакт(Команда)
	РезультатСтруктура = ОбщегоНазначения.ПолучитьОстатокПоВсемТоварамИзДокумента(Объект.ДокументГУИД);
	
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 3);	
		Возврат;
	КонецЕсли; 
			                                  
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДокументГУИД", Объект.ДокументГУИД);
	ИмяФормыВычисл = ПолучитьПолноеИмяФормы("ФормаТоварыПланФакт");
	ОткрытьФорму(ИмяФормыВычисл, ПараметрыФормы, ЭтаФорма,,, , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

