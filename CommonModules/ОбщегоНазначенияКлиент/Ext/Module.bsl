КонецФункции


// Проверяет наличие реквизита или свойства у произвольного объекта без обращения к метаданным.
//
// Параметры:
//  Объект       - Произвольный - объект, у которого нужно проверить наличие реквизита или свойства;
//  ИмяРеквизита - Строка       - имя реквизита или свойства.
//
// Возвращаемое значение:
//  Булево - Истина, если есть.
//
Функция ЕстьРеквизитИлиСвойствоОбъекта(Объект, ИмяРеквизита) Экспорт
    
    КлючУникальности   = Новый УникальныйИдентификатор;
    СтруктураРеквизита = Новый Структура(ИмяРеквизита, КлючУникальности);
    ЗаполнитьЗначенияСвойств(СтруктураРеквизита, Объект);
    
    Возврат СтруктураРеквизита[ИмяРеквизита] <> КлючУникальности;
    
КонецФункции


Функция ПолучитьПозицииGS_Тест(Знач ПромШтрихКод) Экспорт        
	
	// На выходе - массив с номерами позиций GS 
	СтрокаGS = "";
	
	// Добавление символов 29 для теста  
	Если (Лев(ПромШтрихКод , 2) = "01" И Сред(ПромШтрихКод,17,2) = "21") Или (Лев(ПромШтрихКод , 4) = "(01)" И Сред(ПромШтрихКод,19,4) = "(21)") Тогда
		
		//+Сёмин Р.И. 29.04.2026 #UT10-5814
		//для теста код должен быть в формате
		//01(GTIN)21(SERIAL)<GS>91(4CHARS)<GS>92(44CHARS)
		//или
		//01(GTIN)21(SERIAL)<GS>93(4CHARS)
		Поз1 = СтрНайти(ПромШтрихКод, "<GS>");
		Поз2 = СтрНайти(ПромШтрихКод, "<GS>", , Поз1 + 1) - 4; //т.к. эти символы надо убрать, и в итоге позиция второго сместится на длину первой убранной группы символов, т.е. на 4 штуки
		//-Сёмин Р.И. 29.04.2026 #UT10-5814
		
		Если Лев(ПромШтрихКод , 2) = "01" Тогда
			
			//+Сёмин Р.И. 29.04.2026 #UT10-5814
			//Поз1 = 32;
			//Поз2 = 38;
			//-Сёмин Р.И. 29.04.2026 #UT10-5814
			
			ЭтоКод93 = Сред(ПромШтрихКод, Поз1, 2) = "93";
			
		Иначе 
			
			//+Сёмин Р.И. 29.04.2026 #UT10-5814
			//Поз1 = 36;
			//Поз2 = 44;
			//-Сёмин Р.И. 29.04.2026 #UT10-5814
			
			ЭтоКод93 = Сред(ПромШтрихКод, Поз1, 4) = "(93)";

		КонецЕсли; 
		
		СтрокаGS = Строка(Поз1) + ?(ЭтоКод93, "", ";" + Строка(Поз2));
		
		ASK_ОбработкаОшибок.ЗаписатьИнформациюВЛогОшибок("Найдена позиция GS", СтрокаGS, "ПолучитьПозицииGS_Тест", "Поиск позиций GS");   
		
	Иначе            
		
		ASK_ОбработкаОшибок.ЗаписатьИнформациюВЛогОшибок("", ПромШтрихКод, "ПолучитьПозицииGS_Тест", "Не найдены 01 и 21");   
		
	КонецЕсли;
	
	Возврат СтрокаGS;   

КонецФункции // ()   

Функция ПолучитьПозицииGS(Знач ДанныеXML, СимволРазделитель) Экспорт        
	
	СтрокаGS = "";
	
	Если СтрНайти(ДанныеXML, СимволРазделитель) = 0 Тогда
		
		ASK_ОбработкаОшибок.ЗаписатьИнформациюВЛогОшибок("", "Символов GS нет", "ПолучитьПозицииGS", "Проверка на наличие GS");   
		Возврат СтрокаGS;
		
	КонецЕсли;  
	
	// Получение позиций GS в массив
	Поз = СтрНайти(ДанныеXML, СимволРазделитель);
	
	Пока Поз > 0 Цикл
		
		ASK_ОбработкаОшибок.ЗаписатьИнформациюВЛогОшибок("Найдена позиция GS", Строка(Поз), "ПолучитьПозицииGS", "Поиск позиций GS");   
		
		СтрокаGS = СтрокаGS + ?(ПустаяСтрока(СтрокаGS), "", ";") + Строка(Поз);        
		ДанныеXML = Лев(ДанныеXML, Поз - 1) + Сред(ДанныеXML, Поз + 4);
		
		Поз = СтрНайти(ДанныеXML, СимволРазделитель);
	
	КонецЦикла;     
	
	ASK_ОбработкаОшибок.ЗаписатьИнформациюВЛогОшибок("", ДанныеXML, "ПолучитьПозицииGS", "Получен штрихкод без GS из шк");   
	
	Возврат СтрокаGS;

КонецФункции // ()   










