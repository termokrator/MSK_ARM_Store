&НаКлиенте                                                                             
Процедура ОтобразитьИнформациюОТоваре(ИнформацияОТоваре, Ошибка, ЭтаФорма) Экспорт
	
	ОчиститьПоляНайденныйТовар(ЭтаФорма);		
	ЭтаФорма.ОписаниеНайденногоТовара = ИнформацияОТоваре;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		
		ЭтаФорма.ОписаниеОшибки = Ошибка;
		Оповестить("СканированиеШтрихкода");
		Возврат;                                                                        
		
	КонецЕсли;                                                                
			
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоляНайденныйТовар(ЭтаФорма) Экспорт
	                                                               
	Если ЭтаФорма.ИмяФормы = "Обработка.ПриемкаКоллективная.Форма.ФормаРазмещениеТовара" Тогда
		ЭтаФорма.Набрано.Очистить();
	КонецЕсли;  

	Если ЭтаФорма.ИмяФормы = "Обработка.ПеремещениеТовараИзЯчейки.Форма.ФормаПеремещениеНоменклатуры" Тогда
		ЭтаФорма.Набрано.Очистить();
	КонецЕсли;                                                                                     
	
	Если ЭтаФорма.ИмяФормы = "Обработка.ИнвентаризацияПоЯчейкам.Форма.ФормаРаботыСЗаданиемНаИнвентаризацию" Тогда
		ЭтаФорма.Набрано.Очистить();
	КонецЕсли; 
	
	Если ЭтаФорма.ИмяФормы = "Обработка.ПриемкаКоллективная.Форма.ФормаРазмещениеГМ" Тогда
		ЭтаФорма.Набрано.Очистить();
	КонецЕсли; 
	
	//+Кабанов А.В. 04.09.2025 # UT10-5361	
	Если ЭтаФорма.ИмяФормы = "Обработка.ПриемкаКоллективная.Форма.ФормаСканированияМаркировок" Тогда
		ЭтаФорма.Набрано.Очистить();
	КонецЕсли; 
	//+Кабанов А.В. 04.09.2025 # UT10-5361	
	
КонецПроцедуры
 
&НаКлиенте
Процедура ИнициализацияТЗ_Набрано(ЭтаФорма) Экспорт
	
	ЭтаФорма.Набрано.Очистить();
	НоваяСтрока = ЭтаФорма.Набрано.Добавить();
	
	Если ЭтаФорма.ИмяФормы = "Обработка.ПогрузкаВАвто.Форма.ФормаГрузовогоМеста" Или 
		 ЭтаФорма.ИмяФормы = "Обработка.РазгрузкаАвто.Форма.ФормаГрузовогоМеста" Или 
		 ЭтаФорма.ИмяФормы = "Обработка.ПриемкаГрузовыхМестИзРазгрузкиАвто.Форма.ФормаГрузовогоМеста" Тогда
		
		НоваяСтрока.Заголовок = "Место:";
		Возврат;
		
	КонецЕсли; 
		
	ТекстСообщения = "Отсканированный штрихкод " + ЭтаФорма.Штрихкод + " не найден в поставке!";
	НоваяСтрока.СообщениеШКнеНайденВПоставке = ТекстСообщения;
	
	ТекстСообщения = "Отсканированный штрихкод " + ЭтаФорма.Штрихкод + " не найден в ячейке!";
	НоваяСтрока.СообщениеШКнеНайденВЯчейке = ТекстСообщения;
	
	НоваяСтрока.Заголовок = "Товар:";
	
КонецПроцедуры


&НаКлиенте                                                                             
Процедура ОтобразитьИнформациюОТоваре_Структура(ИнформацияОТоваре, Ошибка, ЭтаФорма) Экспорт
	
	ЭтаФорма.ОписаниеНайденногоТовара = "";
	Если ЗначениеЗаполнено(Ошибка) Тогда
		
		ЭтаФорма.ОписаниеОшибки = Ошибка;
		Оповестить("СканированиеШтрихкода");
		//Возврат;
		
	КонецЕсли;                                                                
	
	ИнициализацияТЗ_Набрано(ЭтаФорма);
	
	НоваяСтрока = ЭтаФорма.Набрано[0];
	Если ИнформацияОТоваре.Свойство("ГруппаАВСФилиала") И НоваяСтрока.Свойство("ГруппаАВСФилиала") Тогда
		НоваяСтрока.ГруппаАВСФилиала = ИнформацияОТоваре.ГруппаАВСФилиала;
	КонецЕсли;
	НоваяСтрока.КодПроизводителя = ИнформацияОТоваре.КодПроизводителя;
	НоваяСтрока.Кратность = ИнформацияОТоваре.Кратность;
	НоваяСтрока.Производитель = ИнформацияОТоваре.Производитель;
	НоваяСтрока.Наименование = ИнформацияОТоваре.Наименование;
	НоваяСтрока.Сканировано = ИнформацияОТоваре.Сканировано;
	
	Если ИнформацияОТоваре.Свойство("КоличествоТовараВЯчейкеКуда", )  Тогда
		НоваяСтрока.КоличествоТовараВЯчейкеКуда = ИнформацияОТоваре.КоличествоТовараВЯчейкеКуда;
	КонецЕсли; 
	
	Если ИнформацияОТоваре.Свойство("ВсегоНаСкладе", ) Тогда
		НоваяСтрока.ВсегоНаСкладе = ИнформацияОТоваре.ВсегоНаСкладе;
	КонецЕсли; 

	
КонецПроцедуры 

Процедура ОтобразитьИнформациюОГМ_Структура(ИнформацияОТоваре, Ошибка, ЭтаФорма) Экспорт
	
	ЭтаФорма.ОписаниеНайденногоТовара = "";
	Если ЗначениеЗаполнено(Ошибка) Тогда
		
		ЭтаФорма.ОписаниеОшибки = Ошибка;
		Оповестить("СканированиеШтрихкода");
		
	КонецЕсли;  
	
	ЭтаФорма.Набрано.Очистить();
	НоваяСтрока = ЭтаФорма.Набрано.Добавить();
		
	ТекстСообщения = "Отсканированный штрихкод " + ЭтаФорма.Штрихкод + " не найден в поставке!";
	НоваяСтрока.СообщениеШКнеНайденВПоставке = ТекстСообщения;
	
	ТекстСообщения = "Отсканированный штрихкод " + ЭтаФорма.Штрихкод + " не найден в ячейке!";
	НоваяСтрока.СообщениеШКнеНайденВЯчейке = ТекстСообщения;
	
	НоваяСтрока.Заголовок = "Грузоместо:";
	НоваяСтрока.Наименование = ИнформацияОТоваре.Наименование;
	
КонецПроцедуры 

&НаКлиенте
Функция ПолучитьТекстДляОтсканированногоТовараПеремещения(НайденныйТовар, 
														  ОстатокПоТоваруВЯчейке,
														  ОстатокВЯчейкеКуда,
														  ОстатокВыбранногоТовараНаСкладе) Экспорт
		
	Результат = """%1"" %2 %3" + Символы.ПС;
	Результат = Результат + " кратность %4" + Символы.ПС;
	Результат = Результат + "Сканировано %5 из %6 %7" + Символы.ПС;
	Результат = Результат + "В ячейке ""Куда"" %8 %7" + Символы.ПС;
	Результат = Результат + "Всего на складе %9 %7";                       
	
	
	Результат  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Результат, 
			НайденныйТовар.КодПроизводителя,
			НайденныйТовар.Производитель, 			
			НайденныйТовар.Наименование, 
			НайденныйТовар.Кратность,			
			ОстатокПоТоваруВЯчейке.КоличествоНабрано,
			ОстатокПоТоваруВЯчейке.ОстатокВЯчейке, 			
			НайденныйТовар.ЕдИзмНаименование,
			ОстатокВЯчейкеКуда,                                                                
			ОстатокВыбранногоТовараНаСкладе
			);						
	
	Возврат Результат;
	
КонецФункции
  

&НаКлиенте
Процедура ОтобразитьИнформациюОТоваре_ОстаткиТоваровПоШК(ЭтаФорма, ЗначениеДляПоиска, МассивДанных) Экспорт 
	
	Структура = МассивДанных[0];
	
	ЭтаФорма.Набрано.Очистить();
	НоваяСтрока = ЭтаФорма.Набрано.Добавить();
	Если Структура.Свойство("ГруппаАВСФилиала") И НоваяСтрока.Свойство("ГруппаАВСФилиала") Тогда
		НоваяСтрока.ГруппаАВСФилиала = Структура.ГруппаАВСФилиала;
	КонецЕсли;
	НоваяСтрока.СообщениеТоварНеНайден = "";
	НоваяСтрока.НаСкладеЗаголовок = "На складе:";
	НоваяСтрока.ВРезервеЗаголовок = "В резерве:";
	НоваяСтрока.Заголовок = "Товар:";
	НоваяСтрока.Наименование = Структура.Наименование;
	НоваяСтрока.КодПроизводителя = Структура.КодПроизводителя;
	НоваяСтрока.Производитель = Структура.Производитель;
	НоваяСтрока.Штрихкод = ЗначениеДляПоиска;
	НоваяСтрока.НаСкладе = Структура.КоличествоНаСкладе;
	НоваяСтрока.ВРезерве = Структура.КоличествоВРезерве;
	НоваяСтрока.НаСкладеСтр = СокрЛ(Строка(Структура.КоличествоНаСкладе)) + " ед.";
	НоваяСтрока.ВРезервеСтр = СокрЛ(Строка(Структура.КоличествоВРезерве)) + " ед.";
	
КонецПроцедуры

&НаКлиенте
Функция ТаблицуВМассив(Таблица) Экспорт
	
	МассивДанных = Новый Массив;                                            
	
	Для каждого ТекСтрока Из Таблица Цикл
		
		СтруктураДанных = Новый Структура;
		
		Для каждого Колонка ИЗ Таблица.Колонки Цикл			

			СтруктураДанных.Вставить(Колонка.Имя, ТекСтрока[Колонка.Имя]);				
						
		КонецЦикла;
		
		МассивДанных.Добавить(СтруктураДанных);

	КонецЦикла;         
	
	Возврат МассивДанных;

КонецФункции    

Функция РазложитьСтрокуВМассив(Знач Стр, Разделитель = ";") Экспорт
	 
	 МассивСтрок = Новый Массив();  
	 
	 Если Разделитель = " " Тогда 
		 
		Стр = СокрЛП(Стр);    
		
		Пока 1 = 1 Цикл         
			
			Поз = Найти(Стр,Разделитель); 
			
			Если Поз = 0 Тогда              
				
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;     
				
			КонецЕсли;
			
			МассивСтрок.Добавить(Лев(Стр, Поз - 1));
			Стр = СокрЛ(Сред(Стр, Поз));
			
		КонецЦикла;  
		
	Иначе         
		
		ДлинаРазделителя = СтрДлина(Разделитель); 
		
		Пока 1 = 1 Цикл   
			
			Поз = Найти(Стр,Разделитель);
			
			Если Поз = 0 Тогда  
				
				МассивСтрок.Добавить(Стр);				
				Возврат МассивСтрок;    
				
			КонецЕсли;                 
			
			МассивСтрок.Добавить(Лев(Стр, Поз - 1)); 
			
			Стр = Сред(Стр, Поз + ДлинаРазделителя);
			
		КонецЦикла;   
		
	КонецЕсли;	

КонецФункции

&НаКлиенте
Процедура ПолучитьИнформациюОТовареДляПеремещенияТовара(ЭтаФорма) Экспорт

	Объект        = ЭтаФорма.Объект;
	Штрихкод      = ЭтаФорма.Штрихкод; 
	ТоварГУИД     = ЭтаФорма.ТоварГУИД;                                              
	ДокументГУИД  = Объект.ДокументГУИД;                                                  
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Получить остаток по найденному товару	
	ТоварГУИД = ЭтаФорма.НайденныйТовар.Владелец;
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////	
	// Получить остаток по найденному товару в ячейке КУДА			
	РезультатСтруктура = ОбщегоНазначения.ПолучитьОстатокПоТоваруВЯчейке(Объект.ЯчейкаКудаГУИД, Штрихкод, ТоварГУИД);

	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();			
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 4);	
		Возврат;
		
	КонецЕсли; 
	
	Если РезультатСтруктура.Данные.Количество() = 0 Или РезультатСтруктура.Данные[0].ОстатокВЯчейке = 0 Тогда
		ЭтаФорма.ОстатокВЯчейкеКуда = 0;
	Иначе
		ЭтаФорма.ОстатокВЯчейкеКуда = РезультатСтруктура.Данные[0].ОстатокВЯчейке;
	КонецЕсли; 
	

	// Получить ВЕСЬ остаток по найденному товару 
	РезультатСтруктура = ОбщегоНазначения.ПолучитьОстатокТовара(ТоварГУИД);	
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();			
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 4);	
		Возврат;		
		
	КонецЕсли; 	
	
	ЭтаФорма.ОстатокВыбранногоТовараНаСкладе = РезультатСтруктура.Данные;
	
	ИнформацияОТовареСтруктура = ОбщегоНазначенияКлиент.ПолучитьОписаниеОтсканированногоТовара_Структура_Перемещение(ЭтаФорма.НайденныйТовар, 
																								 ЭтаФорма.ОстатокПоТоваруВЯчейке,
																								 ЭтаФорма.ОстатокВЯчейкеКуда,
																								 ЭтаФорма.ОстатокВыбранногоТовараНаСкладе);
																									
	ОбщегоНазначенияКлиент.ОтобразитьИнформациюОТоваре_Структура(ИнформацияОТовареСтруктура, "", ЭтаФорма);
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
КонецПроцедуры


&НаКлиенте
Функция ОтобразитьИнформациюОГрузовомМесте_Структура(ГрузовоеМесто, ЭтаФорма) Экспорт
				
	ИнициализацияТЗ_Набрано(ЭтаФорма);
	
	НоваяСтрока = ЭтаФорма.Набрано[0];
