&НаКлиенте
Функция ПолучитьОписаниеОтсканированногоТовара_Структура_Перемещение(НайденныйТовар,  
														   			 ОстатокПоТоваруВЯчейке,
														   			 ОстатокВЯчейкеКуда,
														   			 ОстатокВыбранногоТовараНаСкладе) Экспорт
			
	Результат = Новый Структура;
	Если НайденныйТовар.Свойство("ГруппаАВСФилиала") Тогда 
		Результат.Вставить("ГруппаАВСФилиала", НайденныйТовар.ГруппаАВСФилиала); 
	КонецЕсли;
	Результат.Вставить("КодПроизводителя", НайденныйТовар.КодПроизводителя);
	Результат.Вставить("Производитель", НайденныйТовар.Производитель);
	Результат.Вставить("Наименование", НайденныйТовар.Наименование);
	Результат.Вставить("Кратность", "Кратность: " + Строка(НайденныйТовар.Кратность) + Символы.ПС);
		
	Сканировано = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Сканировано %1 из %2", 
																		  Строка(ОстатокПоТоваруВЯчейке.КоличествоНабрано), 
																		  Строка(ОстатокПоТоваруВЯчейке.ОстатокВЯчейке) );
					
	Результат.Вставить("Сканировано", Сканировано);
		
	КоличествоТовараВЯчейкеКуда = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("В ячейке ""Куда"" %1 %2",
																	   					  Строка(ОстатокВЯчейкеКуда),
																	   					  НайденныйТовар.ЕдИзмНаименование);
	Результат.Вставить("КоличествоТовараВЯчейкеКуда", КоличествоТовараВЯчейкеКуда);			
	
	ВсегоНаСкладе =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Всего на складе %1 %2", 
																		      Строка(ОстатокВыбранногоТовараНаСкладе), 
																			  НайденныйТовар.ЕдИзмНаименование);
	Результат.Вставить("ВсегоНаСкладе", ВсегоНаСкладе);
	
	Возврат Результат;
	
КонецФункции


&НаКлиенте
Функция ПолучитьТекстДляОтсканированногоТовара(НайденныйТовар, ОстатокПоТоваруВДокументе) Экспорт
		
	Результат = """%1"" %2 %3" + Символы.ПС;
	Результат = Результат + " кратность %4" + Символы.ПС;
	Результат = Результат + "Сканировано %5 из %6 %7" + Символы.ПС;
	Результат = Результат + "всего в поставке %6" ;
	
	КоличествоНабрано = ОстатокПоТоваруВДокументе.КоличествоВБуфере + ОстатокПоТоваруВДокументе.КоличествоВРазмещении;
	
	Результат  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Результат, 
			Строка(НайденныйТовар.КодПроизводителя),
			НайденныйТовар.Производитель, 			
			НайденныйТовар.Наименование, 
			Строка(НайденныйТовар.Кратность),			
			//Строка(ОстатокПоТоваруВДокументе.КоличествоВБуфере),
			Строка(КоличествоНабрано),
			Строка(ОстатокПоТоваруВДокументе.КоличествоВДокументе), 			
			НайденныйТовар.ЕдИзмНаименование
			);						
	
	Возврат Результат;
	
КонецФункции

