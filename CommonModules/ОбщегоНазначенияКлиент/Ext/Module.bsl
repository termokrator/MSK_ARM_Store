&НаКлиенте
Функция ПодключитьКомпоненту_AddInBroadcastsUniversalBroadcast(РежимПодключения = "Broadcast") Экспорт
	
	//Return Неопределено;
	
#Если МобильноеПриложениеКлиент Тогда
	                                                                             
	// Работает для ТСД модели PM 80
	//ИмяСобытия = "device.scanner.EVENT";
	//Параметр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонДанных,"EXTRA_EVENT_DECODE_VALUE",XMLСтрока(Истина),XMLСтрока(15));						
	
	
	//ТСД CipherLab RS30 и С70
	//ИмяСобытия = "com.scanner.broadcast";
	//Параметр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонДанных,"data",XMLСтрока(Ложь),XMLСтрока(0));						
	
	// ТСД UROVO i6300	
	//ИмяСобытия = "android.intent.ACTION_DECODE_DATA";
	//Параметр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонДанных,"barcode_string",XMLСтрока(Ложь),XMLСтрока(0));						
	
	// ТСД Honeywell CT 60                                       
	// ИмяСобытия = "com.honeywell.sample.action.BARCODE_DATA";
	// Параметр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонДанных,"data",XMLСтрока(Ложь),XMLСтрока(0));						
	
	// ТСД Honeywell CT 60                                       
	ИмяСобытия = "com.honeywell.sample.action.BARCODE_DATA";	
	Если ПодключитьВнешнююКомпоненту("ОбщийМакет.Component", "Broadcasts", ТипВнешнейКомпоненты.Native) Тогда
		
		Если РежимПодключения = "Broadcast" Тогда
			                                                                                   
			Компонента = Новый("AddIn.Broadcasts.UniversalBroadcast");                         
			Компонента.УстановитьПараметр("FilterName", ИмяСобытия);
			
			ШаблонДанных = Компонента.ПолучитьШаблонОписанияДанных();		    
			Параметр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонДанных,"data",XMLСтрока(Ложь),XMLСтрока(0));									
			Компонента.УстановитьПараметр("CaptureData",Параметр);
			//Компонента.УстановитьПараметр("Category",Параметр);
			
			Возврат Компонента;
			
		КонецЕсли;                                                                        
		
		Если РежимПодключения = "clipboard" Тогда
				                                                                        
			КомпонентаБуфер = Новый("AddIn.Broadcasts.Clipboard");                       
			СодержимоеБуфера = КомпонентаБуфер.СодержимоеБуфера;
			КомпонентаБуфер.Подключить();                                       
			
			Возврат КомпонентаБуфер;
			
		КонецЕсли;
		
	Иначе
		ПоказатьПредупреждение(,"Компонента не подключена",5);              
	КонецЕсли;
#КонецЕсли

	Возврат Неопределено;
	
КонецФункции


