&НаКлиенте
Функция СформироватьПараметрыДляФормы(ИмяОбработки, Объект) Экспорт
	
	Если ИмяОбработки = "ПриемкаКоллективная" Тогда
		
		ПараметрыРаботы = Новый Структура;
		ПараметрыРаботы.Вставить("НомерСкладскогоДокумента", Объект.НомерСкладскогоДокумента);
		ПараметрыРаботы.Вставить("ЯчейкаПриемки", Объект.ЯчейкаПриемки);
		ПараметрыРаботы.Вставить("ЯчейкаПриемкиГУИД", Объект.ЯчейкаПриемкиГУИД);
		ПараметрыРаботы.Вставить("ДокументГУИД", Объект.ДокументГУИД);	
		//+Шульман А. 13.11.2025 #UT10-5504
		ПараметрыРаботы.Вставить("ПоставкаОтВнешнегоПоставщика", Объект.ПоставкаОтВнешнегоПоставщика);
		//-Шульман А. 13.11.2025 #UT10-5504    
		
	ИначеЕсли ИмяОбработки = "ПеремещениеТовараИзЯчейки"  Тогда 
		
		ПараметрыРаботы = Новый Структура;
		ПараметрыРаботы.Вставить("ЯчейкаКуда", Объект.ЯчейкаКуда);
		ПараметрыРаботы.Вставить("ЯчейкаКудаГУИД", Объект.ЯчейкаКудаГУИД);
		ПараметрыРаботы.Вставить("ЯчейкаОткуда", Объект.ЯчейкаОткуда);
		ПараметрыРаботы.Вставить("ЯчейкаОткудаГУИД", Объект.ЯчейкаОткудаГУИД);			
		
	КонецЕсли; 
	                          
	Возврат ПараметрыРаботы;	
		
КонецФункции

 
