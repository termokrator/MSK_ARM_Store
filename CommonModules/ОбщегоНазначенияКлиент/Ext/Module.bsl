&НаКлиенте
Функция ЗаполнитьТЧКнопокДляШКнеНайден(ЭтаФорма) Экспорт
	
	СтрокаТЗ = ЭтаФорма.КнопкаПропустить.Добавить();
	СтрокаТЗ.Пропустить = Символы.ПС + "ПРОПУСТИТЬ    " + Символы.ПС;
	
	СтрокаТЗ = ЭтаФорма.КнопкаДобавитьШтрихкод.Добавить();
	СтрокаТЗ.ДобавитьШтрихкод = Символы.ПС + Символы.ПС + "ДОБАВИТЬ ШТРИХКОД К ТОВАРУ";
	
	СтрокаТЗ = ЭтаФорма.КнопкаВыбратьТоварИзДокумента.Добавить();
	СтрокаТЗ.ВыбратьТовар = "ВЫБРАТЬ ТОВАР ИЗ ДОКУМЕНТА";
	
	Если ЭтаФорма.ИмяФормы = "Обработка.ПеремещениеТовараИзЯчейки.Форма.ФормаПеремещениеНоменклатуры" Тогда
		СтрокаТЗ.ВыбратьТовар = "ВЫБРАТЬ ТОВАР ИЗ ЯЧЕЙКИ";	
	ИначеЕсли ЭтаФорма.ИмяФормы = "Обработка.ПриемкаКоллективная.Форма.ФормаРазмещениеТовара" Тогда
		СтрокаТЗ.ВыбратьТовар = "ВЫБРАТЬ ТОВАР ИЗ ДОКУМЕНТА";	
	КонецЕсли; 
	
	
КонецФункции
 
	
