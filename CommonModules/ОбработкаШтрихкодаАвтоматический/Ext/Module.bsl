Функция ОшибкаПроверкиСостоянияКода(КодМаркировки, РазрешитьПриниматьКМБезПроверкиСостояния, СостояниеКМ)   
	
	//+Шульман А. 13.11.2025 #UT10-5504
	РезультатПроверкиКМ = ОбщегоНазначения.ПроверитьСостояниеКМ(КодМаркировки);    
	СостояниеКМ = РезультатПроверкиКМ.СостояниеКМ;
	
	Если РезультатПроверкиКМ.Действие = "Обработать ошибку сервиса" Тогда   
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();	

		СписокОтветов = Новый СписокЗначений;      
		
		Если РазрешитьПриниматьКМБезПроверкиСостояния Тогда
			
			СписокОтветов.Добавить(КодВозвратаДиалога.Да  , "Пропустить проверку");  
			СписокОтветов.Добавить(КодВозвратаДиалога.Нет , "Отсканирую позже");   
			
			ОтветНаВопрос = Вопрос("" , СписокОтветов , , КодВозвратаДиалога.Да , "Сервис проверки маркировки недоступен или ошибка чтения данных на сервисе");  
			
			Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда   
				
				СостояниеКМ = "Разместить для возврата";
				Возврат Истина;    
				
			Иначе           
				
				СостояниеКМ = "Пропустить проверку";
				Возврат Ложь;
				
			КонецЕсли;      
			
		Иначе
			
			СписокОтветов.Добавить(КодВозвратаДиалога.Да, "Продолжить");
			ОтветНаВопрос = Вопрос("" , СписокОтветов , , КодВозвратаДиалога.Да , "Сервис недоступен или ошибка чтения данных на сервисе. Отсканируйте марку позже.");   
			СостояниеКМ = "Разместить для возврата";
			Возврат Истина;    
		
		КонецЕсли;   
		
	ИначеЕсли РезультатПроверкиКМ.Действие = "Обработать код не в обороте" Тогда
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();	
		
		СписокОтветов = Новый СписокЗначений;      
		СписокОтветов.Добавить(КодВозвратаДиалога.Да, "Продолжить");  
		ОтветНаВопрос = Вопрос("" , СписокОтветов , , КодВозвратаДиалога.Да , "Код маркировки не в обороте. Отложите товар!");  
		СостояниеКМ = "Разместить для возврата";
        Возврат Истина;
		
	КонецЕсли;  
	
	Возврат Ложь;
