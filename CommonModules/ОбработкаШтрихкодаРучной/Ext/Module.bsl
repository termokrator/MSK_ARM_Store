///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
&НаКлиенте
Функция  ОбработкаШтрихкодаВРучномРежиме(ЭтаФорма, ТипДокумента, ГМ = Ложь) Экспорт
	
	Ошибка = "";
	Объект        = ЭтаФорма.Объект;
	Штрихкод      = ЭтаФорма.Штрихкод; 
	ТоварГУИД     =  ЭтаФорма.ТоварГУИД;
	ДокументГУИД  = Объект.ДокументГУИД;   
	
	Если ГМ Тогда     
		
		ИнформацияОТоваре = Новый Структура("Наименование", Штрихкод);	
		ОбщегоНазначенияКлиент.ОтобразитьИнформациюОГМ_Структура(ИнформацияОТоваре, ЭтаФорма.ОписаниеОшибки, ЭтаФорма);
		ЭтаФорма.ПоказатьСтраницу_ГруппаСтраницыРаботаСТоваров();   
		
		Возврат ""; 
		
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Найти товар по штрихкоду
	РезультатСтруктура = ОбщегоНазначения.НайтиТоварПоШтрихкоду(Штрихкод, ТипДокумента, ДокументГУИД, ТоварГУИД);	
	
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();			
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 4);	
		Возврат "";
		
	КонецЕсли; 
	
	Если РезультатСтруктура.Данные.Количество() = 1 Тогда
		
		Если РезультатСтруктура.Данные[0].ТипСтрокиЗапроса = "Ячейка" Тогда
	
			Если ТипДокумента = "ПоступлениеТоваровУслуг" Тогда				
				
				Результат = ОбработатьВыбраннуюЯчейкуДляРазмещенияТовара(ЭтаФорма);
				Возврат Результат;
				
			ИначеЕсли ТипДокумента = "ПеремещениеТовараИзЯчейки" Тогда 				
				
				Результат = ОбработатьВыбраннуюЯчейкуДляПеремещенияТовара(ЭтаФорма);				
				Возврат Результат;
				
			ИначеЕсли ТипДокумента = "ЗаданиеНаИнвентаризацию" Тогда 				
				
				Результат = ОбработатьВыбраннуюЯчейкуИзЗаданияНаИнвентаризацию(ЭтаФорма);				
				Возврат Результат;
				
			КонецЕсли;
			
			Возврат "";						
			
		КонецЕсли; 
		
		ЭтаФорма.НайденныйТовар = РезультатСтруктура.Данные[0];
		
		Если ТипДокумента = "ПоступлениеТоваровУслуг" Тогда
			
		   ОбработкаШтрихкодаВРучномРежиме_ПоступлениеТоваровУслуг(ЭтаФорма, ТипДокумента);
			  
   	    ИначеЕсли ТипДокумента = "ПеремещениеТовараИзЯчейки" Тогда 
			  
		  ОбработкаШтрихкодаВРучномРежиме_ПеремещениеТовараИзЯчейки(ЭтаФорма, ТипДокумента);
			  
	   ИначеЕсли ТипДокумента = "ЗаданиеНаИнвентаризацию" Тогда 							  
			  
		  ОбработкаШтрихкодаВРучномРежиме_ДляИнвентаризируемойЯчейки(ЭтаФорма, ТипДокумента);

		КонецЕсли; 
		
	ИначеЕсли РезультатСтруктура.Данные.Количество() >  1 Тогда		
		
		Оповестить("СканированиеШтрихкода");	
		ДополнительныеПараметры  = Новый Структура("ЭтаФорма, ТипДокумента, НайденныеТовары", ЭтаФорма, ТипДокумента, РезультатСтруктура.Данные);		
		Оповещение = Новый ОписаниеОповещения("ПолучениеДанныхПриЗакрытииФормыВыбораТовараДокумента", ЭтотОбъект, ДополнительныеПараметры);
																												
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("НайденныеТовары", РезультатСтруктура.Данные);		
		//ОткрытьФорму("Обработка.ПриемкаКоллективная.Форма.ФормаВыбораТовараДокумента", ПараметрыФормы, ЭтаФорма,,, , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ОткрытьФорму("Обработка.ОбщиеФормы.Форма.ФормаВыбораТовараДокумента", ПараметрыФормы, ЭтаФорма,,, , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
		
	Иначе                 
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();	
		Возврат "НеизвестныйШтрихкод";                          
		
	КонецЕсли;                                                                        
				
КонецФункции 

&НаКлиенте		  
Процедура ПолучениеДанныхПриЗакрытииФормыВыбораТовараДокумента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ЭтаФорма = ДополнительныеПараметры.ЭтаФорма;
		Если Результат.ТипСтрокиЗапроса = "Ячейка" Тогда
			
			Если ДополнительныеПараметры.ТипДокумента = "ПоступлениеТоваровУслуг" Тогда
				
				ОбработатьВыбраннуюЯчейкуДляРазмещенияТовара(ЭтаФорма);				
				
			ИначеЕсли ДополнительныеПараметры.ТипДокумента = "ПеремещениеТовараИзЯчейки" Тогда 
				
				ОбработатьВыбраннуюЯчейкуДляПеремещенияТовара(ЭтаФорма);
				
			ИначеЕсли ДополнительныеПараметры.ТипДокумента = "ЗаданиеНаИнвентаризацию" Тогда 
				
				ОбработатьВыбраннуюЯчейкуИзЗаданияНаИнвентаризацию(ЭтаФорма);
				ДополнительныеПараметры.ЭтаФорма.Закрыть();
				
			КонецЕсли; 
			
			Возврат;
			
		КонецЕсли; 
		
		ДополнительныеПараметры.ЭтаФорма.ТоварГУИД = Результат.ТоварГУИД;		
		Для Счетчик = 0 По ДополнительныеПараметры.НайденныеТовары.Количество() - 1 Цикл
			
			Строка = ДополнительныеПараметры.НайденныеТовары [Счетчик];
			Если Строка.Владелец = Результат.ТоварГУИД Тогда
				ДополнительныеПараметры.ЭтаФорма.НайденныйТовар = Строка;			
				Прервать;
			КонецЕсли; 			
		КонецЦикла;
		
		
		Если ДополнительныеПараметры.ТипДокумента = "ПоступлениеТоваровУслуг" Тогда
			
			  ОбработкаШтрихкодаВРучномРежиме_ПоступлениеТоваровУслуг(ДополнительныеПараметры.ЭтаФорма, ДополнительныеПараметры.ТипДокумента);
			  
		  ИначеЕсли ДополнительныеПараметры.ТипДокумента = "ПеремещениеТовараИзЯчейки" Тогда 
			  
			  ОбработкаШтрихкодаВРучномРежиме_ПеремещениеТовараИзЯчейки(ДополнительныеПараметры.ЭтаФорма, ДополнительныеПараметры.ТипДокумента);
			  
		  ИначеЕсли ДополнительныеПараметры.ТипДокумента = "ЗаданиеНаИнвентаризацию" Тогда 
			  
			  ОбработкаШтрихкодаВРучномРежиме_ДляИнвентаризируемойЯчейки(ДополнительныеПараметры.ЭтаФорма, ДополнительныеПараметры.ТипДокумента);
			  
		КонецЕсли; 
		
	Иначе
		
		РежимВводаАвтоматический = ОбщегоНазначения.УстановленРежимВводаАвтоматический();
		Если  Не РежимВводаАвтоматический  Тогда
			ОбщегоНазначения.УстановитьРежимВводаНаСервере();	
		КонецЕсли; 			

		ОбщегоНазначения.УстановитьРежимВыбораДляДокументаИнвентаризации("ВыборНоменклатуры");
		ДополнительныеПараметры.ЭтаФорма.ПоказатьСтраницу_ГруппаСтраницыРаботаСТоваров();
				
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Функция ОбработатьВыбраннуюЯчейкуДляРазмещенияТовара(ЭтаФорма)
	
	Проверка = ОбщегоНазначенияКлиент.СканированныйШтрихкодЯвляетсяЯчейкой(ЭтаФорма.Штрихкод, ЭтаФорма.Объект.ЯчейкаПриемки);		
	Если Проверка Тогда        
		
		ЭтаФорма.ОбработатьЯчейкуДляЗакрытияПриемкиТовара();		
		ОбщегоНазначения.УстановитьРежимВводаНаСервере(Истина);
		ОбщегоНазначения.УстановитьРежимВыбораДляДокументаРазмещения("ВыборЯчейки");
		Результат =  "ЗакрытиеЯчейкиПриемки";									
		
	Иначе                                               		
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();		
		ОбщегоНазначения.УстановитьРежимВыбораДляДокументаРазмещения("ВыборНоменклатуры");
		Результат = "ЯчейкаНеСоотвестЯчейкиПриемки";
		
	КонецЕсли; 
	
	ЭтаФорма.ПоказатьСтраницу_ГруппаСтраницыРаботаСТоваров();					
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОбработатьВыбраннуюЯчейкуДляПеремещенияТовара(Этаформа)
	
	Проверка = ОбщегоНазначенияКлиент.СканированныйШтрихкодЯвляетсяЯчейкой(ЭтаФорма.Штрихкод, ЭтаФорма.Объект.ЯчейкаКуда);		
	Если Проверка Тогда                                  
				
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлЯчейки();
		ОбщегоНазначения.УстановитьРежимВводаНаСервере(Истина);
		ЭтаФорма.СоздатьДокументПеремещенияПослеСканирЯчейкиКуда(ЭтаФорма.Объект);				
		Результат =  "ЗакрытиеЯчейкиПриемки";									
		
	Иначе                                               
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();
		ОбщегоНазначения.УстановитьРежимВвыбораДляПеремещенияТовара("ПоискНоменклатуры");
		Результат = "ЯчейкаНеСоотвестЯчейкиПриемки";
		
	КонецЕсли; 
	
	ЭтаФорма.ПоказатьСтраницу_ГруппаСтраницыРаботаСТоваров();					
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОбработатьВыбраннуюЯчейкуИзЗаданияНаИнвентаризацию(ЭтаФорма)
	
	Проверка = ОбщегоНазначенияКлиент.СканированныйШтрихкодЯвляетсяЯчейкой(ЭтаФорма.Штрихкод, ЭтаФорма.КодЯчейкиФормат);		
	Если Проверка Тогда                                  
				
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлЯчейки();
		Результат =  "ЗакрытиеЯчейкиПриемки";									
		
	Иначе                                               
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();
		ОбщегоНазначения.УстановитьРежимВыбораДляДокументаИнвентаризации("ПоискНоменклатуры");
		Результат = "ЯчейкаНеСоотвестЯчейкеИнвентаризации";
		
	КонецЕсли; 
	
	ЭтаФорма.ПоказатьСтраницу_ГруппаСтраницыРаботаСТоваров();					
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОбработкаШтрихкодаВРучномРежиме_ПеремещениеТовараИзЯчейки(ЭтаФорма, ТипДокумента)
	
	Ошибка = "";
	Объект        = ЭтаФорма.Объект;
	Штрихкод      = ЭтаФорма.Штрихкод; 
	ТоварГУИД     =  ЭтаФорма.ТоварГУИД;                                              
	ДокументГУИД  = Объект.ДокументГУИД;                                                  
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Получить остаток по найденному товару в ячейке ОТКУДА		
	ТоварГУИД = ЭтаФорма.НайденныйТовар.Владелец;
	РезультатСтруктура = ОбщегоНазначения.ПолучитьОстатокПоТоваруВЯчейке(Объект.ЯчейкаОткудаГУИД, Штрихкод, ТоварГУИД);
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();			
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 4);	
		
		ЭтаФорма.Элементы.ГруппаВведенооеКоличествоВРучную.Видимость = Ложь;
		Возврат "";
		
	КонецЕсли; 
	
	Если РезультатСтруктура.Данные.Количество() = 0 Или РезультатСтруктура.Данные[0].ОстатокВЯчейке = 0 Тогда
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();	
		ПоказатьПредупреждение(,"Ошибка: Номенклатура со штрихкодом " + ЭтаФорма.Штрихкод + " " + ЭтаФорма.НайденныйТовар.Наименование
			+ " в ячейке " + Объект.ЯчейкаОткуда + " не найдена.", 4);	
			
		ЭтаФорма.Элементы.ГруппаВведенооеКоличествоВРучную.Видимость = Ложь;		
		Возврат "";
		
	КонецЕсли; 	                                                    
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////
		
	ЭтаФорма.ОстатокПоТоваруВЯчейке = РезультатСтруктура.Данные[0];
	
	// Получить остаток по найденному товару в ячейке КУДА			
	РезультатСтруктура = ОбщегоНазначения.ПолучитьОстатокПоТоваруВЯчейке(Объект.ЯчейкаКудаГУИД, Штрихкод, ТоварГУИД);

	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();			
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 4);	
		Возврат "";
		
	КонецЕсли; 
	
	Если РезультатСтруктура.Данные.Количество() = 0 Или РезультатСтруктура.Данные[0].ОстатокВЯчейке = 0 Тогда
		ЭтаФорма.ОстатокВЯчейкеКуда = 0;
	Иначе
		ЭтаФорма.ОстатокВЯчейкеКуда = РезультатСтруктура.Данные[0].ОстатокВЯчейке;
	КонецЕсли; 
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////	
	// Получить ВЕСЬ остаток по найденному товару 
	РезультатСтруктура = ОбщегоНазначения.ПолучитьОстатокТовара(ТоварГУИД);	
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();			
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 4);	
		Возврат "";
		
	КонецЕсли; 	
	
	ЭтаФорма.ОстатокВыбранногоТовараНаСкладе = РезультатСтруктура.Данные;
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////
																									 
	ИнформацияОТоваре = ОбщегоНазначенияКлиент.ПолучитьОписаниеОтсканированногоТовара_Структура_Перемещение(ЭтаФорма.НайденныйТовар,  
															   	 							   			    ЭтаФорма.ОстатокПоТоваруВЯчейке,
														   			                                        ЭтаФорма.ОстатокВЯчейкеКуда,
														   			                                        ЭтаФорма.ОстатокВыбранногоТовараНаСкладе);
																								 																								
	ОбщегоНазначенияКлиент.ОтобразитьИнформациюОТоваре_Структура(ИнформацияОТоваре, Ошибка, ЭтаФорма);	
	
	ЭтаФорма.РучнойВводКоличества[0].ВведенноеКоличествоВРучную = 1;
	
	Возврат "";

КонецФункции

&НаКлиенте
Функция ОбработкаШтрихкодаВРучномРежиме_ПоступлениеТоваровУслуг(ЭтаФорма, ТипДокумента)
	
	Ошибка = "";
	Объект        = ЭтаФорма.Объект;
	Штрихкод      = ЭтаФорма.Штрихкод; 
	ТоварГУИД     =  ЭтаФорма.ТоварГУИД;                                              
	ДокументГУИД  = Объект.ДокументГУИД;                                                  
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Получить остаток по найденному товару	
	ТоварГУИД = ЭтаФорма.НайденныйТовар.Владелец;
	РезультатСтруктура = ОбщегоНазначения.ПолучитьОстатокПоТоваруИзДокумента(ДокументГУИД, Штрихкод, ТоварГУИД);			
	Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда                               
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();			
		ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 4);	
		Возврат "";
		
	КонецЕсли; 
			
	Если РезультатСтруктура.Данные.Количество() = 0 Тогда
		
		ОбщегоНазначенияКлиент.ПроигратьЗвуковойФайлОшибки();			
		ПоказатьПредупреждение(,"Ошибка: Номенклатура со штрихкодом " + ЭтаФорма.Штрихкод + " " + ЭтаФорма.НайденныйТовар.Наименование
			+ " в документе не найдена.", 4);	
		Возврат "";
		
	КонецЕсли;  
	
	
	// КоличествоВДокументе, КоличествоВБуфере, СсылкаТовара	
	ЭтаФорма.ОстатокПоТоваруВДокументе = РезультатСтруктура.Данные[0];
	
	//ИнформацияОТоваре = ОбщегоНазначенияКлиент.ПолучитьТекстДляОтсканированногоТовара(ЭтаФорма.НайденныйТовар, ЭтаФорма.ОстатокПоТоваруВДокументе);
	//ОбщегоНазначенияКлиент.ОтобразитьИнформациюОТоваре(ИнформацияОТоваре, Ошибка, ЭтаФорма);
	
	ИнформацияОТоваре = ОбщегоНазначенияКлиент.ПолучитьДляОтсканированногоТовара_Структура(ЭтаФорма.НайденныйТовар, ЭтаФорма.ОстатокПоТоваруВДокументе);	
	ОбщегоНазначенияКлиент.ОтобразитьИнформациюОТоваре_Структура(ИнформацияОТоваре, Ошибка, ЭтаФорма);
	
	//ЭтаФорма.ЭтотОбъект.ВведенноеКоличествоВРучную  = 1;			
	ЭтаФорма.РучнойВводКоличества[0].ВведенноеКоличествоВРучную = 1;
	
КонецФункции                                                                 

&НаКлиенте
Функция  ОбработкаШтрихкодаВРучномРежиме_ДляИнвентаризируемойЯчейки(ЭтаФорма, ТипДокумента)
	
	Ошибка            = "";
	Параметры       = ЭтаФорма.Параметры;
	ЯчейкаГУИД     = Параметры.ЯчейкаГУИД;
	Штрихкод         = ЭтаФорма.Штрихкод; 
	ДокументГУИД  = ЭтаФорма.Объект.ДокументГУИД;                                                  	
	ТоварГУИД 	   = ЭтаФорма.НайденныйТовар.Владелец;
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////	
	ЭтаФорма.КоличествоНабраноТСД =  1;
																							 																								 																											 
	ИнформацияОТоваре =  ОбщегоНазначенияКлиент.ПолучитьДляОтсканированногоТовара_Структура_Инвентаризация(ЭтаФорма.НайденныйТовар, ЭтаФорма.КоличествоНабраноТСД);																								 	
	ОбщегоНазначенияКлиент.ОтобразитьИнформациюОТоваре_Структура(ИнформацияОТоваре, ЭтаФорма.ОписаниеОшибки, ЭтаФорма);
	
	ЭтаФорма.РучнойВводКоличества[0].ВведенноеКоличествоВРучную = 1;
		
КонецФункции
