&НаСервере
Функция НайтиТоварПоШтрихкоду(Штрихкод, ТипДокумента, ДокументГУИД, ТоварГУИД) Экспорт
	
	РезультатОтвета = ПолучитьСтруктуруОтвета(); 
	РезультатОтвета.Вставить("Результат", Ложь);
	
	Для НомерПопытки = 1 По Константы.КоличествоПопытокПодключения.Получить() Цикл			
		
		Попытка
			WSПрокси = WSСсылки.ARMStoreKeeper.СоздатьWSПрокси("Data", "ARMStoreKeeper", "ARMStoreKeeperSoap", ,ПолучитьTimeout()); 						
			//WSПрокси.Пользователь = "webadmin";              
			//WSПрокси.Пароль = "web";		
			
			Ответ = WSПрокси.FindGoodByBarcode50(Штрихкод, ТипДокумента, ДокументГУИД, ТоварГУИД);
			РезультатОтвета = ОбработатьОтветWebService(РезультатОтвета, Ответ);				
			
			Прервать;
			
		Исключение
			
			РезультатОтвета.Вставить("Ошибка", "Ошибка получения данных.");
			ASK_ОбработкаОшибок.Ошибка("#Ошибка подключения к Web Service", "Ошибка получения данных." + ОписаниеОшибки(), "НайтиТоварПоШтрихкоду");
			
		КонецПопытки; 
		
	КонецЦикла;
	
	Возврат РезультатОтвета;
	                                                                       
КонецФункции

&НаСервере
Функция ЗаменитьНедопустимыеСимволыXML(Знач Текст, СимволЗамены = "") Экспорт
	
	ПозицияНачала = 1;
	
	Пока Истина Цикл
		
		Позиция = НайтиНедопустимыеСимволыXML(Текст, ПозицияНачала);
		
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если Позиция > 1 Тогда
			
			НедопустимыйСимвол = Сред(Текст, Позиция - 1, 1);
			
			Если НайтиНедопустимыеСимволыXML(НедопустимыйСимвол) > 0 Тогда
				Текст = СтрЗаменить(Текст, НедопустимыйСимвол, СимволЗамены);
			КонецЕсли;
			
		КонецЕсли;
		
		НедопустимыйСимвол = Сред(Текст, Позиция, 1);
		
		Если НайтиНедопустимыеСимволыXML(НедопустимыйСимвол) > 0 Тогда
			Текст = СтрЗаменить(Текст, НедопустимыйСимвол, СимволЗамены);
		КонецЕсли;
		
		ПозицияНачала = Позиция + 1;
		
	КонецЦикла;

	Возврат Текст;
КонецФункции

&НаСервере                                                                   
Функция ПолучитьЗначениеШтрихкода(Значение) Экспорт
	Структура  = Новый Структура("Ошибка, Штрихкод", "", ""); 	    
	
	Попытка
		
		СимволРазделитель = Символ(29);
		Пока НЕ СтрНайти(Значение,СимволРазделитель) = 0 Цикл
			Значение = СтрЗаменить(Значение,СимволРазделитель,"");
		КонецЦикла;
		
		СимволРазделитель = "&#29;";
		Пока НЕ СтрНайти(Значение,СимволРазделитель) = 0 Цикл
			Значение = СтрЗаменить(Значение,СимволРазделитель,"");
		КонецЦикла;

	    Значение = ЗаменитьНедопустимыеСимволыXML(Значение);
		
		ЧтениеXML = Новый ЧтениеXML;		
		ЧтениеXML.УстановитьСтроку(Значение);

		ПостроительDOM = Новый ПостроительDOM;			
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		
		//Разыменователь = Новый РазыменовательПространствИменDOM(ДокументDOM);
		РазыменовательПИ = ДокументDOM.СоздатьРазыменовательПИ(ДокументDOM);
		ЗапросXPath = "/MessageData/FilterData";
		Путь = ДокументDOM.СоздатьВыражениеXPath(ЗапросXPath, РазыменовательПИ);
		РезультатPath = Путь.Вычислить(ДокументDOM);    
		ОбработкаРезультата = РезультатPath.ПолучитьСледующий();
			
	Исключение                                                   
		Структура.Вставить("Ошибка", ОписаниеОшибки()+ СокрЛП(Значение));
		Возврат Структура;
	КонецПопытки; 
	
	Если ОбработкаРезультата.ТекстовоеСодержимое = "READ_FAIL" Тогда
		
		Структура.Вставить("Ошибка", "Ошибка сканирования штрихкода - " + ОбработкаРезультата.ТекстовоеСодержимое);
		Возврат Структура;
		
	КонецЕсли; 
	
	Структура.Вставить("Штрихкод", ОбработкаРезультата.ТекстовоеСодержимое);
	
	Возврат Структура;
	
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруОтвета()
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Ошибка", "");
	СтруктураОтвета.Вставить("Результат", Ложь);	
	СтруктураОтвета.Вставить("Данные", "");
	СтруктураОтвета.Вставить("ТипДанныхРезультат", "");
	
	Возврат СтруктураОтвета;
	
КонецФункции
  

&НаСервере
Функция ПолучитьНайденныеТоварыПоВведенномуЗначению(ЗначениеДляПоиска, ТипДокумента, ДокументГУИД, ТоварГУИД= "") Экспорт
	
	РезультатОтвета = ПолучитьСтруктуруОтвета();
	
	Для НомерПопытки = 1 По Константы.КоличествоПопытокПодключения.Получить() Цикл			
		
		Попытка
			WSПрокси = WSСсылки.ARMStoreKeeper.СоздатьWSПрокси("Data", "ARMStoreKeeper", "ARMStoreKeeperSoap", ,ПолучитьTimeout()); 						
			//WSПрокси.Пользователь = "webadmin";              
			//WSПрокси.Пароль = "web";		
									 
			Ответ = WSПрокси.FindGoodByBarcode50(ЗначениеДляПоиска, ТипДокумента, ДокументГУИД, ТоварГУИД);
			РезультатОтвета = ОбработатьОтветWebService(РезультатОтвета, Ответ);

			Прервать;
			
		Исключение                                                                          
			
			РезультатОтвета.Вставить("Ошибка", "Ошибка получения данных.");               		
			ASK_ОбработкаОшибок.Ошибка("#Ошибка подключения к Web Service", "Ошибка получения данных." + ОписаниеОшибки(), "ПолучитьНайденныеТоварыПоВведенномуЗначению");
			
		КонецПопытки;  
				
	КонецЦикла;
	
	Возврат РезультатОтвета;
	
КонецФункции

 
&НаСервере
Функция ОбработатьОтветWebService(РезультатОтвета, Ответ)
 
	Если ТипЗнч(Ответ) = Тип("ХранилищеЗначения") Тогда
		
		Данные = ХранилищеJSONВСтруктуру(Ответ);
		ЗначениеОшибки = "";
		
		Если ТипЗнч(Данные) = Тип("Структура") и Данные.Свойство("Ошибка",ЗначениеОшибки)  Тогда
			
			Если ЗначениеЗаполнено(ЗначениеОшибки) Тогда				
				
				РезультатОтвета.Вставить("Результат", Ложь);
				РезультатОтвета.Вставить("Ошибка", Данные.Ошибка);				
				Возврат РезультатОтвета;
				
			КонецЕсли; 
			
		КонецЕсли; 				
		
		РезультатОтвета.Вставить("Данные", Данные);
		РезультатОтвета.Вставить("Результат", Истина);
		
	ИначеЕсли ТипЗнч(Ответ) = Тип("Строка") И ЗначениеЗаполнено(Ответ) Тогда
			
		РезультатОтвета.Вставить("Данные", Ответ);							
		РезультатОтвета.Вставить("Результат", Истина);
		
	ИначеЕсли ТипЗнч(Ответ) = Тип("Boolean") Тогда
					
		РезультатОтвета.Вставить("Данные", Ответ);
		РезультатОтвета.Вставить("Результат", Истина);                      
		
	ИначеЕсли ТипЗнч(Ответ) = Тип("Число") Тогда
					
		РезультатОтвета.Вставить("Данные", Ответ);
		РезультатОтвета.Вставить("Результат", Истина);                      
		
	Иначе                                                                 
		
		РезультатОтвета.Вставить("Результат", Ложь);
		РезультатОтвета.Вставить("Ошибка", "Некорректные данные.");				
		
	КонецЕсли; 	
	
	Возврат РезультатОтвета;
	
КонецФункции

