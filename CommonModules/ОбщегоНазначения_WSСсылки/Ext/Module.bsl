&НаСервере
Функция АвторизоватьПользователя(Штрихкод, Пароль, Адрес) Экспорт
	
	РезультатОтвета = ПолучитьСтруктуруОтвета();
	РезультатОтвета.Вставить("Результат", Ложь);
	
	Если Не ЗначениеЗаполнено(Штрихкод) И Не ЗначениеЗаполнено(Пароль) Тогда
		РезультатОтвета.Ошибка = "Сканируйте штрихкод сотрудника или введите пароль.";
		Возврат РезультатОтвета;
	КонецЕсли;
	

	Если Не ЗначениеЗаполнено(Адрес) Тогда
		РезультатОтвета.Ошибка = "Заполните адрес web-сервиса";
		Возврат РезультатОтвета;
	Иначе		
		Константы.Адрес.Установить(СокрЛП(Адрес));
	КонецЕсли;
	
	Для НомерПопытки = 1 По Константы.КоличествоПопытокПодключения.Получить() Цикл
		
		Попытка
			WSПрокси = WSСсылки.ARMStoreKeeper.СоздатьWSПрокси("Data", "ARMStoreKeeper", "ARMStoreKeeperSoap", ,ПолучитьTimeout()); 		
			//WSПрокси.Пользователь = "webadmin";
			//WSПрокси.Пароль = "web";
			
			Ответ = WSПрокси.AuthenticationUser(Штрихкод, Пароль);	
			РезультатОтвета = ОбработатьОтветWebService(РезультатОтвета, Ответ);
			
			Если НЕ ЗначениеЗаполнено(РезультатОтвета.Ошибка) Тогда
				
				Константы.Пользователь.Установить(РезультатОтвета.Данные.Пользователь);
				Константы.ПолноеИмя.Установить(РезультатОтвета.Данные.ПолноеИмя);
				Константы.ПользовательГУИД.Установить(РезультатОтвета.Данные.ПользовательГУИД);                               						
				Константы.Пароль.Установить(Пароль);
				Константы.Адрес.Установить(Адрес);                               			
				
				Прервать;
				
			КонецЕсли;
			
		Исключение
					
			РезультатОтвета.Вставить("Ошибка", "Ошибка получения данных.");				
			ASK_ОбработкаОшибок.Ошибка("#Ошибка подключения к Web Service", "Ошибка получения данных." + ОписаниеОшибки(), "АвторизоватьПользователя");
			
		КонецПопытки;
		
	КонецЦикла; 	
	
	
	Возврат РезультатОтвета;
	
КонецФункции


