&НаСервере
Функция ЗаписатьРегистрСведений(ИмяРегистра, СписокДанных)
	
	РегСведНабор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	РегСведНабор.Прочитать();
	РегСведНабор.Очистить();
	                                                    
	Для каждого Данные Из СписокДанных Цикл
		
		НоваяЗапись = РегСведНабор.Добавить();	
		
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Данные);		
		Если ИмяРегистра = "СписокДокументовПТУ" Тогда
			НоваяЗапись.ДатаДокумента = ПреобразоватьДату(Данные.ДатаДокумента);
		КонецЕсли;			
		НоваяЗапись.ДатаЗагрузки = ТекущаяДата();		
	КонецЦикла; 
	
	РегСведНабор.Записать(Истина);
	
КонецФункции

&НаСервере
Функция ПреобразоватьДату(СтроковаяДата)
	
	СтроковаяДата = СтрЗаменить(СтроковаяДата , "-",""); 
	СтроковаяДата = СтрЗаменить(СтроковаяДата , ":","");
	СтроковаяДата = СтрЗаменить(СтроковаяДата , "T","");
	Возврат Дата(СтроковаяДата);
	
КонецФункции

