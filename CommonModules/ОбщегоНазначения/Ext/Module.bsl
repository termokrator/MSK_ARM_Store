&НаСервере
Процедура УстановитьПараметрыСеансов()
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("mp3");	
	Файл = Новый Файл(ИмяВременногоФайла);
	ПутьКВременнойПапке = Файл.Путь;
	ПутьКВременнойПапке = СтрЗаменить(ПутьКВременнойПапке, "\", "/");
	/////////////////////////////////////////////////////////////////////////////////////////	
	ИмяЗвуковогоФайлаОшибки = "Error-converted.mp3";		
	
	ИмяВременногоФайла =  ПутьКВременнойПапке + ИмяЗвуковогоФайлаОшибки;
	Файл = Новый Файл( ИмяВременногоФайла );
    Если Не Файл.Существует() Тогда
		
		ДвоичныйФайл = ПолучитьОбщийМакет("ЗвуковойФайлОшибки");                		
		ДвоичныйФайл.Записать(ИмяВременногоФайла);		
		
	КонецЕсли;		
	ПараметрыСеанса.ПутьДоЗвуковогоФайлаОшибки = ИмяВременногоФайла;
	
	/////////////////////////////////////////////////////////////////////////////////////////
	ИмяЗвуковогоФайлаЯчейки = "Cell-converted.mp3";	
	ИмяВременногоФайла =  ПутьКВременнойПапке + ИмяЗвуковогоФайлаЯчейки;
	Файл = Новый Файл( ИмяВременногоФайла );
    Если Не Файл.Существует() Тогда
		
		ДвоичныйФайл = ПолучитьОбщийМакет("ЗвуковойФайлЯчейки");                		
		ДвоичныйФайл.Записать(ИмяВременногоФайла);
		
    КонецЕсли;	
	ПараметрыСеанса.ПутьДоЗвуковогоФайлаЯчейки = ИмяВременногоФайла;	
	
КонецПроцедуры

