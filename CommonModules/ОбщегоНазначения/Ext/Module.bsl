&НаСервере 
Функция ПолучитьОстаткиПоМаркировкам(ДокументГУИД , ИнформацияОТоваре) Экспорт

	СтруктураВозврата = Новый Структура;
	РезультатСтруктура = ОбщегоНазначения.ПолучитьОстатокПоВсемТоварамИзДокумента(ДокументГУИД);
	
	ЗапросОстатковПоМаркировкам = Новый Запрос;
	ЗапросОстатковПоМаркировкам.Текст =
	"ВЫБРАТЬ
	|	СписокТоваровДокументаПТУ.КоличествоВБуфереМаркировок КАК КоличествоВБуфереМаркировок,
	|	СписокТоваровДокументаПТУ.КоличествоОжидаемыхМаркировок КАК КоличествоОжидаемыхМаркировок,
	|	СписокТоваровДокументаПТУ.КоличествоОтсканированныхМаркировок КАК КоличествоОтсканированныхМаркировок,
	|	СписокТоваровДокументаПТУ.КоличествоТоваровСМаркировкой КАК КоличествоТоваровСМаркировкой
	|ИЗ
	|	РегистрСведений.СписокТоваровДокументаПТУ КАК СписокТоваровДокументаПТУ
	|ГДЕ
	|	СписокТоваровДокументаПТУ.СсылкаПТУ = &ДокументГУИД
	|	И СписокТоваровДокументаПТУ.СсылкаТовара = &СсылкаТовара";
	
	ЗапросОстатковПоМаркировкам.УстановитьПараметр("ДокументГУИД",ДокументГУИД);
	ЗапросОстатковПоМаркировкам.УстановитьПараметр("СсылкаТовара",ИнформацияОТоваре.Владелец);
	
	РезультатЗапроса = ЗапросОстатковПоМаркировкам.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		ВыборкаЗапроса.Следующий();
		
		СтруктураВозврата.Вставить("КоличествоВБуфереМаркировок"         , ВыборкаЗапроса.КоличествоВБуфереМаркировок);
		СтруктураВозврата.Вставить("КоличествоОжидаемыхМаркировок"       , ВыборкаЗапроса.КоличествоОжидаемыхМаркировок);
		СтруктураВозврата.Вставить("КоличествоОтсканированныхМаркировок" , ВыборкаЗапроса.КоличествоОтсканированныхМаркировок);
		СтруктураВозврата.Вставить("КоличествоТоваровСМаркировкой"       , ВыборкаЗапроса.КоличествоТоваровСМаркировкой);
		
	КонецЕсли;

	Возврат СтруктураВозврата;

КонецФункции

