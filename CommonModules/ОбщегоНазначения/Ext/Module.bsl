Функция МожноВыгрузитьПроинвентаризируемыеТоварыПоВсемЯчейкам(ОбъектГУИД, Ячейки) Экспорт
	
	Результат = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СписокЗаданийНаИнвентаризацию.Ссылка КАК Ссылка,
	|	СписокЗаданийНаИнвентаризацию.СсылкаЯчейки КАК СсылкаЯчейки,
	|	СписокЗаданийНаИнвентаризацию.СтатусРаботы КАК СтатусРаботы
	|ИЗ
	|	РегистрСведений.СписокЗаданийНаИнвентаризацию КАК СписокЗаданийНаИнвентаризацию
	|ГДЕ
	|	СписокЗаданийНаИнвентаризацию.Ссылка = &Ссылка
	|	И СписокЗаданийНаИнвентаризацию.СсылкаЯчейки В(&Ячейки)
	|	И СписокЗаданийНаИнвентаризацию.СтатусРаботы <> 2";
	
	Запрос.УстановитьПараметр("Ссылка", ОбъектГУИД);
	
	ПараметрЯчейки = Новый Массив;
	Для каждого Элемент Из Ячейки Цикл
        ПараметрЯчейки.Добавить(Элемент.СсылкаЯчейки);
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("Ячейки", ПараметрЯчейки);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Количество() > 0 Тогда
		Результат = Ложь;
	КонецЕсли; 	 
	
	Возврат Результат;
	
КонецФункции
  

