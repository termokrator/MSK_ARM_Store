&НаСервере
Процедура УстановитьНачальныеПараметры() Экспорт
	
	Если Не ЗначениеЗаполнено(Константы.КоличествоПопытокПодключения.Получить()) Тогда
		Константы.КоличествоПопытокПодключения.Установить(2);
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(Константы.Адрес.Получить()) Тогда
		Константы.Адрес.Установить("192.168.1.117");
	КонецЕсли; 
	
	УстановитьВерсиюСервисаСервера() ; 
	Константы.Timeout.Установить( 15 );	
	УстановитьПараметрыСеансов();
	//УстановитьПутиДляЗвуковыхФайлов();
	
	УстановитьВозможностьУдаленияЗаписейИзБуфера(Истина);
	
	Константы.РазрешеноПроведениеПТУ.Установить(Ложь);
	Константы.ОтображатьСлужебныеЗапискиТСД.Установить(Ложь);
	Константы.ОтображатьТЕ.Установить(Ложь);
	Константы.ОтображатьМаркировкуТоваров.Установить(Ложь);	
	
	//+Шульман А. 05.12.2025 #UT10-5576  
	Константы.СчетчикДействий.Установить(1);
	//-Шульман А. 05.12.2025 #UT10-5576
	
КонецПроцедуры

