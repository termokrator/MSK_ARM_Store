			ТекВремя = ЗамерыВремени.CRIPTO;

		КонецЕсли;
		
	Иначе
		ДанныеШтрихкода.Вставить("ТекстОшибки", "Неправильная длина криптохвоста: " + СтрДлина(ПровКод));
	КонецЕсли;
	
	Если ЗамерятьВремя Тогда   
		
		ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
		ДанныеШтрихкода.ЗамерыВремени.Вставить("ОкончаниеПроверкиВалидности", ВремяСНачала - ТекВремя);    
		
	КонецЕсли;
	
	Возврат ДанныеШтрихкода;     
