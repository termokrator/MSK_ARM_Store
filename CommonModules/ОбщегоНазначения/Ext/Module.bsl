Функция ЕстьЛиТоварВЯчейке(ЯчейкаГУИД, ТоварГУИД) Экспорт
	
	РезультатОтвета = ПолучитьСтруктуруОтвета(); 
	РезультатОтвета.Вставить("Результат", Ложь);
	ПользовательГУИД = ОбщегоНазначения.ПолучитьПользователяГУИД();
	
	Для НомерПопытки = 1 По Константы.КоличествоПопытокПодключения.Получить() Цикл			
		
		Попытка
			WSОпределение = Новый WSОпределения(ПолучитьАдресВебСервиса(), , , , ПолучитьTimeout());
			WSПрокси = Новый WSПрокси(WSОпределение, WSОпределение.Сервисы[0].URIПространстваИмен, WSОпределение.Сервисы[0].Имя, WSОпределение.Сервисы[0].Имя + "Soap" );			
			//WSПрокси.Пользователь = "webadmin";              
			//WSПрокси.Пароль = "web";		
			
			Ответ = WSПрокси.IsGoodInCell(ЯчейкаГУИД, ТоварГУИД, ПользовательГУИД);
			РезультатОтвета = ОбработатьОтветWebService(РезультатОтвета, Ответ);				
			
			Прервать;
			
		Исключение
			
			РезультатОтвета.Вставить("Ошибка", "Ошибка получения данных.");
