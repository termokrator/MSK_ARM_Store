Функция ПолучитьКоличествоЗаписейВРегистреСведений(ИмяРегистра) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Количество(*) КАК КоличествоЗаписей
	|ИЗ
	|	РегистрСведений.&ИмяТаблицы КАК &ИмяТаблицы";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяТаблицы", ИмяРегистра);	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
