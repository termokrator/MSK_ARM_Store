		ИначеЕсли РежимПросмотра = "ПоказатьВсе" Или РежимПросмотра = "ПоказатьМестаНаСкладе" Тогда
			Возврат "";
		ИначеЕсли РежимПросмотра = "ПоказатьМестаВАвто" Тогда
			Возврат "Смахните влево для выбора";
		КонецЕсли; 
		
		Возврат "";		
			
	КонецЕсли;         	
		
	Возврат "";		
	
