&НаСервере
Функция ПолучитьПараметрыРаботыПриПеремещении() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПараметрыРаботыПриПеремещении.ЯчейкаКуда КАК ЯчейкаКуда,
	|	ПараметрыРаботыПриПеремещении.ЯчейкаКудаГУИД КАК ЯчейкаКудаГУИД,
	|	ПараметрыРаботыПриПеремещении.ЯчейкаОткуда КАК ЯчейкаОткуда,
	|	ПараметрыРаботыПриПеремещении.ЯчейкаОткудаГУИД КАК ЯчейкаОткудаГУИД
	|ИЗ
	|	РегистрСведений.ПараметрыРаботыПриПеремещении КАК ПараметрыРаботыПриПеремещении";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	РезультатЗапроса.Следующий();
			 
	ПараметрыРаботы = Новый Структура;
	
	ПараметрыРаботы.Вставить( "ЯчейкаКуда", РезультатЗапроса.ЯчейкаКуда);
	ПараметрыРаботы.Вставить( "ЯчейкаКудаГУИД", РезультатЗапроса.ЯчейкаКудаГУИД);
	ПараметрыРаботы.Вставить( "ЯчейкаОткуда", РезультатЗапроса.ЯчейкаОткуда);
	ПараметрыРаботы.Вставить( "ЯчейкаОткудаГУИД", РезультатЗапроса.ЯчейкаОткудаГУИД);
	
	Возврат ПараметрыРаботы;
	
КонецФункции

