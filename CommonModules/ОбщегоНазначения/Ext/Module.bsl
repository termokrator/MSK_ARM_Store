&НаСервере
Функция ПолучитьИнструкциюДействийДляПользователя(ЕстьОшибка = "", Форма = "", ГМ = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(ЕстьОшибка) Тогда
		Возврат "Для продолжения нажмите кнопку ""Продолжить"" ";
	КонецЕсли; 
	
	Если Форма = "Обработка.ПриемкаКоллективная.Форма.ФормаТоварыДокумента" Тогда
		Возврат "Смах. влево на товаре для действия";
	КонецЕсли; 
	
	Если Форма = "Обработка.ПриемкаКоллективная.Форма.ФормаСканированияМаркировок" Тогда
		
		Если Константы.СтатусРаботыСРазмещениемТовара.Получить() = Перечисления.СтатусРаботыСРазмещениемТовара.ВыборНомеклатурыДляМаркировки 
			И Константы.РежимВводаКоличества.Получить() = Перечисления.РежимВводаКоличества.Автоматический Тогда  			
			Возврат "Отсканируйте товар";			
		КонецЕсли;
		
		Если Константы.СтатусРаботыСРазмещениемТовара.Получить() = Перечисления.СтатусРаботыСРазмещениемТовара.ВыборМаркировки 
			И Константы.РежимВводаКоличества.Получить() = Перечисления.РежимВводаКоличества.Автоматический Тогда  			
			Возврат "Отсканируйте маркировку (QR-код)";			
		КонецЕсли;
		
	КонецЕсли; 
	
	Если Константы.СтатусРаботыСРазмещениемТовара.Получить() = Перечисления.СтатусРаботыСРазмещениемТовара.ВыборЯчейки Тогда
		
		Возврат "Отсканируйте ячейку приемки";
		
	ИначеЕсли Константы.СтатусРаботыСРазмещениемТовара.Получить() = Перечисления.СтатусРаботыСРазмещениемТовара.ВыборНоменклатуры 
		И Константы.РежимВводаКоличества.Получить() = Перечисления.РежимВводаКоличества.Автоматический Тогда
		
		Если ГМ Тогда
			Возврат "Отсканируйте грузоместо или ячейку ""Куда""" ;
		Иначе
			Возврат "Отсканируйте грузоместо или ячейку ""Куда""" ;
		КонецЕсли;	  
		
		
	ИначеЕсли Константы.СтатусРаботыСРазмещениемТовара.Получить() = Перечисления.СтатусРаботыСРазмещениемТовара.ВыборНоменклатуры 
		И Константы.РежимВводаКоличества.Получить() = Перечисления.РежимВводаКоличества.Ручной Тогда
		
		Если ГМ Тогда
			Возврат "Отсканируйте грузоместо или ячейку ""Куда""" ;
		Иначе
			Возврат "Отсканируйте грузоместо или ячейку ""Куда""";
		КонецЕсли;	  		 
		
	ИначеЕсли Константы.СтатусРаботыСРазмещениемТовара.Получить() = Перечисления.СтатусРаботыСРазмещениемТовара.ВводКоличестваНоменклатуры		 
		И Константы.РежимВводаКоличества.Получить() = Перечисления.РежимВводаКоличества.Ручной Тогда
		
		Возврат "Введите колво отсканир.товара";   
		
	ИначеЕсли Константы.СтатусРаботыСРазмещениемТовара.Получить() = Перечисления.СтатусРаботыСРазмещениемТовара.ШКнеНайденВПоставке Тогда
		
		//+Шульман А. 05.12.2025 #UT10-5576
		Если Форма = "Обработка.ПриемкаКоллективная.Форма.ФормаСканированияМаркировок" Тогда
			Возврат "Отсканируйте товар";  
		//-Шульман А. 05.12.2025 #UT10-5576
		Иначе
			Возврат "Выберите требуемое действие";
		КонецЕсли;
		
	КонецЕсли; 

	Возврат "";
	
КонецФункции
 
