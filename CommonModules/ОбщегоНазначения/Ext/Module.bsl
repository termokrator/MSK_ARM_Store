&НаСервере
Функция ЭтоШтрихкодКладовщика(Штрихкод) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1                                                                    
	|	ФизическоеЛицо.ФизическоеЛицоГУИД КАК ФизическоеЛицоГУИД,
	|	ФизическоеЛицо.Код КАК Код,
	|	ФизическоеЛицо.Наименование КАК Наименование,
	|	ФизическоеЛицо.АРМКладовщика КАК АРМКладовщика,
	|	ФизическоеЛицо.Должность КАК Должность
	|ИЗ
	|	РегистрСведений.ФизическоеЛицо КАК ФизическоеЛицо
	|ГДЕ
	|	ФизическоеЛицо.Код ПОДОБНО &Код";
	
	ЗначенияДляПоиска = Формат(Число(Штрихкод), "ЧЦ=5; ЧВН=; ЧГ=0");
	
	Запрос.УстановитьПараметр("Код", "%" + ЗначенияДляПоиска);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	РезультатЗапроса.Следующий();
	
	Результат = СтрНайти(ВРег(РезультатЗапроса.Должность), ВРег("Кладовщик")) > 0 Или СтрНайти(ВРег(РезультатЗапроса.Должность), ВРег("Начальник")) > 0;

	Возврат Результат;
	
КонецФункции
 
