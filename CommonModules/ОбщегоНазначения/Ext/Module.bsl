Функция ПолучитьИтогиПоОстаткамПоВыбранномуТовару(ВладелецГУИД, Штрихкод) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СписокНайденныхТоваровПоШтрихкоду.Владелец КАК Владелец,
	|	СписокНайденныхТоваровПоШтрихкоду.Наименование КАК Наименование,
	|	СписокНайденныхТоваровПоШтрихкоду.КодПроизводителя КАК КодПроизводителя,
	|	СУММА(СписокНайденныхТоваровПоШтрихкоду.КоличествоОстаток) КАК КоличествоОстаток,
	|	СписокНайденныхТоваровПоШтрихкоду.Производитель КАК Производитель,
	|	СписокНайденныхТоваровПоШтрихкоду.ГруппаАВСФилиала КАК ГруппаАВСФилиала
	|ПОМЕСТИТЬ ВТТоварыНаСкладе
	|ИЗ
	|	РегистрСведений.СписокНайденныхТоваровПоШтрихкоду КАК СписокНайденныхТоваровПоШтрихкоду
	|ГДЕ
	|	СписокНайденныхТоваровПоШтрихкоду.ИмяТаблицы = &ИмяТаблицы_1
	|	И СписокНайденныхТоваровПоШтрихкоду.Владелец = &Владелец
	|
	|СГРУППИРОВАТЬ ПО
	|	СписокНайденныхТоваровПоШтрихкоду.Владелец,
	|	СписокНайденныхТоваровПоШтрихкоду.Наименование,
	|	СписокНайденныхТоваровПоШтрихкоду.КодПроизводителя,
	|	СписокНайденныхТоваровПоШтрихкоду.Производитель,
	|	СписокНайденныхТоваровПоШтрихкоду.ГруппаАВСФилиала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокНайденныхТоваровПоШтрихкоду.Владелец КАК Владелец,
	|	СписокНайденныхТоваровПоШтрихкоду.Наименование КАК Наименование,
	|	СписокНайденныхТоваровПоШтрихкоду.КодПроизводителя КАК КодПроизводителя,
	|	СУММА(СписокНайденныхТоваровПоШтрихкоду.КоличествоОстаток) КАК КоличествоОстаток,
	|	СписокНайденныхТоваровПоШтрихкоду.Производитель КАК Производитель
	|ПОМЕСТИТЬ ВТТоварыВРезерве
	|ИЗ
	|	РегистрСведений.СписокНайденныхТоваровПоШтрихкоду КАК СписокНайденныхТоваровПоШтрихкоду
	|ГДЕ
	|	СписокНайденныхТоваровПоШтрихкоду.ИмяТаблицы = &ИмяТаблицы_2
	|	И СписокНайденныхТоваровПоШтрихкоду.Владелец = &Владелец
	|
	|СГРУППИРОВАТЬ ПО
	|	СписокНайденныхТоваровПоШтрихкоду.Владелец,
	|	СписокНайденныхТоваровПоШтрихкоду.Наименование,
	|	СписокНайденныхТоваровПоШтрихкоду.КодПроизводителя,
	|	СписокНайденныхТоваровПоШтрихкоду.Производитель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТТоварыНаСкладе.Владелец, ВТТоварыВРезерве.Владелец) КАК Владелец,
	|	ЕСТЬNULL(ВТТоварыНаСкладе.Наименование, ВТТоварыВРезерве.Наименование) КАК Наименование,
	|	ЕСТЬNULL(ВТТоварыНаСкладе.КодПроизводителя, ВТТоварыВРезерве.КодПроизводителя) КАК КодПроизводителя,
	|	ЕСТЬNULL(ВТТоварыВРезерве.КоличествоОстаток, 0) КАК КоличествоВРезерве,
	|	ЕСТЬNULL(ВТТоварыНаСкладе.КоличествоОстаток, 0) КАК КоличествоНаСкладе,
	|	ЕСТЬNULL(ВТТоварыНаСкладе.Производитель, ВТТоварыВРезерве.Производитель) КАК Производитель
	|ПОМЕСТИТЬ ВТПромежутРезультат
	|ИЗ
	|	ВТТоварыНаСкладе КАК ВТТоварыНаСкладе
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТТоварыВРезерве КАК ВТТоварыВРезерве
	|		ПО ВТТоварыНаСкладе.Владелец = ВТТоварыВРезерве.Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокТоваровДляВыбора.Владелец КАК Владелец,
	|	СписокТоваровДляВыбора.Наименование КАК Наименование,
	|	СписокТоваровДляВыбора.КодПроизводителя КАК КодПроизводителя,
	|	СписокТоваровДляВыбора.Производитель КАК Производитель,
	|	""&ШТРИХКОД&"" КАК Штрихкод,
	|	ЕСТЬNULL(ВТПромежутРезультат.КоличествоВРезерве, 0) КАК КоличествоВРезерве,
	|	ЕСТЬNULL(ВТПромежутРезультат.КоличествоНаСкладе, 0) КАК КоличествоНаСкладе,
	|	СписокТоваровДляВыбора.ГруппаАВСФилиала КАК ГруппаАВСФилиала
	|ИЗ
	|	РегистрСведений.СписокТоваровДляВыбора КАК СписокТоваровДляВыбора
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПромежутРезультат КАК ВТПромежутРезультат
	|		ПО СписокТоваровДляВыбора.Владелец = ВТПромежутРезультат.Владелец
	|ГДЕ
	|	СписокТоваровДляВыбора.Владелец = &Владелец";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ШТРИХКОД&", Штрихкод);
	
	Запрос.УстановитьПараметр("ИмяТаблицы_1", "ТоварыНаСкладе" );
	Запрос.УстановитьПараметр("ИмяТаблицы_2", "ТоварыВРезерве" );
	Запрос.УстановитьПараметр("Владелец", ВладелецГУИД );
	
	РезультатЗапроса = Запрос.Выполнить();	
	
	ТЗ = РезультатЗапроса.Выгрузить();
