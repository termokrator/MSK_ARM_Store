&НаСервере
Функция ПолучитьИнструкциюДляДействийПользователя_ЗаданиеНаДОставку(Форма, РежимПросмотра = "") Экспорт 
	
	Если Форма = "Обработка.ПогрузкаВАвто.Форма.ФормаСпискаЗаданийНаДоставку" Тогда
		
		ЗначениеКонстанты = Константы.СтатусРаботыСЗаданиемНаДоставку.Получить();
		Если ЗначениеКонстанты = Перечисления.СтатусРаботыСЗаданиемНаДоставку.ПоискЗаданияНаДоставку Тогда
			Возврат "Отсканируйте задание";
		ИначеЕсли ЗначениеКонстанты = Перечисления.СтатусРаботыСЗаданиемНаДоставку.ПоискГрузовогоМеста Тогда
			Возврат "Отсканируйте грузовое место";
		ИначеЕсли ЗначениеКонстанты = Перечисления.СтатусРаботыСЗаданиемНаДоставку.ГотовКСканированиюГрузовогоМеста Тогда			
			Возврат "Отсканируйте грузовое место";
		КонецЕсли; 
		
		Возврат "";		
		
	КонецЕсли; 
	
	Если Форма = "Обработка.ПогрузкаВАвто.Форма.ФормаГрузовогоМеста" Тогда        
		
		ЗначениеКонстанты = Константы.СтатусРаботыСЗаданиемНаДоставку.Получить();
		Если ЗначениеКонстанты = Перечисления.СтатусРаботыСЗаданиемНаДоставку.ПоискЗаданияНаДоставку Тогда
			Возврат "Отсканируйте задание";
		ИначеЕсли ЗначениеКонстанты = Перечисления.СтатусРаботыСЗаданиемНаДоставку.ПоискГрузовогоМеста И РежимПросмотра = "" Тогда
			Возврат "Отсканируйте грузовое место";
		ИначеЕсли ЗначениеКонстанты = Перечисления.СтатусРаботыСЗаданиемНаДоставку.ГотовКСканированиюГрузовогоМеста И РежимПросмотра = ""  Тогда			
			Возврат "Отсканируйте грузовое место";
			
		ИначеЕсли ( ЗначениеКонстанты = Перечисления.СтатусРаботыСЗаданиемНаДоставку.ПоискГрузовогоМеста Или
				    ЗначениеКонстанты = Перечисления.СтатусРаботыСЗаданиемНаДоставку.ГотовКСканированиюГрузовогоМеста) И 
				(РежимПросмотра = "ПоказатьВсе" Или РежимПросмотра = "ПоказатьМестаВАвто") Тогда
			Возврат "";
			
		ИначеЕсли ( ЗначениеКонстанты = Перечисления.СтатусРаботыСЗаданиемНаДоставку.ПоискГрузовогоМеста Или
				    ЗначениеКонстанты = Перечисления.СтатусРаботыСЗаданиемНаДоставку.ГотовКСканированиюГрузовогоМеста) И 
				   РежимПросмотра = "ПоказатьМестаНаСкладе" Тогда
			Возврат "Смахните влево для выбора";
		КонецЕсли; 
		
		Возврат "";		
		
	КонецЕсли;         	
	
	
	Возврат "";		
	
КонецФункции
 
