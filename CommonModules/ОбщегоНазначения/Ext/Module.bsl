Функция ЗаписатьВБуферАРМКладовщикаДляСозданияМаркировки(ДокументГУИД, тзОстатокМаркировка) Экспорт
	
	//+Шульман А. 02.10.2025 #UT10-5438     
	ГУИДПользователя = ОбщегоНазначения.ПолучитьПользователяГУИД();  
	ТекДата = ТекущаяДата();  
	ЯчейкаДляМаркировки = Константы.ЯчейкаДляМаркировки.Получить();  
	РежимВвода = ОбщегоНазначения.УстановленРежимВводаРучной();
	
	Для каждого тзСтрока Из тзОстатокМаркировка Цикл
		
		мТоварГУИД = тзСтрока.СсылкаТовара;      
		мКоличество = тзСтрока.Количество;   
		мШтрихкод = "";
		РезультатСтруктура = ОбщегоНазначения.ДобавитьТоварВБуферАРМКладовщика(ДокументГУИД, мТоварГУИД, ГУИДПользователя, 
				ТекДата, мШтрихкод, мКоличество, ЯчейкаДляМаркировки, РежимВвода);			
		
		Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
			Возврат РезультатСтруктура;
			
		ИначеЕсли РезультатСтруктура.Данные = Ложь Тогда 
			
			РезультатСтруктура.Вставить("Ошибка", "Ошибка записи в буфер кладовщика для создания кода маркировки");
			Возврат РезультатСтруктура;
			
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат Новый Структура("Ошибка", "");
	//-Шульман А. 02.10.2025 #UT10-5438 	

