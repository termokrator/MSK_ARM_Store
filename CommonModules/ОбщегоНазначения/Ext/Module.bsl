&НаСервере
Процедура ЗаписатьПараметрыРаботы( ИмяРегистра, ПараметрыРаботы ) Экспорт
	                                   
	МенеджерЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Прочитать();
	Для каждого Элемент Из ПараметрыРаботы Цикл
		
		МенеджерЗаписи[Элемент.Ключ] = Элемент.Значение;
		
	КонецЦикла; 	
	
	МенеджерЗаписи.Записать();		
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыРаботыСДокументомПТУ() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПараметрыРаботыСДокументомПТУ.НомерСкладскогоДокумента КАК НомерСкладскогоДокумента,
	|	ПараметрыРаботыСДокументомПТУ.ЯчейкаПриемки КАК ЯчейкаПриемки,
	|	ПараметрыРаботыСДокументомПТУ.ЯчейкаПриемкиГУИД КАК ЯчейкаПриемкиГУИД,
	|	ПараметрыРаботыСДокументомПТУ.ДокументГУИД КАК ДокументГУИД,          
	//+Шульман А. 13.11.2025 #UT10-5504
	|	ПараметрыРаботыСДокументомПТУ.ПоставкаОтВнешнегоПоставщика КАК ПоставкаОтВнешнегоПоставщика    
	//-Шульман А. 13.11.2025 #UT10-5504
	|ИЗ
	|	РегистрСведений.ПараметрыРаботыСДокументомПТУ КАК ПараметрыРаботыСДокументомПТУ";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	РезультатЗапроса.Следующий();
			 
	ПараметрыРаботы = Новый Структура;
	
	ПараметрыРаботы.Вставить( "НомерСкладскогоДокумента", РезультатЗапроса.НомерСкладскогоДокумента);
	ПараметрыРаботы.Вставить( "ЯчейкаПриемки", РезультатЗапроса.ЯчейкаПриемки);
	ПараметрыРаботы.Вставить( "ЯчейкаПриемкиГУИД", РезультатЗапроса.ЯчейкаПриемкиГУИД);
	ПараметрыРаботы.Вставить( "ДокументГУИД", РезультатЗапроса.ДокументГУИД);    
	//+Шульман А. 13.11.2025 #UT10-5504
	ПараметрыРаботы.Вставить( "ПоставкаОтВнешнегоПоставщика", РезультатЗапроса.ПоставкаОтВнешнегоПоставщика); 
	//-Шульман А. 13.11.2025 #UT10-5504
	
	Возврат ПараметрыРаботы;
	
КонецФункции

