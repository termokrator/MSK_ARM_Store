Функция МаркировкаОтсканированнаВПТУ(ШтрихКодКраткий , ШтрихКодПолный , ДокументГУИД) Экспорт

	РезультатСтруктура = ОбщегоНазначения.ПолучитьОстатокПоВсемТоварамИзДокумента(ДокументГУИД);

	ЗапросМаркировкиВПТУ = Новый Запрос;
	ЗапросМаркировкиВПТУ.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СписокОтсканированныхМаркировокДокументаПТУ.КодМаркировки КАК КодМаркировки
	|ИЗ
	|	РегистрСведений.СписокОтсканированныхМаркировокДокументаПТУ КАК СписокОтсканированныхМаркировокДокументаПТУ
	|ГДЕ
	|	СписокОтсканированныхМаркировокДокументаПТУ.СсылкаПТУ = &ДокументГУИД
	|	И (СписокОтсканированныхМаркировокДокументаПТУ.ШтрихКод = &ШтрихКодКраткий
	|			ИЛИ СписокОтсканированныхМаркировокДокументаПТУ.ШтрихКод = &ШтрихКодПолный)" ;
	
	ЗапросМаркировкиВПТУ.УстановитьПараметр("ДокументГУИД"    , ДокументГУИД);
	ЗапросМаркировкиВПТУ.УстановитьПараметр("ШтрихКодКраткий" , ШтрихКодКраткий);
	ЗапросМаркировкиВПТУ.УстановитьПараметр("ШтрихКодПолный"  , ШтрихКодПолный);
	
	РезультатЗапроса = ЗапросМаркировкиВПТУ.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();

КонецФункции

&НаСервере
Функция МаркировкаЕстьВОжидаемых(ШтрихКодКраткий, ШтрихКодПолный, ДокументГУИД) Экспорт
	
	//+Шульман А. 17.03.2026 #UT10-5748
	Результат = Новый Структура("ЕстьМаркировка, Невалиден, Причина", Ложь, Ложь, ""); 
	//-Шульман А. 17.03.2026 #UT10-5748
	
	Набор = РегистрыСведений.СписокОжидаемыхМаркировокДокументаПТУ.СоздатьНаборЗаписей();
	Набор.Отбор.СсылкаПТУ.Установить(ДокументГУИД);
	Набор.Прочитать();
	
	Если Набор.Количество() = 0 Тогда   
		//+Шульман А. 17.03.2026 #UT10-5748
		//Возврат Истина;  
		Возврат Результат;   
		//-Шульман А. 17.03.2026 #UT10-5748
	КонецЕсли;
	
	ЗапросОбязательныхМаркировокВПТУ = Новый Запрос;
	ЗапросОбязательныхМаркировокВПТУ.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СписокОжидаемыхМаркировокДокументаПТУ.КодМаркировки КАК КодМаркировки,   
	//+Шульман А. 17.03.2026 #UT10-5748
	|	СписокОжидаемыхМаркировокДокументаПТУ.Невалиден КАК Невалиден,
	|	СписокОжидаемыхМаркировокДокументаПТУ.Причина КАК Причина    
	//-Шульман А. 17.03.2026 #UT10-5748
	|ИЗ
	|	РегистрСведений.СписокОжидаемыхМаркировокДокументаПТУ КАК СписокОжидаемыхМаркировокДокументаПТУ
	|ГДЕ
	|	СписокОжидаемыхМаркировокДокументаПТУ.СсылкаПТУ = &ДокументГУИД
	|	И (СписокОжидаемыхМаркировокДокументаПТУ.ШтрихКод = &ШтрихКодКраткий
	|			ИЛИ СписокОжидаемыхМаркировокДокументаПТУ.ШтрихКод = &ШтрихКодПолный)" ;
	
	ЗапросОбязательныхМаркировокВПТУ.УстановитьПараметр("ДокументГУИД"    , ДокументГУИД);
	ЗапросОбязательныхМаркировокВПТУ.УстановитьПараметр("ШтрихКодКраткий" , ШтрихКодКраткий);
	ЗапросОбязательныхМаркировокВПТУ.УстановитьПараметр("ШтрихКодПолный"  , ШтрихКодПолный);
	
	РезультатЗапроса = ЗапросОбязательныхМаркировокВПТУ.Выполнить(); 
	
	//+Шульман А. 17.03.2026 #UT10-5748
	//Возврат Не РезультатЗапроса.Пустой();   
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Результат.ЕстьМаркировка = Истина;
		Результат.Невалиден = Выборка.Невалиден;
		Результат.Причина = Выборка.Причина;   
		Возврат Результат;
	
	КонецЕсли;
	//-Шульман А. 17.03.2026 #UT10-5748    
	
КонецФункции

&НаСервере
Функция НайтиГМПоШтрихкоду(Штрихкод, ТипДокумента, ДокументГУИД, ПолучитьТабЗнач = Ложь) Экспорт
	
	РезультатОтвета = ПолучитьСтруктуруОтвета(); 
	РезультатОтвета.Вставить("Результат", Ложь);
	ПользовательГУИД = ОбщегоНазначения.ПолучитьПользователяГУИД();
	
	Для НомерПопытки = 1 По Константы.КоличествоПопытокПодключения.Получить() Цикл			
		
		Попытка
			WSОпределение = Новый WSОпределения(ПолучитьАдресВебСервиса(), , , , ПолучитьTimeout());
			WSПрокси = Новый WSПрокси(WSОпределение, WSОпределение.Сервисы[0].URIПространстваИмен, WSОпределение.Сервисы[0].Имя, WSОпределение.Сервисы[0].Имя + "Soap" );			
			//WSПрокси.Пользователь = "webadmin";              
			//WSПрокси.Пароль = "web";		
			
			Ответ = WSПрокси.FindGMByBarcode(ПользовательГУИД, Штрихкод, ТипДокумента, ДокументГУИД, ПолучитьТабЗнач);
			РезультатОтвета = ОбработатьОтветWebService(РезультатОтвета, Ответ);				
			
			Прервать;                                                                      
			
		Исключение
			
			РезультатОтвета.Вставить("Ошибка", "Ошибка получения данных.");
			ASK_ОбработкаОшибок.Ошибка("#Ошибка подключения к Web Service", "Ошибка получения данных." + ОписаниеОшибки(), "НайтиГМПоШтрихкоду");
			
		КонецПопытки; 
		
	КонецЦикла;
	
	Возврат РезультатОтвета;
	                                                                        
КонецФункции

&НаСервере
Функция ОтправитьЛогиТСДвУТ10() Экспорт
	
	РезультатОтвета = ПолучитьСтруктуруОтвета(); 
	РезультатОтвета.Вставить("Результат", Ложь);
	ПользовательГУИД = ОбщегоНазначения.ПолучитьПользователяГУИД();
	
	//+Шульман А. 05.12.2025 #UT10-5576
	//ТЗ = ВыгрузитьРегистрСведений("ЛогОшибок");
	ТЗ = ВыгрузитьРегистрСведений("РасширенныйЛог");       
	//-Шульман А. 05.12.2025 #UT10-5576
	
	Если ТЗ.Количество() = 0 Тогда
		
		РезультатОтвета.Вставить("Ошибка", "Отсутствуют логи ТСД. Отправка невозможна.");
		Возврат РезультатОтвета;
		
	КонецЕсли; 
	
	ТЗ.Сортировать("НомерЗаписи");   
	
	//+Шульман А. 05.12.2025 #UT10-5576
	НомерЗаписи = 1;  
	
	Для каждого тзСтрока Из ТЗ Цикл
		
		тзСтрока.НомерЗаписи = НомерЗаписи;    
		НомерЗаписи = НомерЗаписи + 1;
		
	КонецЦикла;
	//-Шульман А. 05.12.2025 #UT10-5576
	
	ТЗ.Колонки.Добавить("ДатаСоздания", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки()));		
	
	Для каждого Строка Из ТЗ Цикл  
		//+Шульман А. 05.12.2025 #UT10-5576
		//Строка.ДатаСоздания = Строка(Строка.Период);     
		Строка.ДатаСоздания = Строка(Строка.ДатаЗаписи);   
		//-Шульман А. 05.12.2025 #UT10-5576
	КонецЦикла; 
	
	//ТЗ = ТЗ.Скопировать( , "ДатаСоздания, Индентификатор, Комментарий, Событие, ФункцияИсточник");
	Результат = ТаблицуВМассив(ТЗ);
	СериализованныеЛоги = ДанныеВJSONХранилище( Результат );
		
	Для НомерПопытки = 1 По Константы.КоличествоПопытокПодключения.Получить() Цикл			
		
		Попытка
			WSОпределение = Новый WSОпределения(ПолучитьАдресВебСервиса(), , , , ПолучитьTimeout());
			WSПрокси = Новый WSПрокси(WSОпределение, WSОпределение.Сервисы[0].URIПространстваИмен, WSОпределение.Сервисы[0].Имя, WSОпределение.Сервисы[0].Имя + "Soap" );			
			//WSПрокси.Пользователь = "webadmin";              
			//WSПрокси.Пароль = "web";		
			
			Ответ = WSПрокси.SendLogsFromTSD(ПользовательГУИД, СериализованныеЛоги);
			РезультатОтвета = ОбработатьОтветWebService(РезультатОтвета, Ответ);				
			
			Прервать;
			
		Исключение
			
			РезультатОтвета.Вставить("Ошибка", "Ошибка отправки логов ТСД.");
			ASK_ОбработкаОшибок.Ошибка("#Ошибка подключения к Web Service", "Ошибка отправки данных." + ОписаниеОшибки(), "SendLogsFromTSD");
			
		КонецПопытки; 
		
	КонецЦикла;
	
	Возврат РезультатОтвета;
	
КонецФункции 

&НаСервере
Функция НайтиТоварПоШтрихкодуСОстатками(Штрихкод, ТоварГУИД) Экспорт
	
	РезультатОтвета = ПолучитьСтруктуруОтвета(); 
	РезультатОтвета.Вставить("Результат", Ложь);
	ПользовательГУИД = ОбщегоНазначения.ПолучитьПользователяГУИД();
	
	Для НомерПопытки = 1 По Константы.КоличествоПопытокПодключения.Получить() Цикл			
		
		Попытка
			WSОпределение = Новый WSОпределения(ПолучитьАдресВебСервиса(), , , , ПолучитьTimeout());
			WSПрокси = Новый WSПрокси(WSОпределение, WSОпределение.Сервисы[0].URIПространстваИмен, WSОпределение.Сервисы[0].Имя, WSОпределение.Сервисы[0].Имя + "Soap" );			
			//WSПрокси.Пользователь = "webadmin";              
			//WSПрокси.Пароль = "web";		
			                 
			Ответ = WSПрокси.FindGoodByBarcodeWithRemains(Штрихкод, ТоварГУИД, ПользовательГУИД);
			РезультатОтвета = ОбработатьОтветWebService(РезультатОтвета, Ответ);				
			Если Не ЗначениеЗаполнено(РезультатОтвета.Ошибка) Тогда
				ЗаписатьРегистрСведений("СписокНайденныхТоваровПоШтрихкоду", РезультатОтвета.Данные);
			КонецЕсли; 
			
			Прервать;
			
		Исключение
			
			РезультатОтвета.Вставить("Ошибка", "Ошибка получения данных.");
			ASK_ОбработкаОшибок.Ошибка("#Ошибка подключения к Web Service", "Ошибка получения данных." + ОписаниеОшибки(), "НайтиТоварПоШтрихкоду");
			
		КонецПопытки; 
		
	КонецЦикла;
	
	Возврат РезультатОтвета;
	                                                                       
КонецФункции

&НаСервере
Функция ЗаменитьНедопустимыеСимволыXML(Знач Текст, СимволЗамены = "") Экспорт
	
	ПозицияНачала = 1;
	
	Пока Истина Цикл
		
		Позиция = НайтиНедопустимыеСимволыXML(Текст, ПозицияНачала);
		
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если Позиция > 1 Тогда
			
			НедопустимыйСимвол = Сред(Текст, Позиция - 1, 1);
			
			Если НайтиНедопустимыеСимволыXML(НедопустимыйСимвол) > 0 Тогда
				Текст = СтрЗаменить(Текст, НедопустимыйСимвол, СимволЗамены);
			КонецЕсли;
			
		КонецЕсли;
		
		НедопустимыйСимвол = Сред(Текст, Позиция, 1);
		
		Если НайтиНедопустимыеСимволыXML(НедопустимыйСимвол) > 0 Тогда
			Текст = СтрЗаменить(Текст, НедопустимыйСимвол, СимволЗамены);
		КонецЕсли;
		
		ПозицияНачала = Позиция + 1;
		
	КонецЦикла;

	Возврат Текст;

КонецФункции

&НаСервере                                                                   
Функция ПолучитьЗначениеШтрихкода(Значение, СимволЗамены = "") Экспорт
	
	//+Шульман А. 05.12.2025 #UT10-5576           
	ЗаписыватьРасширенныеЛоги = Константы.ЗаписыватьРасширенныеЛоги.Получить();
	
	//Если ЗаписыватьРасширенныеЛоги Тогда    
	//	ASK_ОбработкаОшибок.ПолучитьСтекВызовов("ПолучитьЗначениеШтрихкода", "Начало", Истина);     
	//КонецЕсли;       
	//-Шульман А. 05.12.2025 #UT10-5576
	
	Структура  = Новый Структура("Ошибка, Штрихкод", "", ""); 	    

	Попытка

		СимволРазделитель = Символ(29);
		Пока НЕ СтрНайти(Значение,СимволРазделитель) = 0 Цикл
			Значение = СтрЗаменить(Значение,СимволРазделитель, СимволЗамены);
		КонецЦикла;
		
		СимволРазделитель = "&#29;";
		Пока НЕ СтрНайти(Значение,СимволРазделитель) = 0 Цикл
			Значение = СтрЗаменить(Значение,СимволРазделитель, СимволЗамены);
		КонецЦикла;

	    Значение = ЗаменитьНедопустимыеСимволыXML(Значение);

		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(Значение);
		
		ПостроительDOM = Новый ПостроительDOM;			
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		
		//Разыменователь = Новый РазыменовательПространствИменDOM(ДокументDOM);
		РазыменовательПИ = ДокументDOM.СоздатьРазыменовательПИ(ДокументDOM);
		ЗапросXPath = "/MessageData/FilterData";
		Путь = ДокументDOM.СоздатьВыражениеXPath(ЗапросXPath, РазыменовательПИ);			
		РезультатPath = Путь.Вычислить(ДокументDOM);    
		ОбработкаРезультата = РезультатPath.ПолучитьСледующий();
			
	Исключение                                                   
		
		Если ЗаписыватьРасширенныеЛоги Тогда    
			ASK_ОбработкаОшибок.ПолучитьСтекВызовов("ПолучитьЗначениеШтрихкода", "Ошибка " + ОписаниеОшибки(), Истина);     
		КонецЕсли;       
		
		Структура.Вставить("Ошибка", ОписаниеОшибки());
		Возврат Структура;
		
	КонецПопытки; 
	
	Если ОбработкаРезультата.ТекстовоеСодержимое = "READ_FAIL" Тогда
		
		Структура.Вставить("Ошибка", "Ошибка сканирования штрихкода - " + ОбработкаРезультата.ТекстовоеСодержимое + " "+СокрЛП(Значение));
		Возврат Структура;
		
	КонецЕсли;             	
	
	Структура.Вставить("Штрихкод", ОбработкаРезультата.ТекстовоеСодержимое);
	
	//+Шульман А. 05.12.2025 #UT10-5576           
	//Если ЗаписыватьРасширенныеЛоги Тогда    
	//	ASK_ОбработкаОшибок.ПолучитьСтекВызовов("ПолучитьЗначениеШтрихкода", ОбработкаРезультата.ТекстовоеСодержимое, Истина);     
	//КонецЕсли;       
	//-Шульман А. 05.12.2025 #UT10-5576           
	
	Возврат Структура;
	
КонецФункции

