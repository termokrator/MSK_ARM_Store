Функция ЗагрузитьСписокСлужебныхЗаписок(ДокументСсылка = "", ДокументГУИД = "") Экспорт

	РезультатОтвета = ПолучитьСтруктуруОтвета();	
	ПользовательГУИД = ОбщегоНазначения.ПолучитьПользователяГУИД();
	
	Для НомерПопытки = 1 По Константы.КоличествоПопытокПодключения.Получить() Цикл		
	
		Попытка
			WSОпределение = Новый WSОпределения(ПолучитьАдресВебСервиса(), , , , ПолучитьTimeout());
			WSПрокси = Новый WSПрокси(WSОпределение, WSОпределение.Сервисы[0].URIПространстваИмен, WSОпределение.Сервисы[0].Имя, WSОпределение.Сервисы[0].Имя + "Soap" );			
	
			Ответ = WSПрокси.GetListOfIncomingMemo( "", ДокументГУИД, ПользовательГУИД);
			РезультатОтвета = ОбработатьОтветWebService(РезультатОтвета, Ответ);		
			
			Если Не ЗначениеЗаполнено(РезультатОтвета.Ошибка) Тогда
				ЗаписатьРегистрСведений("СписокСлужебныхЗаписок", РезультатОтвета.Данные);
			КонецЕсли; 
			
			Прервать;
			
		Исключение 
			
			РезультатОтвета.Вставить("Ошибка", "Ошибка получения данных.");
			ASK_ОбработкаОшибок.Ошибка("#Ошибка подключения к Web Service", "Ошибка получения данных." + ОписаниеОшибки(), "ЗагрузитьСписокНепроведенныхДокументовПТУ");			
			
		КонецПопытки;                                                                                                                                                       
	
	КонецЦикла;
		                                                       
	Возврат РезультатОтвета;

КонецФункции

&НаСервере
Функция ЗагрузитьСписокОбъединений(Завершенные = Ложь, Записывать = Истина, ДокументГУИД = "") Экспорт

	РезультатОтвета = ПолучитьСтруктуруОтвета();	
	ПользовательГУИД = ОбщегоНазначения.ПолучитьПользователяГУИД();
	
	Для НомерПопытки = 1 По Константы.КоличествоПопытокПодключения.Получить() Цикл		
	
		Попытка
			
			WSОпределение = Новый WSОпределения(ПолучитьАдресВебСервиса(), , , , ПолучитьTimeout());
			WSПрокси = Новый WSПрокси(WSОпределение, WSОпределение.Сервисы[0].URIПространстваИмен, WSОпределение.Сервисы[0].Имя, WSОпределение.Сервисы[0].Имя + "Soap" );			
	
			Ответ = WSПрокси.GetListOfUnion(ПользовательГУИД, ДокументГУИД, Завершенные);
			РезультатОтвета = ОбработатьОтветWebService(РезультатОтвета, Ответ);		
			
			Если Не ЗначениеЗаполнено(РезультатОтвета.Ошибка) И Записывать Тогда
				ЗаписатьРегистрСведений("СписокОбъединений" + ?(Завершенные, "Завершенные", ""), РезультатОтвета.Данные);
			КонецЕсли; 
			
			Прервать;
			
		Исключение 
			
			РезультатОтвета.Вставить("Ошибка", "Ошибка получения данных.");
			ASK_ОбработкаОшибок.Ошибка("#Ошибка подключения к Web Service", "Ошибка получения данных." + ОписаниеОшибки(), "ЗагрузитьСписокОбъединений");			
			
		КонецПопытки;                                                                                                                                                       
	
	КонецЦикла;
		                                                       
	Возврат РезультатОтвета;
 
КонецФункции

&НаСервере
Функция ОткрытьЗакрытьТЕ(ОбъединениеГУИД) Экспорт
	
	СтруктураОтвета = Новый Структура("Результат, Сообщение", Ложь, "");
	
	ПользовательГУИД = ОбщегоНазначения.ПолучитьПользователяГУИД();
	
	Для НомерПопытки = 1 По Константы.КоличествоПопытокПодключения.Получить() Цикл		
		
		Попытка
			
			WSОпределение = Новый WSОпределения(ПолучитьАдресВебСервиса(), , , , ПолучитьTimeout());
			WSПрокси = Новый WSПрокси(WSОпределение, WSОпределение.Сервисы[0].URIПространстваИмен, WSОпределение.Сервисы[0].Имя, WSОпределение.Сервисы[0].Имя + "Soap" );			
			
			Ответ = WSПрокси.OpenCloseTE(ОбъединениеГУИД, ПользовательГУИД); 
			
			СтруктураОтвета = ХранилищеJSONВСтруктуру(Ответ);
			
			Прервать;
			
		Исключение                                       		
			СтруктураОтвета.Сообщение = ОписаниеОшибки();		
		КонецПопытки;                                                                                                                                                       
	
	КонецЦикла;
		                                                       
	Возврат СтруктураОтвета;

КонецФункции

&НаСервере
Функция ПолучитьСписокГрузовыхМестСлужебныхЗаписок(СлужебнаяЗапискаГУИД, ПолучитьВсеЗаписи = Ложь) Экспорт

	РезультатОтвета = ПолучитьСтруктуруОтвета();
	РезультатОтвета.Вставить("Результат", Ложь);
	ПользовательГУИД = ОбщегоНазначения.ПолучитьПользователяГУИД();
	
	Для НомерПопытки = 1 По Константы.КоличествоПопытокПодключения.Получить() Цикл		
	
		Попытка
			WSОпределение = Новый WSОпределения(ПолучитьАдресВебСервиса(), , , , ПолучитьTimeout());
			WSПрокси = Новый WSПрокси(WSОпределение, WSОпределение.Сервисы[0].URIПространстваИмен, WSОпределение.Сервисы[0].Имя, WSОпределение.Сервисы[0].Имя + "Soap" );			
			
			Ответ = WSПрокси.GetListCargoIncomingMemo(СлужебнаяЗапискаГУИД , ПользовательГУИД);
			РезультатОтвета = ОбработатьОтветWebService(РезультатОтвета, Ответ);		
			
			Если Не ЗначениеЗаполнено(РезультатОтвета.Ошибка) Тогда
				ЗаписатьРегистрСведений("СписокГрузовыхМестСлужебныеЗаписки", РезультатОтвета.Данные);
			КонецЕсли;                     
			
			Прервать;
			
		Исключение
			РезультатОтвета.Вставить("Ошибка", "Ошибка получения данных.");
			ASK_ОбработкаОшибок.Ошибка("#Ошибка подключения к Web Service", "Ошибка получения данных." + ОписаниеОшибки(), "ЗагрузитьСписокГрузовыхМест");			
		КонецПопытки; 
		
	КонецЦикла;
		                                                       
	Возврат РезультатОтвета;

КонецФункции

&НаСервере
Процедура ОбработатьЗагруженныеДанныеСпискаПТУ()
	
	Выборка = РегистрыСведений.СписокДокументовПТУ.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = Выборка.ПолучитьМенеджерЗаписи();
		Запись.Прочитать();

		Если Выборка.ПриемкаГМ Тогда
			
			Запись.ВсегоСтрокСТР = Строка(Запись.КоличествоОсталостьРазместитьСтрокГМ);
			Запись.ОсталосьРазместитьСТР = Строка(Запись.КоличествоОсталостьРазместитьСтрокГМ);
			Запись.СтрокНеРазмещеноСТР = Строка(Запись.КоличествоСтрокВБуфереСотрудника); 
			
			
		Иначе
			
			Запись.ВсегоСтрокСТР = Строка(Запись.КоличествоНеРазмещеннныхСтрокНоменклатуры);
			Запись.ОсталосьРазместитьСТР = Строка(Запись.КоличествоОсталостьРазместитьСтрокНоменклатуры);
			Запись.СтрокНеРазмещеноСТР = Строка(Запись.КоличествоСтрокВБуфереСотрудника); 
			
		КонецЕсли;
		
		Запись.Записать(); 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Функция ЗаписатьРегистрСведений(ИмяРегистра, СписокДанных, УдалятьТекущиеДанныеРС = Истина) Экспорт
	                      
	РегСведНабор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	
	Если УдалятьТекущиеДанныеРС = Истина Тогда
		РегСведНабор.Записать();
	КонецЕсли; 
	
	НомерЗаписи = 1;
	
	Для каждого Данные Из СписокДанных Цикл
		
		НоваяЗапись = РегСведНабор.Добавить();	
		
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Данные);		
		
		Если ИмяРегистра = "СписокДокументовПТУ" Тогда
			
			НоваяЗапись.ДатаДокумента = ПреобразоватьДату(Данные.ДатаДокумента);
			НоваяЗапись.НомерДокументаОформление = НоваяЗапись.НомерДокумента + " от " + СТРОКА(Формат(НоваяЗапись.ДатаДокумента, "ДФ=dd.MM.yyyy")) + "г.";    
			НоваяЗапись.ПриемкаГМ = Данные.ПриемкаГМ;
			       
		КонецЕсли;			
		
		Если ИмяРегистра = "СписокНепроведенныхДокументовПТУ" Тогда
			
			НоваяЗапись.ДатаДокумента = ПреобразоватьДату(Данные.ДатаДокумента);
			НоваяЗапись.НомерДокументаОформление = ?(НоваяЗапись.Транзит,"(Транзит)","")+НоваяЗапись.НомерДокумента + " от " + СТРОКА(Формат(НоваяЗапись.ДатаДокумента, "ДФ=dd.MM.yyyy")) + "г.";    
			НоваяЗапись.КоличествоСтрокОформление = " "+Строка(НоваяЗапись.КоличествоСтрок)+" стр.";  
			НоваяЗапись.ДатаВходящегоДокумента = ПреобразоватьДату(Данные.ДатаВходящегоДокумента);
			
		КонецЕсли;
		
		Если ИмяРегистра = "СписокСлужебныхЗаписок" Тогда
			
			НоваяЗапись.ДатаДокумента = ПреобразоватьДату(Данные.ДатаДокумента);
			НоваяЗапись.НомерДокументаОформление = НоваяЗапись.НомерДокумента + " от " + СТРОКА(Формат(НоваяЗапись.ДатаДокумента, "ДФ=dd.MM.yyyy")) + "г.";    
			НоваяЗапись.КоличествоГрузоместОформление = " "+Строка(НоваяЗапись.КоличествоГрузомест)+" гм ";  
			
		КонецЕсли;

		Если ИмяРегистра = "СписокТоваровВБуфереРазмещение" Или ИмяРегистра = "СписокТоваровВБуфереПеремещения" Тогда
			
			НоваяЗапись.НомерЗаписи = НомерЗаписи;
			НомерЗаписи = НомерЗаписи + 1;
			НоваяЗапись.КодПроизводителяТовара = СтрЗаменить(НоваяЗапись.КодПроизводителяТовара, " ", "");
			НоваяЗапись.КодПроизводителяТовара = СтрЗаменить(НоваяЗапись.КодПроизводителяТовара, ".", "");
			НоваяЗапись.КодПроизводителяТовара = СтрЗаменить(НоваяЗапись.КодПроизводителяТовара, "_", "");	
			
		КонецЕсли;
		
		Если ИмяРегистра = "СписокОбъединений" ИЛИ ИмяРегистра = "СписокОбъединенийЗавершенные" Тогда
			
			НоваяЗапись.ДатаДокумента = ПреобразоватьДату(Данные.ДатаДокумента);
			НоваяЗапись.НомерДокументаОформление = НоваяЗапись.НомерДокумента + " от " + СТРОКА(Формат(НоваяЗапись.ДатаДокумента, "ДФ=dd.MM.yyyy")) + "г.";    
			
		КонецЕсли;
		
		Если ИмяРегистра = "СписокТоваровДокументаПТУ" Тогда
			Размещено = НоваяЗапись.КоличествоТовараНабрано + НоваяЗапись.КоличествоВРазмещении;
			НоваяЗапись.КоличествоОформление = Строка(Размещено) + " из " + Строка(НоваяЗапись.КоличествоТовара);
		КонецЕсли; 
		
		Если ИмяРегистра = "СписокТоваровДляВыбора" Тогда
			НоваяЗапись.КоличествоОстаток = "Кол.: " + Строка(НоваяЗапись.КоличествоОстаток);
		КонецЕсли; 
		
		Если ИмяРегистра = "СписокНайденныхТоваровПоШтрихкоду" Тогда
			НоваяЗапись.НомерЗаписи = НомерЗаписи;
			НомерЗаписи = НомерЗаписи + 1;
		КонецЕсли;     
		
		Если ИмяРегистра = "СписокТоваровВБуфереРазмещениеГМ" Тогда
			НоваяЗапись.НомерЗаписи = НомерЗаписи;
			НомерЗаписи = НомерЗаписи + 1;	
		КонецЕсли;
		
		Если ИмяРегистра = "СписокТоваровВБуфереМаркировок" Тогда
			НоваяЗапись.НомерЗаписи = НомерЗаписи;
			НомерЗаписи = НомерЗаписи + 1;	
		КонецЕсли;
		
		Если ИмяРегистра = "СписокТоваровЯчейки" Тогда
			НоваяЗапись.КоличествоОстатокСтр = ?(НоваяЗапись.КоличествоОстаток >= 1000,Строка(НоваяЗапись.КоличествоОстаток),"Кол.: " + Строка(НоваяЗапись.КоличествоОстаток));
			НоваяЗапись.КоличествоОписаниеОткуда = Строка(НоваяЗапись.КоличествоТовараНабрано) + " из " + Строка(НоваяЗапись.КоличествоОстаток);
			НоваяЗапись.КоличествоОписаниеКуда = "Кол.: " + Строка(НоваяЗапись.КоличествоОстаток);			
			НоваяЗапись.Ячейка = СтрЗаменить(НоваяЗапись.Ячейка, "-", "");
		КонецЕсли; 
		
		Если ИмяРегистра = "СписокТоваровВБуфереПеремещения"  Тогда
			НоваяЗапись.КоличествоТовараСтр = "Кол.: " + Строка(НоваяЗапись.КоличествоТовара);	
			НоваяЗапись.ЯчейкаОткуда = СтрЗаменить(НоваяЗапись.ЯчейкаОткуда, "-", "");
			НоваяЗапись.ЯчейкаКуда = СтрЗаменить(НоваяЗапись.ЯчейкаКуда, "-", "");
		КонецЕсли; 
		
		Если ИмяРегистра = "СписокЗаданийНаДоставку" Тогда
			НоваяЗапись.ДатаДокумента = ПреобразоватьДату(Данные.ДатаДокумента);
			НоваяЗапись.ОписаниеДокумента = НоваяЗапись.Номер + " от " + Формат(НоваяЗапись.ДатаДокумента,"ДЛФ=Д");
		КонецЕсли; 
		
		Если ИмяРегистра = "СписокМаршрутовДляПриемкиГрузовыхМест" Тогда      
			НоваяЗапись.ЗаданиеНаДоставкуДата = ПреобразоватьДату(Данные.ЗаданиеНаДоставкуДата);
			НоваяЗапись.ОписаниеДокумента = НоваяЗапись.ЗаданиеНаДоставкуНомер + " от " + Формат(НоваяЗапись.ЗаданиеНаДоставкуДата,"ДЛФ=Д");
		КонецЕсли; 
		
		Если ИмяРегистра = "СписокЗаданийНаИнвентаризацию" Тогда
			НоваяЗапись.ДатаДокумента = ПреобразоватьДату(Данные.ДатаДокумента);
			НоваяЗапись.НомерДокументаОформление = НоваяЗапись.НомерДокумента + " от " 
						+ СТРОКА(Формат(НоваяЗапись.ДатаДокумента, "ДФ=dd.MM.yyyy")) + "г."
						+ " (" + СТРОКА(НоваяЗапись.Уровень) + ")";
			НоваяЗапись.КодЯчейкиОтформат =  СтрЗаменить(НоваяЗапись.КодЯчейки , "-",""); 
		КонецЕсли; 
		
		Если ИмяРегистра = "СписокТоваровВБуфереИнвентаризации" Тогда			
			НоваяЗапись.НомерЗаписи = НомерЗаписи;
			НомерЗаписи = НомерЗаписи + 1;
			
			НоваяЗапись.КодПроизводителяТовара = СтрЗаменить(НоваяЗапись.КодПроизводителяТовара, " ", "");
			НоваяЗапись.КодПроизводителяТовара = СтрЗаменить(НоваяЗапись.КодПроизводителяТовара, ".", "");
			НоваяЗапись.КодПроизводителяТовара = СтрЗаменить(НоваяЗапись.КодПроизводителяТовара, "_", "");			
			                                                                                                          
			НоваяЗапись.КоличествоОстатокСтр = "Кол.: " + Строка(НоваяЗапись.КоличествоТовара);
		КонецЕсли; 
		
		Если ИмяРегистра = "СписокГрузовыхМестИзРазгрузкиАвтоДляПостановкиНаМаршрут" Тогда			 
			НоваяЗапись.ГрузовоеМестоНомер = "ГМ" + Формат(Число(НоваяЗапись.ГрузовоеМестоНомер), "ЧГ=0");	
		КонецЕсли;                                   
		
		Если ИмяРегистра = "СписокГрузовыхМестИзРазгрузкиАвто" Тогда			 
			НоваяЗапись.ГрузовоеМестоНомер = "ГМ" + Формат(Число(НоваяЗапись.ГрузовоеМестоНомер), "ЧГ=0");	
		КонецЕсли;                                                             

		Если ИмяРегистра = "СписокСборокДляЗаблокированнойЯчейки" Тогда
			НоваяЗапись.СборкаДата = ПреобразоватьДату(Данные.СборкаДата);			
			НоваяЗапись.НомерДокументаОформление = НоваяЗапись.СборкаНомер + " от " + Формат(НоваяЗапись.СборкаДата, "ДФ=dd.MM.yyyy") + " г.";			
		КонецЕсли;
		
		//+Сёмин Р. 19.12.2025 #UT10-5593
		Если ИмяРегистра = "СписокТранспортныхЕдиниц" Тогда
			НоваяЗапись.ДатаДокумента = ПреобразоватьДату(Данные.ДатаДокумента);
			НоваяЗапись.НомерДокументаОформление = НоваяЗапись.НомерДокумента + " от " + СТРОКА(Формат(НоваяЗапись.ДатаДокумента, "ДФ=dd.MM.yyyy")) + "г.";
			НоваяЗапись.ДатаВходящегоДокумента = ПреобразоватьДату(Данные.ДатаВходящегоДокумента);
		КонецЕсли;
		//-Сёмин Р. 19.12.2025 #UT10-5593
		
		НоваяЗапись.ДатаЗагрузки = ТекущаяДата();		
		
	КонецЦикла; 
	
	Попытка
		РегСведНабор.Записать(Ложь);		
	Исключение
		
	КонецПопытки

КонецФункции

&НаСервере
Функция ПреобразоватьДату(СтроковаяДата) 
	
	СтроковаяДата = СтрЗаменить(СтроковаяДата , "-",""); 
	СтроковаяДата = СтрЗаменить(СтроковаяДата , ":","");
	СтроковаяДата = СтрЗаменить(СтроковаяДата , "T","");
	Возврат Дата(СтроковаяДата);
	
КонецФункции

&НаСервере
