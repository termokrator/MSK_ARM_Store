КонецФункции // ()

Функция РазложитьКодМаркировки(ПромШтрихКод, ЧастиКода, ЗамерятьВремя = Ложь) Экспорт
	
	//+Шульман А. 17.11.2025 #UT10-5516	                                  
	//ASK_ОбработкаОшибок.Ошибка("начало", ПромШтрихКод, "РазложитьКодМаркировки");
	РасширеннаяПроверкаВалидности = Константы.РасширеннаяПроверкаВалидностиКодовМаркировкиЧЗ.Получить();
	
	//+Сёмин Р.И. 29.04.2026 #UT10-5814
	ИспользоватьНовыйМеханизмПроверкиКодовМаркировки = Константы.ИспользоватьНовыйМеханизмПроверкиКодовМаркировки.Получить();
	//-Сёмин Р.И. 29.04.2026 #UT10-5814
	
	ДанныеШтрихкода = Новый Структура("ЭтоКодМаркировки, ПройденаПроверкаКраткогоКода, ШтрихКодКраткий, ШтрихКодПолный, ЧастиКода", Ложь, Ложь, "", "", ЧастиКода);  
	ДанныеШтрихкода.Вставить("ТекстОшибки", "");
	ПровКод = ПромШтрихКод;
	
	НачВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТекВремя = 0;
	
	Если ЗамерятьВремя Тогда
		
		ЗамерыВремени = Новый Структура();   
		ДанныеШтрихкода.Вставить("ЗамерыВремени", ЗамерыВремени);                           
		
		ЗамерыВремени.Вставить("НачалоПроверкиВалидности", 0);  
	
	КонецЕсли;
	
	//+Шульман А. 17.12.2025 #UT10-5597
	//Если РасширеннаяПроверкаВалидности И (Не ЧастиКода.Свойство("GS1") Или Не ЧастиКода.Свойство("GS2")) Тогда   
	Если РасширеннаяПроверкаВалидности И Не ЧастиКода.Свойство("GS1") Тогда     
	//-Шульман А. 17.12.2025 #UT10-5597    
		ДанныеШтрихкода.Вставить("ТекстОшибки", "Нет GS1");
		Возврат ДанныеШтрихкода;
	КонецЕсли;
	
	Если РасширеннаяПроверкаВалидности И ЧастиКода.Свойство("GS3") Тогда  
		ДанныеШтрихкода.Вставить("ТекстОшибки", "Лишние GS");
		Возврат ДанныеШтрихкода;
	КонецЕсли;
	
	
	// Проверка 01 
	ЕстьСкобки = Ложь;
	
	Если Лев(ПровКод, 2) = "01" Тогда     
		
		ЧастиКода.Вставить("S01", Лев(ПровКод, 2));   
		ПровКод = Сред(ПровКод, 3);   
		
	ИначеЕсли Лев(ПровКод, 4) = "(01)" Тогда     
		
		ЧастиКода.Вставить("S01", Лев(ПровКод, 4));    
		ПровКод = Сред(ПровКод, 5);   
		ЕстьСкобки = Истина;
		
	Иначе                       
		ДанныеШтрихкода.Вставить("ТекстОшибки", "Нет 01");
		Возврат ДанныеШтрихкода;
	КонецЕсли;
	
	Если ЗамерятьВремя Тогда
		
		ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
		ЗамерыВремени.Вставить("S01", ВремяСНачала - ТекВремя);    
		ТекВремя = ЗамерыВремени.S01;
		
	КонецЕсли;

	//GTINGTINGTINGT21SERIALSERIALSx91KEYKx92CRIPTOCRIPT...
	ЧастиКода.Вставить("GTIN", Лев(ПровКод, 14));  
	ПровКод = Сред(ПровКод, 15);   
	
	Если ПустаяСтрока(ПровКод) Тогда   
		ДанныеШтрихкода.Вставить("ТекстОшибки", "Длина кода " + СтрДлина(ПромШтрихКод) + " меньше ожидаемой");
		Возврат ДанныеШтрихкода;
	КонецЕсли;
	
	Если ЗамерятьВремя Тогда
		
		ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
		
		ЗамерыВремени.Вставить("GTIN", ВремяСНачала - ТекВремя); 
		ТекВремя = ЗамерыВремени.GTIN;
		
	КонецЕсли;
	
	//21SERIALSERIALSX91KEYKx92CRIPTOCRIPT...
	Если Лев(ПровКод, 2) = "21" И Не ЕстьСкобки Тогда     
		
		ЧастиКода.Вставить("S21", Лев(ПровКод, 2));
		ПровКод = Сред(ПровКод, 3);   
		
	ИначеЕсли Лев(ПровКод, 4) = "(21)" И ЕстьСкобки Тогда     
		
		ЧастиКода.Вставить("S21", Лев(ПровКод, 4));
		ПровКод = Сред(ПровКод, 5);   
		
	Иначе         
		ДанныеШтрихкода.Вставить("ТекстОшибки", "Нет 21");
		Возврат ДанныеШтрихкода;
	КонецЕсли;
	
	Если ЗамерятьВремя Тогда
		
		ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
		
		ЗамерыВремени.Вставить("S21", ВремяСНачала - ТекВремя);   
		ТекВремя = ЗамерыВремени.S21;

	КонецЕсли;
	
	//SERIALSERIALSx91KEYKx92CRIPTOCRIPT...
	//+Сёмин Р.И. 29.04.2026 #UT10-5814
	//ЧастиКода.Вставить("SERIAL", Лев(ПровКод, 13));
	
	ДлинаЧастиSERIAL = Неопределено;
	
	Если ИспользоватьНовыйМеханизмПроверкиКодовМаркировки И ЧастиКода.Свойство("GS1") И ЗначениеЗаполнено(ЧастиКода.GS1) Тогда
		
		ДлинаЧастиSERIAL = СтрДлина(ПровКод) + ЧастиКода.GS1 - 1 - СтрДлина(ПромШтрихКод);
		
		Если ДлинаЧастиSERIAL >= 6 И ДлинаЧастиSERIAL <= 20 Тогда
			ЧастиКода.Вставить("SERIAL", Лев(ПровКод, ДлинаЧастиSERIAL));
		Иначе
			
			ДанныеШтрихкода.Вставить("ТекстОшибки", "Некорректная длина части SERIAL");
			Возврат ДанныеШтрихкода;
			
		КонецЕсли;
		
	Иначе
		ЧастиКода.Вставить("SERIAL", Лев(ПровКод, 13));
	КонецЕсли;
	//-Сёмин Р.И. 29.04.2026 #UT10-5814
	
	ДанныеШтрихкода.ШтрихКодКраткий = "01" + ЧастиКода.GTIN + "21" + ЧастиКода.SERIAL;
	ДанныеШтрихкода.ШтрихКодПолный  = "(01)" + ЧастиКода.GTIN + "(21)" + ЧастиКода.SERIAL;   
	ДанныеШтрихкода.ПройденаПроверкаКраткогоКода = Истина;
	
	Если ЗамерятьВремя Тогда
		
		ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
		
		ЗамерыВремени.Вставить("SERIAL", ВремяСНачала - ТекВремя);   
		ТекВремя = ЗамерыВремени.SERIAL;
		
	КонецЕсли;
	
	Если Не РасширеннаяПроверкаВалидности Тогда   
		
		// Если не стоит константа РасширеннаяПроверкаВалидностиКодовМаркировкиЧЗ, то проверку заканчиваем
		ДанныеШтрихкода.ЭтоКодМаркировки = Истина;  
		
		Если ЗамерятьВремя Тогда   
			
			ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
			ДанныеШтрихкода.ЗамерыВремени.Вставить("ОкончаниеПроверкиВалидности", ВремяСНачала - ТекВремя);    
			
		КонецЕсли;
		
		Возврат ДанныеШтрихкода;        
		
	КонецЕсли;
	
	// Если указана константа РасширеннаяПроверкаВалидностиКодовМаркировкиЧЗ, то правильным считается только полный штрихкод
	//+Сёмин Р.И. 29.04.2026 #UT10-5814
	//ПровКод = Сред(ПровКод, 14);
	
	Если ЗначениеЗаполнено(ДлинаЧастиSERIAL) Тогда
		ПровКод = Сред(ПровКод, ДлинаЧастиSERIAL + 1);
	Иначе
		ПровКод = Сред(ПровКод, 14);
	КонецЕсли;
	//-Сёмин Р.И. 29.04.2026 #UT10-5814
	
	Если ПустаяСтрока(ПровКод) Тогда   
		
		Если ЗамерятьВремя Тогда   
			
			ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
			ДанныеШтрихкода.ЗамерыВремени.Вставить("ОкончаниеПроверкиВалидности", ВремяСНачала - ТекВремя);    
			
		КонецЕсли;
		
		ДанныеШтрихкода.Вставить("ТекстОшибки", "Короткий код. Нет 91, 93");
		Возврат ДанныеШтрихкода;
		
	КонецЕсли;
	
	//91KEYKx92CRIPTOCRIPT...    
	ЭтоКод93 = Истина;
	
	Если Лев(ПровКод, 2) = "91" И Не ЕстьСкобки Тогда     
		
		ЧастиКода.Вставить("S91", Лев(ПровКод, 2));
		
		Поз91 = СтрНайти(ПромШтрихКод, ПровКод);
		
		Если Не ЧастиКода.GS1 = Строка(Поз91) И РасширеннаяПроверкаВалидности Тогда 
			ДанныеШтрихкода.Вставить("ТекстОшибки", "GS1 не в той позиции. Ожидаемая позиция " + Строка(Поз91));
           	Возврат ДанныеШтрихкода;
		КонецЕсли;
		
		ПровКод = Сред(ПровКод, 3); 
		ЭтоКод93 = Ложь;
		
	ИначеЕсли Лев(ПровКод, 4) = "(91)" И ЕстьСкобки Тогда     
		
		ЧастиКода.Вставить("S91", Лев(ПровКод, 4));
		
		Поз91 = СтрНайти(ПромШтрихКод, ПровКод);
		
		Если Не ЧастиКода.GS1 = Строка(Поз91) И РасширеннаяПроверкаВалидности Тогда  
			ДанныеШтрихкода.Вставить("ТекстОшибки", "GS1 не в той позиции. Ожидаемая позиция " + Строка(Поз91));
           	Возврат ДанныеШтрихкода;
		КонецЕсли;
		
		ПровКод = Сред(ПровКод, 5); 
		ЭтоКод93 = Ложь;   
		
	КонецЕсли;
	
	Если ЗамерятьВремя И Не ЭтоКод93 Тогда
		
		ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
		
		ЗамерыВремени.Вставить("S91", ВремяСНачала - ТекВремя);   
		ТекВремя = ЗамерыВремени.S91;

	КонецЕсли;
	
	Если ЭтоКод93 Тогда
		
		//93KEYK    
		Если Лев(ПровКод, 2) = "93" И Не ЕстьСкобки Тогда     
			
			ЧастиКода.Вставить("S93", Лев(ПровКод, 2));  
			Поз91 = СтрНайти(ПромШтрихКод, ПровКод);
			
			Если РасширеннаяПроверкаВалидности И (Не ЧастиКода.GS1 = Строка(Поз91) Или ЧастиКода.Свойство("GS2")) Тогда  
				ДанныеШтрихкода.Вставить("ТекстОшибки", "GS1 не в той позиции. Ожидаемая позиция " + Строка(Поз91));
	           	Возврат ДанныеШтрихкода;
			КонецЕсли;
			
			ПровКод = Сред(ПровКод, 3); 
			
		ИначеЕсли Лев(ПровКод, 4) = "(93)" И ЕстьСкобки Тогда     
			
			ЧастиКода.Вставить("S93", Лев(ПровКод, 4));   
			Поз91 = СтрНайти(ПромШтрихКод, ПровКод);
			
			Если РасширеннаяПроверкаВалидности И (Не ЧастиКода.GS1 = Строка(Поз91) Или ЧастиКода.Свойство("GS2")) Тогда  
				ДанныеШтрихкода.Вставить("ТекстОшибки", "GS1 не в той позиции. Ожидаемая позиция " + Строка(Поз91));
	           	Возврат ДанныеШтрихкода;
			КонецЕсли;
			
			ПровКод = Сред(ПровКод, 5); 
			
		Иначе                      
			
			Если ЗамерятьВремя Тогда   
				
				ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
				ДанныеШтрихкода.ЗамерыВремени.Вставить("ОкончаниеПроверкиВалидности", ВремяСНачала - ТекВремя);    
				
			КонецЕсли;
			
			ДанныеШтрихкода.Вставить("ТекстОшибки", "Нет 91, 93");
			Возврат ДанныеШтрихкода;  
			
		КонецЕсли;                          
		
		Если ЗамерятьВремя Тогда
			
			ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
			
			ЗамерыВремени.Вставить("S93", ВремяСНачала - ТекВремя);   
			ТекВремя = ЗамерыВремени.S93;

		КонецЕсли;
		
	КонецЕсли;                          
	
	//+Шульман А. 17.12.2025 #UT10-5597
	Если РасширеннаяПроверкаВалидности И Не ЧастиКода.Свойство("GS2") Тогда  
		
		Если ЭтоКод93 Тогда  
			ДанныеШтрихкода.ЭтоКодМаркировки = Истина; 
		Иначе
			ДанныеШтрихкода.Вставить("ТекстОшибки", "Нет GS2");
		КонецЕсли;
		
		Возврат ДанныеШтрихкода;  
		
	КонецЕсли;      
	//-Шульман А. 17.12.2025 #UT10-5597
	
	//KEYKx92CRIPTOCRIPT... 
	ЧастиКода.Вставить("KEY", Лев(ПровКод, 4));   
	ПровКод = Сред(ПровКод, 5); 
	
	Если ЗамерятьВремя Тогда
		
		ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
		
		ЗамерыВремени.Вставить("KEY", ВремяСНачала - ТекВремя);   
		ТекВремя = ЗамерыВремени.KEY;

	КонецЕсли;
	
	Если ПустаяСтрока(ПровКод) Тогда    
		
		ДанныеШтрихкода.ЭтоКодМаркировки = Истина;     
		
		Если ЗамерятьВремя Тогда   
			
			ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
			ДанныеШтрихкода.ЗамерыВремени.Вставить("ОкончаниеПроверкиВалидности", ВремяСНачала - ТекВремя);    
			
		КонецЕсли;
		
		Возврат ДанныеШтрихкода;        
		
	КонецЕсли;
	
	
	//92CRIPTOCRIPT... 
	Если Лев(ПровКод, 2) = "92" И Не ЕстьСкобки Тогда     
		
		ЧастиКода.Вставить("S92", Лев(ПровКод, 2));  
		
		Поз92 = СтрНайти(ПромШтрихКод, ПровКод);
		
		Если Не ЧастиКода.GS2 = Строка(Поз92) И РасширеннаяПроверкаВалидности Тогда    
			ДанныеШтрихкода.Вставить("ТекстОшибки", "GS2 не в той позиции. Ожидаемая позиция " + Строка(Поз92));
           	Возврат ДанныеШтрихкода;
		КонецЕсли;
		
		ПровКод = Сред(ПровКод, 3);  
		
	ИначеЕсли Лев(ПровКод, 4) = "(92)" И ЕстьСкобки Тогда     
		
		ЧастиКода.Вставить("S92", Лев(ПровКод, 4));  
		
		Поз92 = СтрНайти(ПромШтрихКод, ПровКод);
		
		Если Не ЧастиКода.GS2 = Строка(Поз92) И РасширеннаяПроверкаВалидности Тогда   
			ДанныеШтрихкода.Вставить("ТекстОшибки", "GS2 не в той позиции. Ожидаемая позиция " + Строка(Поз92));
           	Возврат ДанныеШтрихкода;
		КонецЕсли;
		
		ПровКод = Сред(ПровКод, 5); 
		
	Иначе               
		
		Если ЗамерятьВремя Тогда   
			
			ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
			ДанныеШтрихкода.ЗамерыВремени.Вставить("ОкончаниеПроверкиВалидности", ВремяСНачала - ТекВремя);    
			
		КонецЕсли;
		
		ДанныеШтрихкода.Вставить("ТекстОшибки", "Нет 92");
		Возврат ДанныеШтрихкода;        
		
	КонецЕсли;
	
	Если ЗамерятьВремя Тогда
		
		ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
		
		ЗамерыВремени.Вставить("S92", ВремяСНачала - ТекВремя);   
		ТекВремя = ЗамерыВремени.S92;

	КонецЕсли;
	
	//CRIPTOCRIPT... 
	Если СтрДлина(ПровКод) = 44 Или СтрДлина(ПровКод) = 88 Тогда
		
		ЧастиКода.Вставить("CRIPTO", ПровКод);
		ДанныеШтрихкода.ЭтоКодМаркировки = Истина;
		
		Если ЗамерятьВремя Тогда
			
			ВремяСНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачВремя;
			
