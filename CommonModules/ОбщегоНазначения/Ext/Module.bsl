Функция ПолучитьЗаданиеНаДоставку(Штрихкод) Экспорт
	
	ЗаданиеНаДоставкуГУИД = "";
	                                                                           
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СписокЗаданийНаДоставку.Объект КАК Объект,
	|	СписокЗаданийНаДоставку.Номер КАК Номер,
	|	СписокЗаданийНаДоставку.Штрихкод КАК Штрихкод,
	|	СписокЗаданийНаДоставку.ДатаЗагрузки КАК ДатаЗагрузки,
	|	СписокЗаданийНаДоставку.ВодительНаименование КАК ВодительНаименование,
	|	СписокЗаданийНаДоставку.ДатаДокумента КАК ДатаДокумента,
	|	СписокЗаданийНаДоставку.Маршрут КАК Маршрут,
	|	СписокЗаданийНаДоставку.КоличествоПогружено КАК КоличествоПогружено,
	|	СписокЗаданийНаДоставку.КоличествоНеЗагружено КАК КоличествоНеЗагружено,
	|	СписокЗаданийНаДоставку.КоличествоВсего КАК КоличествоВсего
	|ИЗ
	|	РегистрСведений.СписокЗаданийНаДоставку КАК СписокЗаданийНаДоставку
	|ГДЕ
	|	СписокЗаданийНаДоставку.Штрихкод = &Штрихкод";
	
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		ЗаданиеНаДоставкуГУИД = РезультатЗапроса.Объект;
	КонецЕсли; 
	
	Возврат ЗаданиеНаДоставкуГУИД;
	
КонецФункции

