	Запрос.УстановитьПараметр("Владелец", ТоварГУИД);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	РезультатЗапроса.Следующий();
	
	Возврат РезультатЗапроса.ОписаниеТовара;
	
