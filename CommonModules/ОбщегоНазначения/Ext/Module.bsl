	Запрос.УстановитьПараметр("ЗаданиеНаДоставкуГУИД", ШтрихКодЗадания);

	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() Тогда
		ГрузовоеМестоГУИД = РезультатЗапроса.ГрузовоеМестоГУИД;
