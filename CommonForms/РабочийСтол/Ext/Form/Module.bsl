	Если ИмяСобытия = "РабочийСтолОбновление" Тогда  
		
		ЭтаФорма.Сотрудник = ОбщегоНазначения.ПолучитьНаименованиеСотрудника();
		Если Не ЗначениеЗаполнено(ЭтаФорма.Сотрудник) Тогда
			ЭтаФорма.Сотрудник = "Не авторизован";
		КонецЕсли; 
		
		//+Кабанов А.В. 07.04.2023 # UT10-3285
		Элементы.Группа8.Видимость = ОбщегоНазначения.ПолучитьРазрешениеНаПроведениеПТУ();
		//-Кабанов А.В. 07.04.2023 # UT10-3285
		
		//+Кабанов А.В. 12.03.2024 # UT10-4328
		Элементы.Группа9.Видимость = ОбщегоНазначения.ПолучитьРазрешениеОтображанияСлужебныхЗаписок();
		//-Кабанов А.В. 12.03.2024 # UT10-4328 
		
		//+Белов А. 04.03.2025 #UT10-5124
		Элементы.Группа10.Видимость = ОбщегоНазначения.ПолучитьРазрешениеОтображанияТЕ();
		//-Белов А. 04.03.2025 #UT10-5124
		
		//+Кабанов А.В. 21.07.2025 # UT10-5343 
		Элементы.Группа11.Видимость = ОбщегоНазначения.ПолучитьРазрешениеОтображанияМаркировкиТоваров();
		//-Кабанов А.В. 21.07.2025 # UT10-5343 
		
	КонецЕсли; 
	
КонецПроцедуры

