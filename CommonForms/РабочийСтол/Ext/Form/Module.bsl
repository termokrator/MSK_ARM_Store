&НаКлиенте
Процедура ОткрытьФормуПеремещениеТовара()
	
	Если ЗначениеЗаполнено(ОбщегоНазначения.ПолучитьПользователяГУИД()) Тогда
		
		ОбщегоНазначения.ОчиститьПараметрыРаботы();				

		// Необходимо проверить, есть ли не перемещенные товары в буфере.
		РезультатСтруктура = ОбщегоНазначения.ПолучитьСписокТоваровИзБуфераПеремещения("", "");
		
		Если ЗначениеЗаполнено(РезультатСтруктура.Ошибка) Тогда
			ПоказатьПредупреждение(,"Ошибка: " + РезультатСтруктура.Ошибка, 3);	
			Закрыть();	
			Возврат;
		КонецЕсли; 
		
		
		Если ОбщегоНазначения.ПолучитьРежимРаботыПриложения() = "Developing" Тогда
			
			ФормаПриемки = ПолучитьФорму("Обработка.ПеремещениеТовараИзЯчейки.Форма.ФормаПеремещениеНоменклатуры", , ЭтаФорма);	
			ФормаПриемки.Открыть();
			Возврат;
			
		КонецЕсли; 
		
		Колво = ОбщегоНазначения.ПолучитьКоличествоЗаписейВРегистреСведений("СписокТоваровВБуфереПеремещения");		
		Если Колво > 0 Тогда
			
			Оповещение = Новый ОписаниеОповещения("ФормаНеПеремещенныхТоваровВБуфереПослеЗакрытияФормы", ЭтаФорма);
			ОткрытьФорму("Обработка.ПеремещениеТовараИзЯчейки.Форма.ФормаНеПеремещенныхТоваровВБуфере",,,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);			
			
		Иначе			
			
			ФормаПриемки = ПолучитьФорму("Обработка.ПеремещениеТовараИзЯчейки.Форма.ФормаПеремещениеНоменклатуры", , ЭтаФорма);	
			ФормаПриемки.Открыть();
			
		КонецЕсли; 		
		
	Иначе 
		
		ОткрытьФорму("ОбщаяФорма.Авторизация");
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаНеПеремещенныхТоваровВБуфереПослеЗакрытияФормы(Результат, ДополнительныеПараметры) Экспорт
		
	Если Результат <> Неопределено И Результат.ПризнакВозврата = Истина Тогда
		
		 Оповещение = Новый ОписаниеОповещения("ОткрытьФормуПеремещениеТовараИзЯчейки", ЭтаФорма);
		 ПоказатьПредупреждение(Оповещение, Результат.ТекстСообщения, 4);
		
	КонецЕсли;
	
КонецПроцедуры
 
