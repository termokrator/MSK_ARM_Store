	ОткрытьФормуРаботаСТЕ();	
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРаботаСТЕ() Экспорт
	
	Если ЗначениеЗаполнено(ОбщегоНазначения.ПолучитьПользователяГУИД()) Тогда
		
		ОбщегоНазначения.ОчиститьПараметрыРаботы();
		ФормаСлужебныеЗаписки = ПолучитьФорму("Обработка.Объединения.Форма.ФормаОбъединений", , ЭтаФорма);	
		ФормаСлужебныеЗаписки.Открыть();	
		
	Иначе 
		ОткрытьФорму("ОбщаяФорма.Авторизация");		
	КонецЕсли; 
			
КонецПроцедуры

