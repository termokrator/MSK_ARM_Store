&НаКлиенте
Процедура ОткрытьФормуМаркировкаТоваров()
	//+Кабанов А.В. 21.07.2025 # UT10-5343
	Сообщить("Маркировка");
	Если ЗначениеЗаполнено(ОбщегоНазначения.ПолучитьПользователяГУИД()) Тогда
		
		ОбщегоНазначения.ОчиститьПараметрыРаботы();
		ФормаСлужебныеЗаписки = ПолучитьФорму("Обработка.МаркировкаТоваров.Форма.ФормаСпискаДокументов", , ЭтаФорма);	
		ФормаСлужебныеЗаписки.Открыть();	
		
	Иначе 
		ОткрытьФорму("ОбщаяФорма.Авторизация");		
	КонецЕсли; 
	//-Кабанов А.В. 21.07.2025 # UT10-5343
КонецПроцедуры














