&НаСервере
Процедура ПоискТовараПоШтрихкодуНаСервере()
	
	РезультатВебСервиса = "";
	
	Попытка
		
		WSОпределение = Новый WSОпределения(ПолучитьАдресВебСервиса(), , , ,3);
		WSПрокси = Новый WSПрокси(WSОпределение, "Data", "ARMStoreKeeper", "ARMStoreKeeperSoap" );
		//WSПрокси.Пользователь = "webadmin";
		//WSПрокси.Пароль = "web";		
		
		//Ответ = WSПрокси.FindGoodByBarcode(Штрихкод,  "ПоступлениеТоваровУслуг", ГУИДокумента2,  "ПоискШтрихкодов");
		//Ответ = WSПрокси.FindGoodByBarcode(Штрихкод,  "ПоступлениеТоваровУслуг", ГУИДокумента2,  "ПоискПоНормализованномуКоду");		
		Ответ = WSПрокси.FindGoodByBarcode50(Штрихкод,  "ПоискПоКоду", ГУИДокумента2,  "ПоискПоКоду");		
		Если ТипЗнч(Ответ) = Тип("ХранилищеЗначения") Тогда			
			//Данные = ОбщегоНазначения.ХранилищеJSONВСтруктуру(Ответ);
			РезультатВебСервиса = РезультатВебСервиса + Ответ.Получить();			
		КонецЕсли; 		
		
	Исключение
		
		Сообщить("Ошибка подключения к сервису обновления");
		
	КонецПопытки; 
	
	
КонецПроцедуры


